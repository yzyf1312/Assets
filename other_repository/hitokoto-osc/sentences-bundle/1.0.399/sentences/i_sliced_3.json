[{"id": 5707, "uuid": "ea6a73ce-4a83-4ff8-b749-9657b48d5d9b", "hitokoto": "故人西辞黄鹤楼，烟花三月下扬州。", "type": "i", "from": "黄鹤楼送孟浩然之广陵", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333484", "length": 16}, {"id": 5708, "uuid": "255dda12-df94-4bdd-badb-2556d0b9084f", "hitokoto": "往者不可谏，来者犹可追。", "type": "i", "from": "论语·微子篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333485", "length": 12}, {"id": 5709, "uuid": "c75e49e1-8f48-4a40-b2f6-fe9fbeaa74d5", "hitokoto": "相思了无益，悔当初相见。", "type": "i", "from": "忆少年·飞花时节", "from_who": "朱彝尊", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333485", "length": 12}, {"id": 5710, "uuid": "a7756316-39a2-4426-b5fd-88699d9e99f5", "hitokoto": "水光潋滟晴方好，山色空蒙雨亦奇。", "type": "i", "from": "饮湖上初晴后雨二首·其二", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333485", "length": 16}, {"id": 5711, "uuid": "bbc721b8-9027-4814-87cf-92e0c3c73274", "hitokoto": "葡萄美酒夜光杯，欲饮琵琶马上催。", "type": "i", "from": "凉州词二首·其一", "from_who": "王翰", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333486", "length": 16}, {"id": 5712, "uuid": "d188a075-9e0a-4bb9-8303-992335e23d46", "hitokoto": "借问江潮与海水，何似君情与妾心？", "type": "i", "from": "浪淘沙·借问江潮与海水", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333486", "length": 16}, {"id": 5713, "uuid": "df2bfc8e-f72d-47d0-9ac8-07e425e89600", "hitokoto": "明月松间照，清泉石上流。", "type": "i", "from": "山居秋暝", "from_who": "王维", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333486", "length": 12}, {"id": 5714, "uuid": "7da20882-9843-42b8-92e9-cc3915f818cd", "hitokoto": "接天莲叶无穷碧，映日荷花别样红。", "type": "i", "from": "晓出净慈寺送林子方", "from_who": "杨万里", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333487", "length": 16}, {"id": 5715, "uuid": "53e8e521-6449-40c4-aa89-a62933fbfcfd", "hitokoto": "君知妾有夫，赠妾双明珠。", "type": "i", "from": "节妇吟·寄东平李司空师道", "from_who": "张籍", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333487", "length": 12}, {"id": 5716, "uuid": "71396790-6d06-49dd-bc72-2568311cdd7b", "hitokoto": "粗缯大布裹生涯，腹有诗书气自华。", "type": "i", "from": "和董传留别", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333487", "length": 16}, {"id": 5717, "uuid": "106fa96a-49c4-454b-b87e-53a456e6a436", "hitokoto": "墙外行人，墙里佳人笑。", "type": "i", "from": "蝶恋花·春景", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333488", "length": 11}, {"id": 5718, "uuid": "eead8729-2e5b-466a-a223-1ce0fbf2b863", "hitokoto": "水是眼波横，山是眉峰聚。", "type": "i", "from": "卜算子·送鲍浩然之浙东", "from_who": "王观", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333488", "length": 12}, {"id": 5719, "uuid": "1a73ea58-1cc6-475b-8aa3-5de021b69eb8", "hitokoto": "柳庭风静人眠昼，昼眠人静风庭柳。", "type": "i", "from": "菩萨蛮·回文夏闺怨", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333488", "length": 16}, {"id": 5720, "uuid": "9ada4b21-e66f-49ad-9a08-cf7f584e7e2d", "hitokoto": "人生自古谁无死？留取丹心照汗青。", "type": "i", "from": "过零丁洋", "from_who": "文天祥", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333489", "length": 16}, {"id": 5721, "uuid": "9ba2bd2d-9c7d-40b3-9bab-4162039b179c", "hitokoto": "知否，知否？应是绿肥红瘦。", "type": "i", "from": "如梦令·昨夜雨疏风骤", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333489", "length": 13}, {"id": 5722, "uuid": "6b5e599c-a1d7-4010-bca2-d3717923ffd1", "hitokoto": "柴门闻犬吠，风雪夜归人。", "type": "i", "from": "逢雪宿芙蓉山主人", "from_who": "刘长卿", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333489", "length": 12}, {"id": 5723, "uuid": "ff7fa1ad-5bba-4ee9-b86f-443129a88528", "hitokoto": "缺月挂疏桐，漏断人初静。", "type": "i", "from": "卜算子·黄州定慧院寓居作", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333490", "length": 12}, {"id": 5724, "uuid": "57c12842-474d-406a-a424-8523d2737bec", "hitokoto": "忽见陌头杨柳色，悔教夫婿觅封侯。", "type": "i", "from": "闺怨", "from_who": "王昌龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333490", "length": 16}, {"id": 5725, "uuid": "5b4bc83c-aaa4-496b-be3a-bef01d0e43ce", "hitokoto": "窈窕淑女，君子好逑。", "type": "i", "from": "关雎", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333490", "length": 10}, {"id": 5726, "uuid": "0b932ad4-33ae-4c48-b697-43b98624838b", "hitokoto": "商女不知亡国恨，隔江犹唱后庭花。", "type": "i", "from": "泊秦淮", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333491", "length": 16}, {"id": 5727, "uuid": "960f7df3-ae11-413f-9a9a-ce1d47345d1e", "hitokoto": "相逢一醉是前缘，风雨散、飘然何处。", "type": "i", "from": "鹊桥仙·七夕", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333491", "length": 17}, {"id": 5728, "uuid": "fea29eee-11a5-4d5b-8ae4-e0702ad2cbef", "hitokoto": "此生谁料，心在天山，身老沧洲。", "type": "i", "from": "诉衷情·当年万里觅封侯", "from_who": "陆游", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333492", "length": 15}, {"id": 5729, "uuid": "d694cca5-9fda-46b3-881b-521f1ea0afde", "hitokoto": "羌笛何须怨杨柳，春风不度玉门关。", "type": "i", "from": "凉州词二首·其一", "from_who": "王之涣", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333492", "length": 16}, {"id": 5730, "uuid": "98686a97-dfbc-43b4-ad77-c15dffc8873e", "hitokoto": "今夜月明人尽望，不知秋思落谁家。", "type": "i", "from": "十五夜望月寄杜郎中", "from_who": "王建", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333493", "length": 16}, {"id": 5731, "uuid": "93abee05-d843-47cd-893a-47f4b22740bf", "hitokoto": "春潮带雨晚来急，野渡无人舟自横。", "type": "i", "from": "滁州西涧", "from_who": "韦应物", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333493", "length": 16}, {"id": 5732, "uuid": "7683fb4f-fe3d-413d-bf3a-f8b903f0faa8", "hitokoto": "萧萧梧叶送寒声，江上秋风动客情。", "type": "i", "from": "夜书所见", "from_who": "叶绍翁", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333493", "length": 16}, {"id": 5733, "uuid": "c740188b-4b6a-4a78-b0e7-5db72b481280", "hitokoto": "昭昭若日月之明，离离如星辰之行。", "type": "i", "from": "文心雕龙·宗经", "from_who": "刘勰", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333494", "length": 16}, {"id": 5734, "uuid": "f3a42355-25f4-4ba9-a626-efe0ad5a3585", "hitokoto": "相恨不如潮有信，相思始觉海非深。", "type": "i", "from": "浪淘沙·借问江潮与海水", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333494", "length": 16}, {"id": 5735, "uuid": "dabe4a0e-fa27-4476-b026-1bd4dd8f7ee4", "hitokoto": "草长莺飞二月天，拂堤杨柳醉春烟。", "type": "i", "from": "村居", "from_who": "高鼎", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333494", "length": 16}, {"id": 5736, "uuid": "df4b3030-50d8-4005-88ad-4eb034a68cc0", "hitokoto": "两个黄鹂鸣翠柳，一行白鹭上青天。", "type": "i", "from": "绝句", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333495", "length": 16}, {"id": 5737, "uuid": "5f29e587-39e8-4011-8f41-530908f35fc0", "hitokoto": "枕上诗书闲处好，门前风景雨来佳。", "type": "i", "from": "摊破浣溪沙·病起萧萧两鬓华", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333495", "length": 16}, {"id": 5738, "uuid": "4ec1e9df-6baa-4a7d-908c-4e217d0bc15d", "hitokoto": "迟日江山丽，春风花草香。", "type": "i", "from": "绝句二首", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333495", "length": 12}, {"id": 5739, "uuid": "ab97432f-b7e0-4304-a10a-43706b038f25", "hitokoto": "自古逢秋悲寂寥，我言秋日胜春朝。", "type": "i", "from": "秋词", "from_who": "刘禹锡", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333496", "length": 16}, {"id": 5740, "uuid": "954df3c2-64a9-4754-bfad-3df42eb28c11", "hitokoto": "墙角数枝梅，凌寒独自开。", "type": "i", "from": "梅花 / 梅", "from_who": "王安石", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333496", "length": 12}, {"id": 5741, "uuid": "bae451f2-cd6b-4175-82bc-b412951e72e2", "hitokoto": "妆罢低声问夫婿，画眉深浅入时无。", "type": "i", "from": "近试上张籍水部 / 近试上张水部 / 闺意献张水部", "from_who": "朱庆馀", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333496", "length": 16}, {"id": 5742, "uuid": "81621c24-c834-4b00-b7e2-bef7d45ca8d6", "hitokoto": "从前种种，譬如昨日死；从后种种，譬如今日生", "type": "i", "from": "了凡四训·立命之学", "from_who": "袁了凡", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333497", "length": 21}, {"id": 5743, "uuid": "ae5abbb7-0c04-437a-8f41-0cc4b88221cb", "hitokoto": "以人言善我，必以人言罪我。", "type": "i", "from": "韩非子·说林上", "from_who": "韩非", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333497", "length": 13}, {"id": 5744, "uuid": "c3602154-62fa-431e-97a9-5faa0776f385", "hitokoto": "千山鸟飞绝，万径人踪灭。", "type": "i", "from": "江雪", "from_who": "柳宗元", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395373", "length": 12}, {"id": 5745, "uuid": "c93c965c-7de4-4611-b574-a2e1344d5bd5", "hitokoto": "江畔何人初见月？江月何年初照人？", "type": "i", "from": "春江花月夜", "from_who": "张若虚", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395374", "length": 16}, {"id": 5746, "uuid": "0e36fe28-11e1-43e1-8c5b-513c99514601", "hitokoto": "若待上林花似锦，出门俱是看花人。", "type": "i", "from": "城东早春", "from_who": "杨巨源", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395374", "length": 16}, {"id": 5747, "uuid": "42824419-9946-48eb-a892-3c6ee4b5c5c4", "hitokoto": "古人学问无遗力，少壮工夫老始成。", "type": "i", "from": "冬夜读书示子聿", "from_who": "陆游", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395374", "length": 16}, {"id": 5748, "uuid": "1c417955-99a6-405a-b696-f58e8985465d", "hitokoto": "风一更，雪一更，聒碎乡心梦不成，故园无此声。", "type": "i", "from": "长相思·山一程", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395375", "length": 22}, {"id": 5749, "uuid": "cad98c27-400a-4bd4-8a37-2c05a09012b5", "hitokoto": "莫道不销魂，帘卷西风，人比黄花瘦。", "type": "i", "from": "醉花阴·薄雾浓云愁永昼", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395375", "length": 17}, {"id": 5750, "uuid": "cb5f9471-155c-4324-928a-0b4ef9e2b038", "hitokoto": "造物无言却有情，每于寒尽觉春生。", "type": "i", "from": "新雷", "from_who": "张维屏", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395376", "length": 16}, {"id": 5751, "uuid": "f7b0dd64-6cc1-42d2-bb4e-a9636fd45a63", "hitokoto": "风乍起，吹皱一池春水。", "type": "i", "from": "谒金门·风乍起", "from_who": "冯延巳", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395376", "length": 11}, {"id": 5752, "uuid": "be7cb8ce-140a-4c5d-9a6f-f36026d558fb", "hitokoto": "山不在高，有仙则名。水不在深，有龙则灵。", "type": "i", "from": "陋室铭", "from_who": "刘禹锡", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395376", "length": 20}, {"id": 5753, "uuid": "d1f594d6-5d2f-4908-a6e7-c2a97e870a7c", "hitokoto": "身既死兮神以灵，魂魄毅兮为鬼雄。", "type": "i", "from": "国殇", "from_who": "屈原", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395377", "length": 16}, {"id": 5754, "uuid": "76324aa4-2c06-4e7a-8945-2baade932230", "hitokoto": "毕竟西湖六月中，风光不与四时同。", "type": "i", "from": "晓出净慈寺送林子方", "from_who": "杨万里", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395377", "length": 16}, {"id": 5755, "uuid": "2a9a7757-aa6d-436d-a948-29901ae5a180", "hitokoto": "我也不登天子船，我也不上长安眠。", "type": "i", "from": "把酒对月歌", "from_who": "唐寅", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395377", "length": 16}, {"id": 5756, "uuid": "e599af50-29bb-4b48-b2c1-76f94d97ae19", "hitokoto": "大漠沙如雪，燕山月似钩。", "type": "i", "from": "马诗二十三首·其五", "from_who": "李贺", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395378", "length": 12}, {"id": 5757, "uuid": "36b2309e-e00b-4ffc-a32e-a1779d661dc5", "hitokoto": "泉涸，鱼相与处于陆，相呴以湿，相濡以沫，不如相忘于江湖。", "type": "i", "from": "庄子·内篇·大宗师", "from_who": "周子休", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395378", "length": 28}, {"id": 5758, "uuid": "5cdb5464-6a77-49b4-9d07-39fca7eb54bf", "hitokoto": "日色欲尽花含烟，月明欲素愁不眠。", "type": "i", "from": "长相思·其二", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395378", "length": 16}, {"id": 5759, "uuid": "9cc54e14-7fd1-4d84-ad9e-f18fb69300c7", "hitokoto": "三更灯火五更鸡，正是男儿读书时。", "type": "i", "from": "劝学诗", "from_who": "颜真卿", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395379", "length": 16}, {"id": 5760, "uuid": "273f83d9-367f-47c5-abc5-22253745e71b", "hitokoto": "江南几度梅花发，人在天涯鬓已斑。", "type": "i", "from": "鹧鸪天·雪照山城玉指寒", "from_who": "刘著", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395379", "length": 16}, {"id": 5761, "uuid": "e3854f83-cfb2-496f-803e-873981c4e699", "hitokoto": "松树千年终是朽，槿花一日自为荣。", "type": "i", "from": "放言五首·其五", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395379", "length": 16}, {"id": 5762, "uuid": "1c0a0b54-d1fc-4087-b2b7-8e0ea5a33c07", "hitokoto": "桃李不言，下自成蹊。", "type": "i", "from": "史记·李将军列传", "from_who": "司马迁", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395380", "length": 10}, {"id": 5763, "uuid": "44c15ee6-2dd4-4fc4-8a1e-63d6864f3069", "hitokoto": "连雨不知春去，一晴方觉夏深。", "type": "i", "from": "喜晴", "from_who": "范成大", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395380", "length": 14}, {"id": 5764, "uuid": "e6c77da4-4fcd-40c1-8419-6cb46fa294f0", "hitokoto": "易求无价宝，难得有心郎。", "type": "i", "from": "赠邻女 / 寄李亿员外", "from_who": "鱼玄机", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395387", "length": 12}, {"id": 5765, "uuid": "0e2cca51-cb26-46cb-b961-a936de07c6d1", "hitokoto": "有情芍药含春泪，无力蔷薇卧晓枝。", "type": "i", "from": "春日", "from_who": "秦观", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395387", "length": 16}, {"id": 5766, "uuid": "71f89824-3775-4bf6-afb1-203d0bf6305d", "hitokoto": "执手相看泪眼，竟无语凝噎。", "type": "i", "from": "雨霖铃·寒蝉凄切", "from_who": "柳永", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395387", "length": 13}, {"id": 5767, "uuid": "e2565946-c686-4133-8580-9076e34a73b7", "hitokoto": "日暮苍山远，天寒白屋贫。", "type": "i", "from": "逢雪宿芙蓉山主人", "from_who": "刘长卿", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395388", "length": 12}, {"id": 5768, "uuid": "568ae486-469c-4cf2-b7b9-d2fd3cd6e0a0", "hitokoto": "山远天高烟水寒，相思枫叶丹。", "type": "i", "from": "长相思·一重山", "from_who": "李煜", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395388", "length": 14}, {"id": 5769, "uuid": "8b10bb52-d38b-4f1d-8522-52dd8bcb8b3e", "hitokoto": "浮生只合尊前老。雪满长安道。", "type": "i", "from": "虞美人·寄公度", "from_who": "舒亶", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395388", "length": 14}, {"id": 5770, "uuid": "24888d87-0f2a-4811-8c88-d6673ea82671", "hitokoto": "及时当勉励，岁月不待人。", "type": "i", "from": "杂诗·人生无根蒂", "from_who": "陶渊明", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395389", "length": 12}, {"id": 5771, "uuid": "3b052170-8dd0-4cbe-bbe8-be7e4b7727b3", "hitokoto": "慈母手中线，游子身上衣。", "type": "i", "from": "游子吟 / 迎母漂上作", "from_who": "孟郊", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395389", "length": 12}, {"id": 5772, "uuid": "0eb3e577-949a-4d90-8f65-7477b9417862", "hitokoto": "天阶夜色凉如水，卧看牵牛织女星。", "type": "i", "from": "秋夕", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395389", "length": 16}, {"id": 5773, "uuid": "c89d5ae3-efba-46de-9435-b14c61cc6066", "hitokoto": "花褪残红青杏小。燕子飞时，绿水人家绕。", "type": "i", "from": "蝶恋花·春景", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395389", "length": 19}, {"id": 5774, "uuid": "7ae40fb7-2a7d-43e4-9005-9dc1af242e99", "hitokoto": "中秋谁与共孤光。把盏凄然北望。", "type": "i", "from": "西江月·世事一场大梦", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395390", "length": 15}, {"id": 5775, "uuid": "0951d929-14ca-4d6e-a263-25d5df2f49c3", "hitokoto": "孤舟蓑笠翁，独钓寒江雪。", "type": "i", "from": "江雪", "from_who": "柳宗元", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395390", "length": 12}, {"id": 5776, "uuid": "71849835-81c7-45df-b09a-d92be71559e8", "hitokoto": "博观而约取，厚积而薄发", "type": "i", "from": "稼说送张琥", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395390", "length": 11}, {"id": 5777, "uuid": "2284b10d-8718-463c-9dc1-98f3d7b8082d", "hitokoto": "七夕今宵看碧霄，牵牛织女渡河桥。", "type": "i", "from": "乞巧", "from_who": "林杰", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395391", "length": 16}, {"id": 5778, "uuid": "0ece3830-bcd2-4be0-82d4-4a4586fc7cd1", "hitokoto": "宁不知倾城与倾国。佳人难再得。", "type": "i", "from": "李延年歌", "from_who": "李延年", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395391", "length": 15}, {"id": 5779, "uuid": "d9846803-f960-43f9-8471-7a4837f25611", "hitokoto": "多情却被无情恼，今夜还如昨夜长。", "type": "i", "from": "鹧鸪天·候馆灯昏雨送凉", "from_who": "元好问", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395391", "length": 16}, {"id": 5780, "uuid": "a42043a2-03c2-4e1a-8af4-0406c8c118de", "hitokoto": "庭前落尽梧桐，水边开彻芙蓉。", "type": "i", "from": "天净沙·秋", "from_who": "朱庭玉", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395392", "length": 14}, {"id": 5781, "uuid": "560c196e-f668-4431-91eb-0f9058c79915", "hitokoto": "离离原上草，一岁一枯荣。", "type": "i", "from": "草 / 赋得古原草送别", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395392", "length": 12}, {"id": 5782, "uuid": "7a0505d5-5ad7-4c7d-a7d9-53bc5573fe10", "hitokoto": "冰雪林中著此身，不同桃李混芳尘；", "type": "i", "from": "白梅", "from_who": "王冕", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395392", "length": 16}, {"id": 5783, "uuid": "a039cd1c-90a8-40ba-b2c6-432a1e9b63dc", "hitokoto": "秋风起兮白云飞，草木黄落兮雁南归。", "type": "i", "from": "秋风辞", "from_who": "刘彻", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395393", "length": 17}, {"id": 5784, "uuid": "fb25cd75-40a4-4e9e-816a-54cd2e1cbb24", "hitokoto": "宁为百夫长，胜作一书生。", "type": "i", "from": "从军行", "from_who": "杨炯", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395481", "length": 12}, {"id": 5785, "uuid": "2eb4511c-017b-491f-81e5-b3a653781cf9", "hitokoto": "无言独上西楼，月如钩。寂寞梧桐深院锁清秋。", "type": "i", "from": "相见欢·无言独上西楼", "from_who": "李煜", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395481", "length": 21}, {"id": 5786, "uuid": "e24523d3-14bd-454a-ba05-f352e17b04a8", "hitokoto": "西塞山前白鹭飞，桃花流水鳜鱼肥。", "type": "i", "from": "渔歌子·西塞山前白鹭飞", "from_who": "张志和", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395481", "length": 16}, {"id": 5787, "uuid": "b0d30706-9bb9-4841-913e-36ef87b251b7", "hitokoto": "好雨知时节，当春乃发生。", "type": "i", "from": "春夜喜雨", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395482", "length": 12}, {"id": 5788, "uuid": "1034b495-b7fc-4561-a97b-f7d6b81e4ee0", "hitokoto": "青山绿水，白草红叶黄花。", "type": "i", "from": "天净沙·秋", "from_who": "白朴", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395482", "length": 12}, {"id": 5789, "uuid": "94413206-c662-4e1b-a18c-f903b622e131", "hitokoto": "情人怨遥夜，竟夕起相思。", "type": "i", "from": "望月怀远", "from_who": "张九龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395482", "length": 12}, {"id": 5790, "uuid": "82ea61f5-2698-4e2a-9da5-b4b8a6e5b1e9", "hitokoto": "祸不妄至，福不徒来。", "type": "i", "from": "史记·龟策列传", "from_who": "司马迁", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395483", "length": 10}, {"id": 5791, "uuid": "f0eaf8f2-b1dc-4a32-9219-ed9aeddd0d5b", "hitokoto": "稻花香里说丰年。听取蛙声一片。", "type": "i", "from": "西江月·夜行黄沙道中", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395483", "length": 15}, {"id": 5792, "uuid": "4f1d847b-cef1-4d08-bd68-f76ef985c070", "hitokoto": "平生不下泪，于此泣无穷。", "type": "i", "from": "江夏别宋之悌", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395483", "length": 12}, {"id": 5793, "uuid": "6f3db277-ad71-49e5-9ab6-317e35bb3f22", "hitokoto": "伯牙鼓琴，志在高山。", "type": "i", "from": "伯牙绝弦", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395484", "length": 10}, {"id": 5794, "uuid": "cc2d5006-10ff-4c30-a71f-82558c2a14fc", "hitokoto": "青鸟不传云外信，丁香空结雨中愁。", "type": "i", "from": "摊破浣溪沙·手卷真珠上玉钩", "from_who": "李璟", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395484", "length": 16}, {"id": 5795, "uuid": "dc4bbf94-7bf8-471d-a699-881641124eaf", "hitokoto": "江山代有才人出，各领风骚数百年。", "type": "i", "from": "论诗五首·其二", "from_who": "赵翼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395484", "length": 16}, {"id": 5796, "uuid": "1667271c-3eec-43f0-bc72-38d68a2d6c6e", "hitokoto": "新竹高于旧竹枝，全凭老干为扶持。", "type": "i", "from": "新竹", "from_who": "郑燮", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395485", "length": 16}, {"id": 5797, "uuid": "d12e1642-746a-4381-88ab-0758ce7288b2", "hitokoto": "野旷天低树，江清月近人。", "type": "i", "from": "宿建德江", "from_who": "孟浩然", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395485", "length": 12}, {"id": 5798, "uuid": "5c0de7d0-f871-469f-b1c6-eec3aaa51113", "hitokoto": "鸟宿池边树，僧敲月下门。", "type": "i", "from": "题李凝幽居", "from_who": "贾岛", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395485", "length": 12}, {"id": 5799, "uuid": "74703fe8-98a9-4e4d-8959-d1b60b882535", "hitokoto": "我居北海君南海，寄雁传书谢不能。", "type": "i", "from": "寄黄几复", "from_who": "黄庭坚", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395486", "length": 16}, {"id": 5800, "uuid": "84579b2b-1bfc-4a29-926a-822789e865e5", "hitokoto": "不茶不饭，不言不语，一味供他憔悴。", "type": "i", "from": "鹊桥仙·说盟说誓", "from_who": "蜀妓", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395486", "length": 17}, {"id": 5801, "uuid": "9faaf92c-ed63-4426-9774-dbc5c0bc0801", "hitokoto": "乱花渐欲迷人眼，浅草才能没马蹄。", "type": "i", "from": "钱塘湖春行", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395486", "length": 16}, {"id": 5802, "uuid": "c6a3db3f-0fa0-4af4-b954-65d0e1f73f0a", "hitokoto": "昆山玉碎凤凰叫，芙蓉泣露香兰笑。", "type": "i", "from": "李凭箜篌引", "from_who": "李贺", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395487", "length": 16}, {"id": 5803, "uuid": "db22331d-01bf-4988-90b1-bd9201ccdc11", "hitokoto": "相思相望不相亲，天为谁春。", "type": "i", "from": "画堂春·一生一代一双人", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395487", "length": 13}, {"id": 5804, "uuid": "e0c5a1a9-ac5a-446c-8e62-51f175be54a7", "hitokoto": "舞低杨柳楼心月，歌尽桃花扇底风。", "type": "i", "from": "鹧鸪天·彩袖殷勤捧玉钟", "from_who": "晏几道", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395487", "length": 16}, {"id": 5805, "uuid": "0c744811-3a9b-4ca0-97d2-5cb9b0f56e6f", "hitokoto": "君子不器。", "type": "i", "from": "论语·为政篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395488", "length": 5}, {"id": 5806, "uuid": "175a62e0-008a-4685-b956-9260244ee0cb", "hitokoto": "孤灯不明思欲绝，卷帷望月空长叹。", "type": "i", "from": "长相思·其一", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395488", "length": 16}]