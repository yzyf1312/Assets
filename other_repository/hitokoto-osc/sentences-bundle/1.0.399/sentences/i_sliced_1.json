[{"id": 5507, "uuid": "a0fd938e-d2a6-49be-88c4-474345f3afd8", "verse": "问君能有几多愁？恰似一江春水向东流。", "from": "虞美人·春花秋月何时了", "length": 18}, {"id": 5508, "uuid": "4db50f04-4e55-434f-82ea-c843e0d779d5", "verse": "怕相思，已相思，轮到相思没处辞，眉间露一丝。", "from": "长相思·折花枝", "length": 22}, {"id": 5509, "uuid": "78c500e3-40ae-4d89-93ab-c1f8c8deb88e", "verse": "空山新雨后，天气晚来秋。", "from": "山居秋暝", "length": 12}, {"id": 5510, "uuid": "618fe6a9-58eb-46a2-82c0-de3e0490f4fc", "verse": "宠辱不惊，闲看庭前花开花落；去留无意，漫随天外云卷云舒。", "from": "菜根谭·概论", "length": 28}, {"id": 5511, "uuid": "31dec965-20b0-492b-820d-b05ec0e40524", "verse": "天涯地角有穷时，只有相思无尽处。", "from": "玉楼春·春恨", "length": 16}, {"id": 5512, "uuid": "16ff3889-cb86-48fd-b380-5763e0ffb163", "verse": "直道相思了无益，未妨惆怅是清狂。", "from": "无题·重帏深下莫愁堂", "length": 16}, {"id": 5513, "uuid": "68cbacef-7f02-4902-9f15-651136d66cc0", "verse": "一骑红尘妃子笑，无人知是荔枝来。", "from": "过华清宫绝句三首", "length": 16}, {"id": 5514, "uuid": "e0e41cd5-48dd-4257-86ac-707d26e02382", "verse": "小楼一夜听春雨，深巷明朝卖杏花。", "from": "临安春雨初霁", "length": 16}, {"id": 5515, "uuid": "8e3baeeb-2be0-450e-a6a2-19dc000c0b4e", "verse": "月上柳梢头，人约黄昏后。", "from": "生查子·元夕", "length": 12}, {"id": 5516, "uuid": "a9e4b72c-1dda-4872-bca2-5bc74f0721d2", "verse": "人言落日是天涯，望极天涯不见家。", "from": "乡思", "length": 16}, {"id": 5517, "uuid": "42c30666-7a66-4856-8412-1a84d5b15cb1", "verse": "男儿何不带吴钩，收取关山五十州。", "from": "南园十三首·其五", "length": 16}, {"id": 5518, "uuid": "a50af3cc-25c6-4fa4-ad6d-32ae0879a6e7", "verse": "桃之夭夭，灼灼其华。", "from": "诗经·周南·桃夭", "length": 10}, {"id": 5519, "uuid": "2f5d5af3-e9d2-4321-8a09-0d8731d906d0", "verse": "待到秋来九月八，我花开后百花杀。", "from": "不第后赋菊", "length": 16}, {"id": 5520, "uuid": "dc5fb92e-b9c2-41fe-b883-76b1dff82597", "verse": "二十四桥明月夜，玉人何处教吹箫？", "from": "寄扬州韩绰判官", "length": 16}, {"id": 5521, "uuid": "c2de0788-07ef-4baf-964d-ab79c9b6bb7a", "verse": "毋意，毋必，毋固，毋我。", "from": "论语·子罕篇", "length": 12}, {"id": 5522, "uuid": "6eadc8d2-1a18-446f-b22c-9fa9968f404f", "verse": "枯藤老树昏鸦，小桥流水人家，古道西风瘦马。", "from": "天净沙·秋思", "length": 21}, {"id": 5523, "uuid": "49f330fb-9b46-4ae3-8890-cea52f0a7b25", "verse": "寂寞空庭春欲晚，梨花满地不开门。", "from": "春怨", "length": 16}, {"id": 5524, "uuid": "a783ef3f-dd77-4b62-b6be-5e071df00f62", "verse": "被酒莫惊春睡重，赌书消得泼茶香，当时只道是寻常。", "from": "浣溪沙·谁念西风独自凉", "length": 24}, {"id": 5525, "uuid": "0fc10e92-930b-440b-96f1-a3c39121eea2", "verse": "不经一番寒彻骨，怎得梅花扑鼻香。", "from": "上堂开示颂", "length": 16}, {"id": 5526, "uuid": "41891de3-5794-4139-832a-3cdf28e67b09", "verse": "青山依旧在，几度夕阳红。", "from": "临江仙·滚滚长江东逝水", "length": 12}, {"id": 5527, "uuid": "43c536af-74e1-43e7-8b10-4db844fae3b4", "verse": "海上生明月，天涯共此时。", "from": "望月怀远", "length": 12}, {"id": 5528, "uuid": "d70c9216-3c2b-4a3d-a28b-f3d056bdd233", "verse": "当年不肯嫁春风，无端却被秋风误。", "from": "芳心苦·杨柳回塘", "length": 16}, {"id": 5529, "uuid": "183dca23-6c4d-45fe-85ca-15f1f1329dc2", "verse": "纸上得来终觉浅，绝知此事要躬行。", "from": "冬夜读书示子聿", "length": 16}, {"id": 5530, "uuid": "f12c12c2-279f-418a-bf74-3fbd202b754c", "verse": "东风夜放花千树。更吹落、星如雨。", "from": "青玉案·元夕", "length": 16}, {"id": 5531, "uuid": "c3804486-759d-467f-a0d4-bf679e0694c8", "verse": "时人不识凌云木，直待凌云始道高。", "from": "小松", "length": 16}, {"id": 5532, "uuid": "304e0586-20b0-4f3c-8105-0928a6950456", "verse": "人间四月芳菲尽，山寺桃花始盛开。", "from": "大林寺桃花", "length": 16}, {"id": 5533, "uuid": "8968ab01-596f-4634-a5db-b6281f0ee2af", "verse": "泪眼问花花不语，乱红飞过秋千去。", "from": "蝶恋花·庭院深深深几许", "length": 16}, {"id": 5534, "uuid": "8a6b92b5-968a-4a81-bb59-b030b4d84f15", "verse": "试问岭南应不好，却道：此心安处是吾乡。", "from": "少年游·南海归赠王定国侍人寓娘", "length": 19}, {"id": 5535, "uuid": "c7e9677c-b108-482f-9e1b-a92a81ca1473", "verse": "世事漫随流水，算来一梦浮生。", "from": "乌夜啼·昨夜风兼雨", "length": 14}, {"id": 5536, "uuid": "81d9e86f-a313-41e1-9b0d-f504bcebdfb0", "verse": "江碧鸟逾白，山青花欲燃。", "from": "绝句二首", "length": 12}, {"id": 5537, "uuid": "5e4aa55f-57c5-40b4-96ef-0f48516c8c73", "verse": "换我心，为你心，始知相忆深。", "from": "诉衷情·永夜抛人何处去", "length": 14}, {"id": 5538, "uuid": "18bcfb55-e36c-4dfa-a42a-175a1c2ecc19", "verse": "同是天涯沦落人，相逢何必曾相识！", "from": "琵琶行 / 琵琶引", "length": 16}, {"id": 5539, "uuid": "f98d0260-4c8e-4a15-9cbd-4a6888a67aa4", "verse": "醉卧沙场君莫笑，古来征战几人回？", "from": "凉州词二首·其一", "length": 16}, {"id": 5540, "uuid": "519593c5-f62a-4027-b140-e2165c0ab5bd", "verse": "苟利国家生死以，岂因祸福避趋之！", "from": "赴戍登程口占示家人·其二", "length": 16}, {"id": 5541, "uuid": "0d4ccd01-a095-4d7c-9615-acda3502351e", "verse": "十年磨一剑，霜刃未曾试。", "from": "剑客 / 述剑", "length": 12}, {"id": 5542, "uuid": "348f4baa-9347-4325-8bf4-b3d107904c67", "verse": "落霞与孤鹜齐飞，秋水共长天一色。", "from": "滕王阁序", "length": 16}, {"id": 5543, "uuid": "4e7f5ff6-bc02-4b69-af89-b00884c5bf67", "verse": "生当复来归，死当长相思。", "from": "留别妻", "length": 12}, {"id": 5544, "uuid": "74928e43-b0f5-4783-932d-528a46d0ed9a", "verse": "莫愁前路无知己，天下谁人不识君。", "from": "别董大二首", "length": 16}, {"id": 5545, "uuid": "5d9def79-c283-4c4c-a9cb-f44ac8da26da", "verse": "采得百花成蜜后，为谁辛苦为谁甜。", "from": "蜂", "length": 16}, {"id": 5546, "uuid": "2a768424-a076-47dc-b852-a8e024e305cd", "verse": "闻君有两意，故来相决绝。", "from": "白头吟", "length": 12}, {"id": 5547, "uuid": "0c329aae-e0c8-4ac7-a2ff-08dedac04f12", "verse": "日日思君不见君，共饮长江水。", "from": "卜算子·我住长江头", "length": 14}, {"id": 5548, "uuid": "365fd952-64d8-4653-98fe-a1f52404dff4", "verse": "独自莫凭栏，无限江山，别时容易见时难。", "from": "浪淘沙令·帘外雨潺潺", "length": 19}, {"id": 5549, "uuid": "ae2ba359-12aa-4dd6-a6fc-d1f770450269", "verse": "读书不觉已春深，一寸光阴一寸金。", "from": "白鹿洞二首·其一", "length": 16}, {"id": 5550, "uuid": "d3a4ca24-1846-4301-a068-a46e33db5956", "verse": "梅须逊雪三分白，雪却输梅一段香。", "from": "雪梅·其一", "length": 16}, {"id": 5551, "uuid": "2d0df74d-e9df-4000-b0d6-3a58baabf9de", "verse": "多情自古伤离别，更那堪冷落清秋节！", "from": "雨霖铃·寒蝉凄切", "length": 17}, {"id": 5552, "uuid": "d055eba0-8375-4771-b617-5e669b2b7fb0", "verse": "心似双丝网，中有千千结。", "from": "千秋岁·数声鶗鴂", "length": 12}, {"id": 5553, "uuid": "2cb88c31-d01f-4735-a2cf-f7f076f0e40d", "verse": "风萧萧兮易水寒，壮士一去兮不复还。", "from": "荆轲歌 / 渡易水歌", "length": 17}, {"id": 5554, "uuid": "dbb61cbd-1b92-427f-97d5-7788698efb01", "verse": "露从今夜白，月是故乡明。", "from": "月夜忆舍弟", "length": 12}, {"id": 5555, "uuid": "e96c98c7-02d8-406e-b964-7dce2d3f3af8", "verse": "无可奈何花落去，似曾相识燕归来。", "from": "浣溪沙·一曲新词酒一杯", "length": 16}, {"id": 5556, "uuid": "2aa15d79-e10f-4a59-b8bc-3716f2c22fcc", "verse": "相思相见知何日？此时此夜难为情！", "from": "三五七言 / 秋风词", "length": 16}, {"id": 5557, "uuid": "ff7c7b7e-4089-4bff-a7b8-cbe00db6311f", "verse": "独立寒秋，湘江北去，橘子洲头。", "from": "沁园春·长沙", "length": 15}, {"id": 5558, "uuid": "5b12ff5f-198c-41cf-b700-615b98ae81ac", "verse": "众里寻他千百度。蓦然回首，那人却在，灯火阑珊处。", "from": "青玉案·元夕", "length": 24}, {"id": 5559, "uuid": "a6c591ae-1299-4f05-987f-3c423b4f21cb", "verse": "美人自刎乌江岸，战火曾烧赤壁山，将军空老玉门关。", "from": "卖花声·怀古", "length": 24}, {"id": 5560, "uuid": "323c26e4-3f46-4c26-9db8-301e24953374", "verse": "夜来幽梦忽还乡。小轩窗。正梳妆。相顾无言，惟有泪千行。", "from": "江城子·乙卯正月二十日夜记梦", "length": 27}, {"id": 5561, "uuid": "cdb6ff4a-cc4a-4de3-a933-d27e5b2ed930", "verse": "晚来天欲雪，能饮一杯无。", "from": "问刘十九", "length": 12}, {"id": 5562, "uuid": "231fb364-666f-4443-81f2-7f44d65b98cb", "verse": "把酒祝东风。且共从容。", "from": "浪淘沙·把酒祝东风", "length": 11}, {"id": 5563, "uuid": "3fc3defd-0aca-4244-aad9-d3a4a5d4f3bc", "verse": "春蚕到死丝方尽，蜡炬成灰泪始干。", "from": "无题·相见时难别亦难", "length": 16}, {"id": 5564, "uuid": "5b57f71a-8b3b-42ac-a8a7-5be6964219b0", "verse": "欲买桂花同载酒，终不似、少年游。", "from": "唐多令·芦叶满汀洲", "length": 16}, {"id": 5565, "uuid": "dfda37fe-478f-4d36-99c4-634650641f9b", "verse": "最是人间留不住，朱颜辞镜花辞树。", "from": "蝶恋花·阅尽天涯离别苦", "length": 16}, {"id": 5566, "uuid": "ffa3a30d-e0c9-41b3-8479-494cfbb9237a", "verse": "锦瑟无端五十弦，一弦一柱思华年。", "from": "锦瑟", "length": 16}, {"id": 5567, "uuid": "43124c7e-ad63-46b1-b362-0616a57b64aa", "verse": "物是人非事事休，欲语泪先流。", "from": "武陵春·春晚", "length": 14}, {"id": 5568, "uuid": "fbfdcaf9-2859-444a-ba86-9ea9f9c07b25", "verse": "月有盈亏花有开谢，想人生最苦离别。", "from": "普天乐·咏世", "length": 17}, {"id": 5569, "uuid": "9bf5bfb3-1344-46d4-9eed-ed1103118e23", "verse": "沉舟侧畔千帆过，病树前头万木春。", "from": "酬乐天扬州初逢席上见赠", "length": 16}, {"id": 5570, "uuid": "302ae147-73e9-4d52-a3c8-8c7d19409cec", "verse": "盈盈一水间，脉脉不得语。", "from": "迢迢牵牛星", "length": 12}, {"id": 5571, "uuid": "73e31c16-e19a-4331-b5f4-53922549686b", "verse": "射人先射马，擒贼先擒王。", "from": "前出塞九首·其六", "length": 12}, {"id": 5572, "uuid": "0132e873-f765-43df-b9e9-8865c032c8ba", "verse": "我见青山多妩媚，料青山见我应如是。", "from": "贺新郎·甚矣吾衰矣", "length": 17}, {"id": 5573, "uuid": "190a2d4d-8239-427a-a0b2-e935c49ebf2c", "verse": "竹外桃花三两枝，春江水暖鸭先知。", "from": "惠崇春江晚景 / 惠崇春江晓景", "length": 16}, {"id": 5574, "uuid": "d1972224-fbc7-4b25-8569-fa9f9132f9e2", "verse": "山外青山楼外楼，西湖歌舞几时休？", "from": "题临安邸", "length": 16}, {"id": 5575, "uuid": "06ce7b01-36e4-49fe-a9f0-b8454562d3b6", "verse": "伤心桥下春波绿，曾是惊鸿照影来。", "from": "沈园二首", "length": 16}, {"id": 5576, "uuid": "b934b129-67ae-41d9-b81f-fc30b90d76b6", "verse": "大江东去，浪淘尽，千古风流人物。", "from": "念奴娇·赤壁怀古", "length": 16}, {"id": 5577, "uuid": "4349ead0-124c-4bfe-846a-90dd44264ca2", "verse": "君子有九思：视思明，听思聪，色思温，貌思恭，言思忠，事思敬，疑思问，忿思难，见得思义。", "from": "论语·季氏篇", "length": 43}, {"id": 5578, "uuid": "77a33f55-1b63-419c-a3b2-ec01dc7746cd", "verse": "落红不是无情物，化作春泥更护花。", "from": "己亥杂诗·其五", "length": 16}, {"id": 5579, "uuid": "ba330b0e-da3d-41f4-b8ca-24eece4ad324", "verse": "酒入愁肠，化作相思泪。", "from": "苏幕遮·怀旧", "length": 11}, {"id": 5580, "uuid": "3cb84ce8-2491-4087-b809-b119ce2102d9", "verse": "呜呼！楚虽三户能亡秦，岂有堂堂中国空无人！", "from": "金错刀行", "length": 21}, {"id": 5581, "uuid": "b0292765-7749-456f-9aad-7a8f0b8a9a14", "verse": "夕阳无限好，只是近黄昏。", "from": "乐游原 / 登乐游原", "length": 12}, {"id": 5582, "uuid": "e242a634-56f3-4ed3-9e70-9c3ef1888e09", "verse": "酒逢知己千杯少，话不投机半句多。", "from": "明贤集·七言集", "length": 16}, {"id": 5583, "uuid": "690bf909-e2f4-4029-9e79-4661a8026917", "verse": "衣带渐宽终不悔，为伊消得人憔悴。", "from": "蝶恋花·伫倚危楼风细细", "length": 16}, {"id": 5584, "uuid": "564d9b56-dc78-42e6-8a05-8b5a0e733803", "verse": "世人结交须黄金，黄金不多交不深。", "from": "题长安壁主人", "length": 16}, {"id": 5585, "uuid": "488f52cd-a6c8-4e79-97cb-cc6ce207892d", "verse": "渺万里层云，千山暮雪，只影向谁去？", "from": "摸鱼儿·雁丘词 / 迈陂塘", "length": 17}, {"id": 5586, "uuid": "71ebf0e8-9bf4-4fe5-afd9-5b0b0faeb927", "verse": "遇酒且呵呵，人生能几何！", "from": "菩萨蛮·劝君今夜须沈醉", "length": 12}, {"id": 5587, "uuid": "c9d7ffc5-fd38-4bb7-8e34-2102ddd98a24", "verse": "天长地久有时尽，此恨绵绵无绝期。", "from": "长恨歌", "length": 16}, {"id": 5588, "uuid": "13e53cb2-58af-4522-8d59-1de37e530df3", "verse": "世事短如春梦，人情薄似秋云。", "from": "西江月·世事短如春梦", "length": 14}, {"id": 5589, "uuid": "46f758f8-a1f1-4086-8742-598e9eb8d1ba", "verse": "长风破浪会有时，直挂云帆济沧海。", "from": "行路难·其一", "length": 16}, {"id": 5590, "uuid": "3f7ffa61-e42f-4bdb-949d-830680c19eae", "verse": "人闲桂花落，夜静春山空。", "from": "鸟鸣涧", "length": 12}, {"id": 5591, "uuid": "23d45b52-7709-4fb2-9ba8-2fe027cf6399", "verse": "渐行渐远渐无书，水阔鱼沉何处问。", "from": "玉楼春·别后不知君远近", "length": 16}, {"id": 5592, "uuid": "3071e935-9d13-47e3-8996-771f6d34c6ce", "verse": "花间一壶酒，独酌无相亲。", "from": "月下独酌四首·其一", "length": 12}, {"id": 5593, "uuid": "f650b952-48d7-46f2-905c-799fecd1b1fa", "verse": "春风十里扬州路，卷上珠帘总不如。", "from": "赠别", "length": 16}, {"id": 5594, "uuid": "e8f4ee1c-e21a-4996-8c6d-b35621604ef9", "verse": "系我一生心，负你千行泪。", "from": "忆帝京·薄衾小枕凉天气", "length": 12}, {"id": 5595, "uuid": "02b68b6d-d8cc-4f13-a711-910957b61c71", "verse": "他年我若为青帝，报与桃花一处开。", "from": "题菊花", "length": 16}, {"id": 5596, "uuid": "a5a74dc7-05f1-4109-9e92-2d2957968b75", "verse": "白日放歌须纵酒，青春作伴好还乡。", "from": "闻官军收河南河北", "length": 16}, {"id": 5597, "uuid": "d338aae0-f7f1-4196-bf28-c79511f7565c", "verse": "花无人戴，酒无人劝，醉也无人管。", "from": "青玉案·年年社日停针线", "length": 16}, {"id": 5598, "uuid": "b6676611-75ed-4df9-97a7-7dd717d83d9d", "verse": "韶华不为少年留。恨悠悠。几时休。", "from": "江城子·西城杨柳弄春柔", "length": 16}, {"id": 5599, "uuid": "3ed1e7a0-f0e6-4223-ad65-3666bc256855", "verse": "江南无所有，聊赠一枝春。", "from": "赠范晔诗", "length": 12}, {"id": 5600, "uuid": "e8ccd960-98f6-45f5-bd2d-073414baf071", "verse": "海水梦悠悠，君愁我亦愁。", "from": "西洲曲", "length": 12}, {"id": 5601, "uuid": "f42fe92f-7d10-4afd-ba5e-17354873d4ca", "verse": "美人卷珠帘，深坐颦蛾眉。", "from": "怨情", "length": 12}, {"id": 5602, "uuid": "977266aa-edc7-4c37-8467-9395c15aac2e", "verse": "金风玉露一相逢，便胜却人间无数。", "from": "鹊桥仙·纤云弄巧", "length": 16}, {"id": 5603, "uuid": "d39dad64-8d1d-4bdb-be7d-e213e1e4214e", "verse": "衰兰送客咸阳道，天若有情天亦老。", "from": "行路难·缚虎手", "length": 16}, {"id": 5604, "uuid": "694cb000-8f27-4472-9ff2-a2657e037cf1", "verse": "江南可采莲，莲叶何田田。", "from": "江南", "length": 12}, {"id": 5605, "uuid": "9671bb43-f26d-441d-b04a-665852ef2e99", "verse": "山一程，水一程，身向榆关那畔行，夜深千帐灯。", "from": "长相思·山一程", "length": 22}, {"id": 5606, "uuid": "54c2def3-89a2-4c23-9bd9-79349af563b4", "verse": "夜阑卧听风吹雨，铁马冰河入梦来。", "from": "十一月四日风雨大作", "length": 16}]