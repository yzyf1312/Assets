[{"id": 5607, "uuid": "1f5bd366-3070-4ea5-94b3-ad327b8116a6", "hitokoto": "天下熙熙，皆为利来；天下攘攘，皆为利往。", "type": "i", "from": "史记·货殖列传", "from_who": "司马迁", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266484", "length": 20}, {"id": 5608, "uuid": "c16541df-53ab-4a46-8896-feb1833af0f0", "hitokoto": "相见时难别亦难，东风无力百花残。", "type": "i", "from": "无题·相见时难别亦难", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266484", "length": 16}, {"id": 5609, "uuid": "bb3cf064-bfc3-42c7-a566-6da15be2fca1", "hitokoto": "少年易老学难成，一寸光阴不可轻。", "type": "i", "from": "劝学诗 / 偶成", "from_who": "朱熹", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266485", "length": 16}, {"id": 5610, "uuid": "d647239d-f512-4146-87d0-74e216e640d9", "hitokoto": "相思只在：丁香枝上，豆蔻梢头。", "type": "i", "from": "眼儿媚·杨柳丝丝弄轻柔", "from_who": "王雱", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266485", "length": 15}, {"id": 5611, "uuid": "b4bf6155-60c5-41d1-8ee8-2c642d02d716", "hitokoto": "万事到头都是梦，休休。明日黄花蝶也愁。", "type": "i", "from": "南乡子·重九涵辉楼呈徐君猷", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266485", "length": 19}, {"id": 5612, "uuid": "9b370715-7c0d-48b3-ac7d-de37076ee562", "hitokoto": "流水落花春去也，天上人间。", "type": "i", "from": "浪淘沙令·帘外雨潺潺", "from_who": "李煜", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266486", "length": 13}, {"id": 5613, "uuid": "fecc2820-2329-4cc0-aa4e-5c7a29b52a37", "hitokoto": "兰有秀兮菊有芳，怀佳人兮不能忘。", "type": "i", "from": "秋风辞", "from_who": "刘彻", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266486", "length": 16}, {"id": 5614, "uuid": "323a29a1-28a1-4ee5-9aa1-a53e0f418247", "hitokoto": "若教眼底无离恨，不信人间有白头。", "type": "i", "from": "鹧鸪天·晚日寒鸦一片愁", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266486", "length": 16}, {"id": 5615, "uuid": "04c3ada3-7824-45aa-844e-6c7846915151", "hitokoto": "旧时王谢堂前燕，飞入寻常百姓家。", "type": "i", "from": "乌衣巷", "from_who": "刘禹锡", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266487", "length": 16}, {"id": 5616, "uuid": "89b38b7f-5d20-4276-9b3b-f58c521ece18", "hitokoto": "思君如满月，夜夜减清辉。", "type": "i", "from": "赋得自君之出矣", "from_who": "张九龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266487", "length": 12}, {"id": 5617, "uuid": "788568ed-bc3f-43ed-9f22-e8499f9e8f12", "hitokoto": "力拔山兮气盖世。时不利兮骓不逝。", "type": "i", "from": "垓下歌", "from_who": "项羽", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266488", "length": 16}, {"id": 5618, "uuid": "24a17d59-cdc1-453a-8a9f-debde3428221", "hitokoto": "昨夜星辰昨夜风，画楼西畔桂堂东。", "type": "i", "from": "无题·昨夜星辰昨夜风", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266488", "length": 16}, {"id": 5619, "uuid": "fb8be48f-0c9a-44d5-ad94-69ce22974849", "hitokoto": "秦时明月汉时关，万里长征人未还。", "type": "i", "from": "出塞二首·其一", "from_who": "王昌龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266488", "length": 16}, {"id": 5620, "uuid": "e06b12b2-f76b-4500-90ba-a97efbc8071b", "hitokoto": "欲把相思说似谁，浅情人不知。", "type": "i", "from": "长相思·长相思", "from_who": "晏几道", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266489", "length": 14}, {"id": 5621, "uuid": "48c20247-5dce-4ad5-981e-47a80058ae2d", "hitokoto": "无边落木萧萧下，不尽长江滚滚来。", "type": "i", "from": "登高", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266489", "length": 16}, {"id": 5622, "uuid": "58018b10-603b-4b85-a007-4fdfa4e22529", "hitokoto": "人间有味是清欢。", "type": "i", "from": "浣溪沙·细雨斜风作晓寒", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266489", "length": 8}, {"id": 5623, "uuid": "faa56a2d-76fd-4b6b-b08e-1cb8d3e75318", "hitokoto": "人生天地之间，若白驹之过隙，忽然而已。", "type": "i", "from": "庄子·外篇·知北游", "from_who": "庄子休", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266490", "length": 19}, {"id": 5624, "uuid": "4cae5e2c-9dd8-4614-810b-4b9a7aae7ae8", "hitokoto": "少年听雨歌楼上。红烛昏罗帐。", "type": "i", "from": "虞美人·听雨", "from_who": "蒋捷", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266490", "length": 14}, {"id": 5625, "uuid": "ccfb877b-e44a-48fa-b5dc-dcc05d9073d1", "hitokoto": "人到情多情转薄，而今真个不多情。", "type": "i", "from": "山花子·风絮飘残已化萍", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266491", "length": 16}, {"id": 5626, "uuid": "8fed9321-dfcd-4ddb-a2bf-00c962fc7374", "hitokoto": "枝上柳绵吹又少。天涯何处无芳草。", "type": "i", "from": "蝶恋花·春景", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266491", "length": 16}, {"id": 5627, "uuid": "659a98fa-5dd4-4c9c-840a-0acb285f62ec", "hitokoto": "天街小雨润如酥，草色遥看近却无。", "type": "i", "from": "早春呈水部张十八员外 / 初春小雨 / 早春", "from_who": "韩愈", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266492", "length": 16}, {"id": 5628, "uuid": "8fd23bd8-0b84-4474-a2b6-937123b60b29", "hitokoto": "结发为夫妻，恩爱两不疑。", "type": "i", "from": "留别妻", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266493", "length": 12}, {"id": 5629, "uuid": "838d7395-543b-46f9-9840-3710a5cf0ef8", "hitokoto": "春江潮水连海平，海上明月共潮生。", "type": "i", "from": "春江花月夜", "from_who": "张若虚", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266493", "length": 16}, {"id": 5630, "uuid": "00dfc983-b8ce-4f92-a48b-cbe118260cda", "hitokoto": "莫唱当年长恨歌，人间亦自有银河。", "type": "i", "from": "马嵬", "from_who": "袁枚", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266494", "length": 16}, {"id": 5631, "uuid": "20c7b0b0-33ea-4e90-9a19-14eabbe774a3", "hitokoto": "愿得此身长报国，何须生入玉门关。", "type": "i", "from": "塞上曲二首·其二", "from_who": "戴叔伦", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266494", "length": 16}, {"id": 5632, "uuid": "0dbd8aa4-8527-40d1-8ff0-163d021577bd", "hitokoto": "云中谁寄锦书来，雁字回时，月满西楼。", "type": "i", "from": "一剪梅·红藕香残玉簟秋", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266495", "length": 18}, {"id": 5633, "uuid": "ec5057af-156c-4284-a5f4-9843560372e7", "hitokoto": "月落乌啼霜满天，江枫渔火对愁眠。", "type": "i", "from": "枫桥夜泊 / 夜泊枫江", "from_who": "张继", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266495", "length": 16}, {"id": 5634, "uuid": "4a256755-fed1-4c82-a230-9fd80b13fc63", "hitokoto": "山重水复疑无路，柳暗花明又一村。", "type": "i", "from": "游山西村", "from_who": "陆游", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266495", "length": 16}, {"id": 5635, "uuid": "d4d3f2e4-28fe-46fc-a109-8fcc2581a82e", "hitokoto": "寻寻觅觅，冷冷清清，凄凄惨惨戚戚。", "type": "i", "from": "声声慢·寻寻觅觅", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266496", "length": 17}, {"id": 5636, "uuid": "04ec54d2-e296-4d61-a3f2-9f3b3c643af8", "hitokoto": "宣父犹能畏后生，丈夫未可轻年少。", "type": "i", "from": "上李邕", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266496", "length": 16}, {"id": 5637, "uuid": "bcbdf1dd-29e1-4969-aca1-c1cd5afc799e", "hitokoto": "危楼高百尺，手可摘星辰。", "type": "i", "from": "夜宿山寺", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266496", "length": 12}, {"id": 5638, "uuid": "d361e4f9-47e9-42ad-ae18-1b4fd9b91669", "hitokoto": "小荷才露尖尖角，早有蜻蜓立上头。", "type": "i", "from": "小池", "from_who": "杨万里", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266497", "length": 16}, {"id": 5639, "uuid": "9cf87566-1732-41ac-9efa-489554886aba", "hitokoto": "成事不说，遂事不谏，既往不咎。", "type": "i", "from": "论语·八佾篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266497", "length": 15}, {"id": 5640, "uuid": "42cd9ae5-c048-4307-8c46-eb32cd8efaa8", "hitokoto": "我欲穿花寻路，直入白云深处，浩气展虹霓。", "type": "i", "from": "水调歌头·游览", "from_who": "黄庭坚", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266497", "length": 20}, {"id": 5641, "uuid": "7d8a6229-1e7b-45bb-a98e-70f31e935544", "hitokoto": "春风又绿江南岸，明月何时照我还？", "type": "i", "from": "泊船瓜洲", "from_who": "王安石", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266498", "length": 16}, {"id": 5642, "uuid": "ad85f3c0-31ec-4c82-814a-8d59d1d06ba9", "hitokoto": "蝉噪林逾静，鸟鸣山更幽。", "type": "i", "from": "入若耶溪", "from_who": "王籍", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266498", "length": 12}, {"id": 5643, "uuid": "8057041c-ad1c-4b0a-b636-70504403c4aa", "hitokoto": "世情薄，人情恶，雨送黄昏花易落。", "type": "i", "from": "钗头凤·世情薄", "from_who": "唐婉", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266498", "length": 16}, {"id": 5644, "uuid": "e245396b-331b-48b4-89f9-877f8a8ce47c", "hitokoto": "洛阳亲友如相问，一片冰心在玉壶。", "type": "i", "from": "芙蓉楼送辛渐", "from_who": "王昌龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586266499", "length": 16}, {"id": 5645, "uuid": "d7b65ac4-4c9f-4164-8b65-148e4bc65dec", "hitokoto": "春心莫共花争发，一寸相思一寸灰！", "type": "i", "from": "无题·飒飒东风细雨来", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271513", "length": 16}, {"id": 5646, "uuid": "4d41d306-7fbf-449d-b46e-18ada1b36f0c", "hitokoto": "年年岁岁花相似，岁岁年年人不同。", "type": "i", "from": "代悲白头翁 / 白头吟 / 有所思", "from_who": "刘希夷", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271513", "length": 16}, {"id": 5647, "uuid": "0afdc1ab-ea93-447a-9f0e-736ab16dbace", "hitokoto": "十年一觉扬州梦，赢得青楼薄幸名。", "type": "i", "from": "遣怀", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271513", "length": 16}, {"id": 5648, "uuid": "b545bc97-d1c5-4a47-bdd1-7eaa4cb1239e", "hitokoto": "东边日出西边雨，道是无晴却有晴。", "type": "i", "from": "竹枝词二首·其一", "from_who": "刘禹锡", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271514", "length": 16}, {"id": 5649, "uuid": "45613f4d-b668-42fd-a2c9-bdd0cee395b6", "hitokoto": "青青子衿，悠悠我心。", "type": "i", "from": "诗经·郑风·子衿", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271514", "length": 10}, {"id": 5650, "uuid": "c0daadc0-6887-47ff-9365-2b2cdd270916", "hitokoto": "肠已断，泪难收。相思重上小红楼。", "type": "i", "from": "鹧鸪天·晚日寒鸦一片愁", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271515", "length": 16}, {"id": 5651, "uuid": "3d5fee9f-f124-4080-bbaf-0b1dfa8261af", "hitokoto": "愿为西南风，长逝入君怀。", "type": "i", "from": "明月上高楼", "from_who": "曹植", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271515", "length": 12}, {"id": 5652, "uuid": "c4c7de80-5fe8-4353-a446-a42b7988745b", "hitokoto": "多情只有春庭月，犹为离人照落花。", "type": "i", "from": "寄人", "from_who": "张泌", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271515", "length": 16}, {"id": 5653, "uuid": "51c35c88-7fd1-46ff-ae60-86af04f20045", "hitokoto": "红豆生南国，春来发几枝。", "type": "i", "from": "相思", "from_who": "王维", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271516", "length": 12}, {"id": 5654, "uuid": "eefb51c9-2054-4b8d-80bd-0c933e6b2d3e", "hitokoto": "谁念西风独自凉，萧萧黄叶闭疏窗，沉思往事立残阳。", "type": "i", "from": "浣溪沙·谁念西风独自凉", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271516", "length": 24}, {"id": 5655, "uuid": "f02f2a24-2bd2-4593-9f10-b099cd3d2549", "hitokoto": "昔去雪如花，今来花似雪。", "type": "i", "from": "别诗", "from_who": "范云", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271517", "length": 12}, {"id": 5656, "uuid": "910c1560-6f37-4b06-a1a6-ae0100034f07", "hitokoto": "大漠孤烟直，长河落日圆。", "type": "i", "from": "使至塞上", "from_who": "王维", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271517", "length": 12}, {"id": 5657, "uuid": "f1d0457d-533c-4833-a41d-995b2e462f3d", "hitokoto": "位卑未敢忘忧国，事定犹须待阖棺。", "type": "i", "from": "病起书怀", "from_who": "陆游", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271517", "length": 16}, {"id": 5658, "uuid": "68bf6900-4068-418b-938e-5ac40a159fc3", "hitokoto": "咬定青山不放松，立根原在破岩中。", "type": "i", "from": "竹石", "from_who": "郑燮", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271518", "length": 16}, {"id": 5659, "uuid": "fc4b6ee1-e2be-4b96-a3c5-bb5f1bf2204f", "hitokoto": "大鹏一日同风起，扶摇直上九万里。", "type": "i", "from": "上李邕", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271518", "length": 16}, {"id": 5660, "uuid": "21a562f8-ee11-42ff-9cec-328dd5eebaed", "hitokoto": "松花酿酒，春水煎茶。", "type": "i", "from": "人月圆·山中书事", "from_who": "张可久", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271518", "length": 10}, {"id": 5661, "uuid": "ea9685ec-7700-4260-9de2-5584aa8ab1dd", "hitokoto": "曾与美人桥上别，恨无消息到今朝。", "type": "i", "from": "杨柳枝 / 柳枝词", "from_who": "刘禹锡", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271519", "length": 16}, {"id": 5662, "uuid": "1c5d5e81-8818-47b7-9126-06ead904c1c1", "hitokoto": "落叶他乡树，寒灯独夜人。", "type": "i", "from": "灞上秋居", "from_who": "马戴", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271519", "length": 12}, {"id": 5663, "uuid": "a4ea4023-31ff-48ab-a193-910f9984f460", "hitokoto": "远看山有色，近听水无声。", "type": "i", "from": "画", "from_who": "王维", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271519", "length": 12}, {"id": 5664, "uuid": "8ede34c4-2c7b-4de7-93a9-c2e804915cbc", "hitokoto": "等闲识得东风面，万紫千红总是春。", "type": "i", "from": "春日", "from_who": "朱熹", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271520", "length": 16}, {"id": 5665, "uuid": "ee3e0359-0234-43b8-8660-a96109fe2851", "hitokoto": "明月几时有？把酒问青天。", "type": "i", "from": "水调歌头·丙辰中秋", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271520", "length": 12}, {"id": 5666, "uuid": "2045a85d-ba1b-4eb7-9cb0-1f9dc4246540", "hitokoto": "自是人生长恨水长东。", "type": "i", "from": "相见欢·林花谢了春红", "from_who": "李煜", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271520", "length": 10}, {"id": 5667, "uuid": "95b48c62-09f6-4bd7-8637-37dacdc13e83", "hitokoto": "羡青山有思，白鹤忘机。", "type": "i", "from": "八声甘州·摘青梅荐酒", "from_who": "汤恢", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271521", "length": 11}, {"id": 5668, "uuid": "2bac9f6a-475e-4867-881d-3490565afcbf", "hitokoto": "秋阴不散霜飞晚，留得枯荷听雨声。", "type": "i", "from": "宿骆氏亭寄怀崔雍崔衮", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271521", "length": 16}, {"id": 5669, "uuid": "f4a584c8-57ad-47c5-8b51-ded82f97016d", "hitokoto": "嫦娥应悔偷灵药，碧海青天夜夜心。", "type": "i", "from": "嫦娥", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271521", "length": 16}, {"id": 5670, "uuid": "8a67cb5f-e107-4f06-b4bf-7548e54f1deb", "hitokoto": "七八个星天外，两三点雨山前。", "type": "i", "from": "西江月·夜行黄沙道中", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271522", "length": 14}, {"id": 5671, "uuid": "1f161335-016c-4ab5-b2d2-f13e19ca7716", "hitokoto": "采菊东篱下，悠然见南山。", "type": "i", "from": "饮酒·其五", "from_who": "陶渊明", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271522", "length": 12}, {"id": 5672, "uuid": "8f0efbb5-6863-4e09-9b9c-5f6b1b257a8d", "hitokoto": "劝君更尽一杯酒，西出阳关无故人。", "type": "i", "from": "渭城曲 / 送元二使安西", "from_who": "王维", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271523", "length": 16}, {"id": 5673, "uuid": "aa6e56b1-e4d6-4044-8e52-7e582e0077c2", "hitokoto": "南朝四百八十寺，多少楼台烟雨中。", "type": "i", "from": "江南春", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271523", "length": 16}, {"id": 5674, "uuid": "b5c3fba1-4218-4eef-be2d-2a1623182161", "hitokoto": "南风知我意，吹梦到西洲。", "type": "i", "from": "西洲曲", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271523", "length": 12}, {"id": 5675, "uuid": "10e3a121-39d2-4516-b241-e1c1a0173139", "hitokoto": "人生亦有命，安能行叹复坐愁？", "type": "i", "from": "拟行路难·其四", "from_who": "鲍照", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271524", "length": 14}, {"id": 5676, "uuid": "4608e405-4bd2-40f1-b374-0eb7f7632385", "hitokoto": "当时明月在，曾照彩云归。", "type": "i", "from": "临江仙·梦后楼台高锁", "from_who": "晏几道", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271524", "length": 12}, {"id": 5677, "uuid": "b2b6918f-32ff-4d1c-a291-f3112668ad0e", "hitokoto": "三十功名尘与土，八千里路云和月。", "type": "i", "from": "满江红·写怀", "from_who": "岳飞", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271524", "length": 16}, {"id": 5678, "uuid": "1848816a-ddb6-4d5d-b57d-3bd6daac606c", "hitokoto": "沧海月明珠有泪，蓝田日暖玉生烟。", "type": "i", "from": "锦瑟", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271525", "length": 16}, {"id": 5679, "uuid": "e3497578-17a0-498c-a711-30d1e53804b8", "hitokoto": "井蛙不可以语于海者，拘于虚也；夏虫不可以语于冰者，笃于时也", "type": "i", "from": "庄子·外篇·秋水", "from_who": "庄子休", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271525", "length": 29}, {"id": 5680, "uuid": "ec0238ec-351c-41e0-bcf4-b568d904bc86", "hitokoto": "出师未捷身先死，长使英雄泪满襟。", "type": "i", "from": "蜀相", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271525", "length": 16}, {"id": 5681, "uuid": "a2a766a0-ed4a-4d91-a088-0643d88a8a6d", "hitokoto": "近乡情更怯，不敢问来人。", "type": "i", "from": "渡汉江", "from_who": "宋之问", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271526", "length": 12}, {"id": 5682, "uuid": "3d794054-9b3e-4e99-be66-889188d7c192", "hitokoto": "星垂平野阔，月涌大江流。", "type": "i", "from": "旅夜书怀", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271526", "length": 12}, {"id": 5683, "uuid": "f216d82b-52cb-4737-9f28-7122b45d033d", "hitokoto": "朔风如解意，容易莫摧残。", "type": "i", "from": "梅花", "from_who": "崔道融", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271526", "length": 12}, {"id": 5684, "uuid": "25ff2fde-8f8b-4714-b7c9-7ac4fc154589", "hitokoto": "黑发不知勤学早，白首方悔读书迟。", "type": "i", "from": "劝学诗", "from_who": "颜真卿", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271527", "length": 16}, {"id": 5685, "uuid": "c96a0d32-ac23-4cb7-95c7-6abb2f892a01", "hitokoto": "春水碧于天，画船听雨眠。", "type": "i", "from": "菩萨蛮·人人尽说江南好", "from_who": "韦庄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271528", "length": 12}, {"id": 5686, "uuid": "46d64388-66f1-407e-a78f-f333bc7091fd", "hitokoto": "一道残阳铺水中，半江瑟瑟半江红。", "type": "i", "from": "暮江吟", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271528", "length": 16}, {"id": 5687, "uuid": "1024613d-2ad7-4ef2-abc1-2a9dec14585a", "hitokoto": "无情不似多情苦。一寸还成千万缕。", "type": "i", "from": "玉楼春·春恨", "from_who": "晏殊", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271529", "length": 16}, {"id": 5688, "uuid": "2d7a549e-5ace-42fc-ad1f-720551956279", "hitokoto": "盛年不重来，一日难再晨。", "type": "i", "from": "杂诗·人生无根蒂", "from_who": "陶渊明", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271530", "length": 12}, {"id": 5689, "uuid": "5e80749f-3c75-46ef-94b3-1e5fc4c5869d", "hitokoto": "此情无计可消除，才下眉头，却上心头。", "type": "i", "from": "一剪梅·红藕香残玉簟秋", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271530", "length": 18}, {"id": 5690, "uuid": "0d0542f4-8112-4d1a-9c27-1ccb28235f85", "hitokoto": "君问归期未有期，巴山夜雨涨秋池。", "type": "i", "from": "夜雨寄北", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271531", "length": 16}, {"id": 5691, "uuid": "9759b119-6caa-4666-9020-7e0ae6495d07", "hitokoto": "以色事他人，能得几时好。", "type": "i", "from": "妾薄命", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271531", "length": 12}, {"id": 5692, "uuid": "877be8c6-f8cd-423d-b360-8a383251c7bb", "hitokoto": "我住长江头，君住长江尾。", "type": "i", "from": "卜算子·我住长江头", "from_who": "李之仪", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271532", "length": 12}, {"id": 5693, "uuid": "9075e9b6-da61-48d9-8810-7871f08b9274", "hitokoto": "关关雎鸠，在河之洲。窈窕淑女，君子好逑。", "type": "i", "from": "关雎", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271532", "length": 20}, {"id": 5694, "uuid": "ad896286-cf93-419a-9cd6-469cad5c496e", "hitokoto": "满目山河空念远，落花风雨更伤春。", "type": "i", "from": "浣溪沙·一向年光有限身", "from_who": "晏殊", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271533", "length": 16}, {"id": 5695, "uuid": "9d6aac27-09cc-4a89-8db5-252b39f19cc9", "hitokoto": "草木有本心，何求美人折！", "type": "i", "from": "感遇十二首·其一", "from_who": "张九龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271533", "length": 12}, {"id": 5696, "uuid": "9e634b24-8087-4e29-a9b3-8fc5f4a1c567", "hitokoto": "会当凌绝顶，一览众山小。", "type": "i", "from": "望岳", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271533", "length": 12}, {"id": 5697, "uuid": "642db1fc-4dc8-4303-b762-563d5a061cf6", "hitokoto": "绿杨烟外晓寒轻，红杏枝头春意闹。", "type": "i", "from": "玉楼春·春景", "from_who": "宋祁", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271534", "length": 16}, {"id": 5698, "uuid": "9a66cd4d-5a16-4aee-8ee1-32610978905e", "hitokoto": "海内存知己，天涯若比邻。", "type": "i", "from": "送杜少府之任蜀州 / 送杜少府之任蜀川", "from_who": "王勃", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271534", "length": 12}, {"id": 5699, "uuid": "4d90cc52-3aca-4461-9772-5c23bda221f9", "hitokoto": "但愿人长久，千里共婵娟。", "type": "i", "from": "水调歌头·丙辰中秋", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271534", "length": 12}, {"id": 5700, "uuid": "ef37fb8e-8228-4d19-b561-6cc62014b52e", "hitokoto": "人生到处知何似，应似飞鸿踏雪泥。", "type": "i", "from": "和子由渑池怀旧", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271535", "length": 16}, {"id": 5701, "uuid": "16e18962-9d36-4028-a168-84914c845f25", "hitokoto": "水晶帘动微风起，满架蔷薇一院香。", "type": "i", "from": "山亭夏日", "from_who": "高骈", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271535", "length": 16}, {"id": 5702, "uuid": "553d8445-f4bd-4dbf-a3c8-a85f4d61821c", "hitokoto": "欲寄彩笺兼尺素，山长水阔知何处。", "type": "i", "from": "蝶恋花·槛菊愁烟兰泣露", "from_who": "晏殊", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271535", "length": 16}, {"id": 5703, "uuid": "6ee66a84-6559-4dd2-a467-4ff9676172ce", "hitokoto": "绿蚁新醅酒，红泥小火炉。", "type": "i", "from": "问刘十九", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271536", "length": 12}, {"id": 5704, "uuid": "80a3bb77-8ff7-4429-b38b-5a1166a7165f", "hitokoto": "天生我材必有用，千金散尽还复来。", "type": "i", "from": "将进酒", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586271536", "length": 16}, {"id": 5705, "uuid": "a326411e-882a-4162-8db1-b1ae16c51ebb", "hitokoto": "劝君莫惜花前醉，今年花谢，明年花谢，白了人头。", "type": "i", "from": "青杏儿·风雨替花愁", "from_who": "赵秉文", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333483", "length": 23}, {"id": 5706, "uuid": "eab0b49a-af9a-475a-ab73-85741d987c83", "hitokoto": "兰陵美酒郁金香，玉碗盛来琥珀光。", "type": "i", "from": "客中行 / 客中作", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586333484", "length": 16}]