[{"id": 5807, "uuid": "4891b487-c0ce-44fd-9fd4-35e0e00bd6a3", "hitokoto": "举杯邀明月，对影成三人。", "type": "i", "from": "月下独酌四首·其一", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395488", "length": 12}, {"id": 5808, "uuid": "5f12a642-4c0c-4047-bd6e-6860961cd8b6", "hitokoto": "八阵图名成卧龙，六韬书功在飞熊。", "type": "i", "from": "蟾宫曲·怀古", "from_who": "查德卿", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395488", "length": 16}, {"id": 5809, "uuid": "b0735608-833f-4eb9-83b5-a7bb77f91a21", "hitokoto": "无情最是台城柳，依旧烟笼十里堤。", "type": "i", "from": "台城", "from_who": "韦庄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395489", "length": 16}, {"id": 5810, "uuid": "d87d5723-1906-46bc-bb10-ac9b18e57bff", "hitokoto": "江流天地外，山色有无中。", "type": "i", "from": "汉江临泛 / 汉江临眺", "from_who": "王维", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395489", "length": 12}, {"id": 5811, "uuid": "d146725f-fa8b-4da4-83aa-5cfb4d623374", "hitokoto": "黑云翻墨未遮山，白雨跳珠乱入船。", "type": "i", "from": "六月二十七日望湖楼醉书", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395489", "length": 16}, {"id": 5812, "uuid": "d2a1be4f-2d93-44f6-a477-33e6757af616", "hitokoto": "日啖荔枝三百颗，不辞长作岭南人。", "type": "i", "from": "惠州一绝", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395490", "length": 16}, {"id": 5813, "uuid": "61c1091b-2048-4515-a7d7-0659a8aef129", "hitokoto": "九州生气恃风雷，万马齐喑究可哀。", "type": "i", "from": "己亥杂诗·其二百二十", "from_who": "龚自珍", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395490", "length": 16}, {"id": 5814, "uuid": "2d9fd070-bd92-4c0a-b098-70e141372c92", "hitokoto": "流光容易把人抛，红了樱桃，绿了芭蕉。", "type": "i", "from": "一剪梅·舟过吴江", "from_who": "蒋捷", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395490", "length": 18}, {"id": 5815, "uuid": "f674900b-734b-4b11-aa31-bdcf97c20232", "hitokoto": "功名万里外，心事一杯中。", "type": "i", "from": "送李侍御赴安西", "from_who": "高适", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395491", "length": 12}, {"id": 5816, "uuid": "e1749b8a-4b1a-4e98-91b5-2e72cfd2913a", "hitokoto": "黄梅时节家家雨，青草池塘处处蛙。", "type": "i", "from": "约客 / 有约", "from_who": "赵师秀", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395491", "length": 16}, {"id": 5817, "uuid": "6e7cc075-3fa1-42c3-b215-fdfe6cc56988", "hitokoto": "若似月轮终皎洁，不辞冰雪为卿热。", "type": "i", "from": "蝶恋花·辛苦最怜天上月", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395491", "length": 16}, {"id": 5818, "uuid": "49df3f8a-63f4-4903-aa35-c8bf39dca7af", "hitokoto": "月儿弯弯照九州，几家欢乐几家愁。", "type": "i", "from": "月儿弯弯照九州", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395492", "length": 16}, {"id": 5819, "uuid": "cd091bac-4dff-4f3b-b06f-c62c4f8082c3", "hitokoto": "南国有佳人，容华若桃李。", "type": "i", "from": "杂诗·南国有佳人", "from_who": "曹植", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395492", "length": 12}, {"id": 5820, "uuid": "09fbd777-3011-4a1a-9a21-db890c5e3a6e", "hitokoto": "此生此夜不长好，明月明年何处看。", "type": "i", "from": "阳关曲 / 中秋月", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395492", "length": 16}, {"id": 5821, "uuid": "c66df82e-6a16-4bf0-a689-30ee4e58f2d9", "hitokoto": "莫笑贱贫夸富贵，共成枯骨两何如？", "type": "i", "from": "放言五首·其四", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395493", "length": 16}, {"id": 5822, "uuid": "caea5e47-9fe6-4cc3-9a1f-d8eaaab8c2be", "hitokoto": "娶妻无媒毋须恨，书中有女颜如玉。", "type": "i", "from": "劝学诗", "from_who": "赵恒", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395493", "length": 16}, {"id": 5823, "uuid": "2d08f08a-c57b-4cfd-b7f1-336afd31924c", "hitokoto": "诚知此恨人人有，贫贱夫妻百事哀。", "type": "i", "from": "遣悲怀三首·其二", "from_who": "元稹", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395493", "length": 16}, {"id": 5824, "uuid": "653d1f0b-58b2-4dde-8839-8008c1706b4e", "hitokoto": "试玉要烧三日满，辨材须待七年期。", "type": "i", "from": "放言五首·其三", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395380", "length": 16}, {"id": 5825, "uuid": "fc091cdb-58f9-4cfc-90d7-15fed28b1fd7", "hitokoto": "悠悠天宇旷，切切故乡情。", "type": "i", "from": "西江夜行", "from_who": "张九龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395381", "length": 12}, {"id": 5826, "uuid": "fabacf0b-ffd4-43ae-9e53-336e05f0375a", "hitokoto": "海棠未雨，梨花先雪，一半春休。", "type": "i", "from": "眼儿媚·杨柳丝丝弄轻柔", "from_who": "王雱", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395381", "length": 15}, {"id": 5827, "uuid": "d63947c7-133f-4b56-9b6b-a9bb5e440916", "hitokoto": "知我者，谓我心忧；不知我者，谓我何求。", "type": "i", "from": "诗经·国风·王风·黍离", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395381", "length": 19}, {"id": 5828, "uuid": "461b1ef4-7597-4506-80fe-518a8fe97ab5", "hitokoto": "只解沙场为国死，何须马革裹尸还。", "type": "i", "from": "出塞", "from_who": "徐锡麟", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395382", "length": 16}, {"id": 5829, "uuid": "d3046bbc-ee6b-4397-b3f5-535777e6a25d", "hitokoto": "上善若水，水善利万物而不争。", "type": "i", "from": "老子·道经·第八章", "from_who": "李伯阳", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395382", "length": 14}, {"id": 5830, "uuid": "6a058b3d-8f37-40fe-98d2-f1b05b73ff4d", "hitokoto": "一寸柔肠情几许？薄衾孤枕，梦回人静，彻晓潇潇雨。", "type": "i", "from": "青玉案·丝槐烟柳长亭路", "from_who": "惠洪", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395382", "length": 24}, {"id": 5831, "uuid": "96cc31c1-d029-427e-b07f-b0e24cb395d2", "hitokoto": "长恨此身非我有，何时忘却营营。", "type": "i", "from": "临江仙·夜饮东坡醒复醉", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395382", "length": 15}, {"id": 5832, "uuid": "3bed6c1e-c239-45d8-b7b2-8d348ef6f806", "hitokoto": "去年花里逢君别，今日花开已一年。", "type": "i", "from": "寄李儋元锡", "from_who": "韦应物", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395383", "length": 16}, {"id": 5833, "uuid": "8f9b8d5c-ba8b-4dd9-82d0-a329b2a38087", "hitokoto": "明月出天山，苍茫云海间。", "type": "i", "from": "关山月", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395383", "length": 12}, {"id": 5834, "uuid": "ec343761-23a4-468d-a85b-858bda470423", "hitokoto": "日出江花红胜火，春来江水绿如蓝。", "type": "i", "from": "忆江南·江南好", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395384", "length": 16}, {"id": 5835, "uuid": "8cf2cd34-4e8b-4ff5-a6c7-2f5f1b73e845", "hitokoto": "欲把西湖比西子，淡妆浓抹总相宜。", "type": "i", "from": "饮湖上初晴后雨二首·其二", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395384", "length": 16}, {"id": 5836, "uuid": "db70e760-ddc3-4bf9-b9a4-98e2ee85f2af", "hitokoto": "想当年，金戈铁马，气吞万里如虎。", "type": "i", "from": "永遇乐·京口北固亭怀古", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395384", "length": 16}, {"id": 5837, "uuid": "bc5b4d78-3080-4c22-8e8f-a17f960ad47a", "hitokoto": "小楼昨夜又东风，故国不堪回首月明中。", "type": "i", "from": "虞美人·春花秋月何时了", "from_who": "李煜", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395384", "length": 18}, {"id": 5838, "uuid": "d0394f62-1f35-453f-b47c-4a5d8b77a717", "hitokoto": "少无适俗韵，性本爱丘山。", "type": "i", "from": "归园田居·其一", "from_who": "陶渊明", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395385", "length": 12}, {"id": 5839, "uuid": "6a7e5713-e9e1-4d0a-abe2-96060918b22f", "hitokoto": "忽如一夜春风来，千树万树梨花开。", "type": "i", "from": "白雪歌送武判官归京", "from_who": "岑参", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395385", "length": 16}, {"id": 5840, "uuid": "b44c8eef-0b6b-4afe-8f92-667d68518401", "hitokoto": "小舟从此逝，江海寄余生。", "type": "i", "from": "临江仙·夜饮东坡醒复醉", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395385", "length": 12}, {"id": 5841, "uuid": "b8056790-12a2-4ee8-8d19-34930484c33e", "hitokoto": "青山隐隐水迢迢，秋尽江南草未凋。", "type": "i", "from": "寄扬州韩绰判官", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395386", "length": 16}, {"id": 5842, "uuid": "388a29ed-4f22-4777-a037-d45d4fb0f087", "hitokoto": "一别都门三改火，天涯踏尽红尘。", "type": "i", "from": "临江仙·送钱穆父", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395386", "length": 15}, {"id": 5843, "uuid": "f2c72e4d-d21b-41c2-b95e-d7c7a108b805", "hitokoto": "天平山上白云泉，云自无心水自闲。", "type": "i", "from": "白云泉", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586395386", "length": 16}, {"id": 5844, "uuid": "222b68de-6783-4bf3-9190-32204f5bce91", "hitokoto": "谁家玉笛暗飞声，散入春风满洛城。", "type": "i", "from": "春夜洛城闻笛", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586333491", "length": 16}, {"id": 5845, "uuid": "e0b36c4b-87d0-4fdc-91ff-26abfde3806c", "hitokoto": "一片春愁待酒浇。江上舟摇，楼上帘招。", "type": "i", "from": "一剪梅·舟过吴江", "from_who": "蒋捷", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398125", "length": 18}, {"id": 5848, "uuid": "e7470aa2-0615-4a99-a722-60828b64ae21", "hitokoto": "不畏浮云遮望眼，只缘身在最高层。", "type": "i", "from": "登飞来峰", "from_who": "王安石", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398123", "length": 16}, {"id": 5849, "uuid": "da02797c-68a7-421b-8f4f-3850262b048c", "hitokoto": "恨君不似江楼月，南北东西，南北东西，只有相随无别离。", "type": "i", "from": "采桑子·恨君不似江楼月", "from_who": "吕本中", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398124", "length": 26}, {"id": 5850, "uuid": "cb877476-c10f-4538-9465-31c0cdbb9524", "hitokoto": "我寄愁心与明月，随风直到夜郎西。", "type": "i", "from": "闻王昌龄左迁龙标遥有此寄", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398124", "length": 16}, {"id": 5852, "uuid": "a57a2393-bde5-48ff-a110-067954fe0e9e", "hitokoto": "黄河远上白云间，一片孤城万仞山。", "type": "i", "from": "凉州词二首·其一", "from_who": "王之涣", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398123", "length": 16}, {"id": 5853, "uuid": "b9d3ca24-55d8-457b-8e37-68b35067bbf6", "hitokoto": "不患无位，患所以立。不患莫己知，求为可知也。", "type": "i", "from": "论语·里仁篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398123", "length": 22}, {"id": 5854, "uuid": "520edfe4-64be-412f-874b-c1f3c5570256", "hitokoto": "似花还似非花，也无人惜从教坠。", "type": "i", "from": "水龙吟·次韵章质夫杨花词", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398124", "length": 15}, {"id": 5855, "uuid": "862c9410-bff1-48ce-a26a-bee64700d42b", "hitokoto": "不识庐山真面目，只缘身在此山中。", "type": "i", "from": "题西林壁", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398125", "length": 16}, {"id": 5856, "uuid": "7544a370-042a-4bfc-9a76-98df8fdae0bf", "hitokoto": "停车坐爱枫林晚，霜叶红于二月花。", "type": "i", "from": "山行", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398125", "length": 16}, {"id": 5857, "uuid": "e4863b47-1abc-4352-822e-2668fe1a54af", "hitokoto": "春城无处不飞花，寒食东风御柳斜。", "type": "i", "from": "寒食 / 寒食日即事", "from_who": "韩翃", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398126", "length": 16}, {"id": 5858, "uuid": "936ec3ab-da2e-4f92-8727-47256b21769b", "hitokoto": "乱山残雪夜，孤烛异乡人。", "type": "i", "from": "除夜 / 巴山道中除夜书怀 / 除夜有怀", "from_who": "崔涂", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398126", "length": 12}, {"id": 5859, "uuid": "df187911-1d7f-46e5-8c62-ad156d9227f0", "hitokoto": "合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。", "type": "i", "from": "老子·德经·第六十四章", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398126", "length": 30}, {"id": 5860, "uuid": "d857c6b4-8508-4b14-9154-d328663c2ce1", "hitokoto": "生当作人杰，死亦为鬼雄。", "type": "i", "from": "夏日绝句", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398127", "length": 12}, {"id": 5861, "uuid": "40fb2d1c-8d6f-4ff4-baa4-b3b73d00e2db", "hitokoto": "青枫江上秋帆远，白帝城边古木疏。", "type": "i", "from": "送李少府贬峡中王少府贬长沙", "from_who": "高适", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398127", "length": 16}, {"id": 5862, "uuid": "62524288-33b8-42eb-9b7f-4ace2c9bee7c", "hitokoto": "何须浅碧深红色，自是花中第一流。", "type": "i", "from": "鹧鸪天·桂花", "from_who": "李清照", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398127", "length": 16}, {"id": 5863, "uuid": "78cc7e38-4eb8-4175-9101-777f58f0523e", "hitokoto": "爆竹声中一岁除，春风送暖入屠苏。", "type": "i", "from": "元日", "from_who": "王安石", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398128", "length": 16}, {"id": 5864, "uuid": "f25d3108-7222-4d00-8e71-5e548796db1d", "hitokoto": "云母屏风烛影深，长河渐落晓星沉。", "type": "i", "from": "嫦娥", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398128", "length": 16}, {"id": 5865, "uuid": "d9c73dc6-caa7-4e31-b126-f428f4e9d4a9", "hitokoto": "巧笑倩兮，美目盼兮，素以为绚兮。", "type": "i", "from": "论语·八佾篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398128", "length": 16}, {"id": 5866, "uuid": "d717508e-9195-4398-84e4-a100312aabee", "hitokoto": "漠漠水田飞白鹭，阴阴夏木啭黄鹂。", "type": "i", "from": "积雨辋川庄作 / 秋归辋川庄作", "from_who": "王维", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398129", "length": 16}, {"id": 5867, "uuid": "d9e150a4-0264-4420-8295-8c68f2dea7b2", "hitokoto": "千金纵买相如赋，脉脉此情谁诉。", "type": "i", "from": "摸鱼儿·更能消几番风雨", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398129", "length": 15}, {"id": 5868, "uuid": "6d997ef0-28f8-438a-b29e-1e641b024071", "hitokoto": "一寸相思千万绪。人间没个安排处。", "type": "i", "from": "蝶恋花·春暮", "from_who": "李冠", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398129", "length": 16}, {"id": 5869, "uuid": "5d4185c6-4e3f-46be-acaf-046738c100e4", "hitokoto": "胜日寻芳泗水滨，无边光景一时新。", "type": "i", "from": "春日", "from_who": "朱熹", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398129", "length": 16}, {"id": 5870, "uuid": "3e77587e-5942-4c3f-9fa6-7b6689741ac7", "hitokoto": "清风明月无人管，并作南楼一味凉。", "type": "i", "from": "鄂州南楼书事", "from_who": "黄庭坚", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398130", "length": 16}, {"id": 5871, "uuid": "fa63b704-a3c2-4bdf-a746-1c4aad00f151", "hitokoto": "昔我往矣，杨柳依依。", "type": "i", "from": "采薇", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398130", "length": 10}, {"id": 5872, "uuid": "414351a1-e71f-470c-9934-db7fe1ce5ce8", "hitokoto": "有三秋桂子，十里荷花。", "type": "i", "from": "望海潮·东南形胜", "from_who": "柳永", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398130", "length": 11}, {"id": 5873, "uuid": "05044964-363b-4f57-a9d1-9089dfefec0c", "hitokoto": "数人世相逢，百年欢笑，能得几回又。", "type": "i", "from": "摸鱼儿·记年时人人何处", "from_who": "何梦桂", "creator": "a632079", "creator_uid": 1044, "reviewer": 4756, "commit_from": "web", "created_at": "1586398131", "length": 17}, {"id": 5874, "uuid": "238f79a7-7854-4b54-9a98-6dc876cd3614", "hitokoto": "红泪偷垂，满眼春风百事非。", "type": "i", "from": "采桑子·当时错", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398131", "length": 13}, {"id": 5875, "uuid": "b4bf82c4-578d-4f39-a030-21c041a19bcd", "hitokoto": "相看两不厌，只有敬亭山。", "type": "i", "from": "独坐敬亭山", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398131", "length": 12}, {"id": 5876, "uuid": "d5702d51-e64d-4d11-8805-9fb629531fab", "hitokoto": "汴水流，泗水流，流到瓜州古渡头。吴山点点愁。", "type": "i", "from": "长相思·汴水流", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398132", "length": 22}, {"id": 5877, "uuid": "f1b9ef22-744b-4684-a9fd-e2aa46a78e2c", "hitokoto": "垂死病中惊坐起，暗风吹雨入寒窗。", "type": "i", "from": "闻乐天授江州司马", "from_who": "元稹", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398132", "length": 16}, {"id": 5878, "uuid": "20ce1f5f-b69b-46af-8117-9e48c01679c0", "hitokoto": "若言琴上有琴声，放在匣中何不鸣？", "type": "i", "from": "琴诗", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398132", "length": 16}, {"id": 5879, "uuid": "800a7e0b-92c7-4058-acc2-51260cfb6d41", "hitokoto": "恰同学少年，风华正茂；书生意气，挥斥方遒。", "type": "i", "from": "沁园春·长沙", "from_who": "毛泽东", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398133", "length": 21}, {"id": 5880, "uuid": "d8d8819d-957e-47c1-9943-208be84fbc14", "hitokoto": "唯有门前镜湖水，春风不改旧时波。", "type": "i", "from": "回乡偶书二首", "from_who": "贺知章", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398133", "length": 16}, {"id": 5881, "uuid": "ec540c3b-75fc-428a-9b49-8927ed32abd7", "hitokoto": "风淅淅，雨纤纤。难怪春愁细细添。", "type": "i", "from": "赤枣子·风淅淅", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398133", "length": 16}, {"id": 5882, "uuid": "f8396121-2769-41e4-8267-6c635c27c570", "hitokoto": "荷叶罗裙一色裁，芙蓉向脸两边开。", "type": "i", "from": "采莲曲", "from_who": "王昌龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398133", "length": 16}, {"id": 5883, "uuid": "e7edd354-edd1-4f20-afad-30074c948cb0", "hitokoto": "路曼曼其修远兮，吾将上下而求索。", "type": "i", "from": "离骚", "from_who": "屈原", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398134", "length": 16}, {"id": 5884, "uuid": "3d9ce682-0261-4360-9103-bc0043c5365e", "hitokoto": "相思一夜梅花发，忽到窗前疑是君。", "type": "i", "from": "有所思", "from_who": "卢仝", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398134", "length": 16}, {"id": 5885, "uuid": "8673a1ce-ff63-4365-8652-e7f172ca9209", "hitokoto": "荷叶生时春恨生，荷叶枯时秋恨成。", "type": "i", "from": "暮秋独游曲江", "from_who": "李商隐", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398134", "length": 16}, {"id": 5886, "uuid": "e7be2b06-a5c5-4fef-8cf6-48f47b5fd0a3", "hitokoto": "见贤思齐焉，见不贤而内自省也。", "type": "i", "from": "论语·里仁篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398135", "length": 15}, {"id": 5887, "uuid": "062800b5-44eb-487f-b13f-2226fa0b90a0", "hitokoto": "弱水三千，我只取一瓢饮。", "type": "i", "from": "红楼梦·第九十一回", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398135", "length": 12}, {"id": 5888, "uuid": "2d651615-6164-4f20-beaf-29bcc8803685", "hitokoto": "青青园中葵，朝露待日晞。", "type": "i", "from": "长歌行", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398135", "length": 12}, {"id": 5889, "uuid": "2855c7b0-dfc9-455b-838b-8401bf713e24", "hitokoto": "楼船夜雪瓜洲渡，铁马秋风大散关。", "type": "i", "from": "书愤五首·其一", "from_who": "陆游", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398136", "length": 16}, {"id": 5890, "uuid": "51262639-ff07-4586-abe9-a9c96df8c4b1", "hitokoto": "一壶酒，一竿身，快活如侬有几人。", "type": "i", "from": "渔父·浪花有意千里雪", "from_who": "李煜", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398136", "length": 16}, {"id": 5891, "uuid": "1b11962a-fbc7-4364-ac4b-5733bf7ffe55", "hitokoto": "质胜文则野，文胜质则史，文质彬彬，然后君子。", "type": "i", "from": "论语·雍也篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398136", "length": 22}, {"id": 5892, "uuid": "124d1a27-11f9-4f6c-93dd-e21987386284", "hitokoto": "皑如山上雪，皎若云间月。", "type": "i", "from": "白头吟", "from_who": "卓文君", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398137", "length": 12}, {"id": 5893, "uuid": "ce58802f-66f3-4ba3-b907-ebe5b77b8537", "hitokoto": "相见争如不见，多情何似无情。", "type": "i", "from": "西江月·宝髻松松挽就", "from_who": "司马光", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398137", "length": 14}, {"id": 5894, "uuid": "0b679523-31ea-4f19-866d-a22a7b519424", "hitokoto": "老来情味减，对别酒、怯流年。", "type": "i", "from": "木兰花慢·滁州送范倅", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398137", "length": 14}, {"id": 5895, "uuid": "283288db-5bfc-4847-9168-e3b0e3f3458c", "hitokoto": "今宵酒醒何处？杨柳岸，晓风残月。", "type": "i", "from": "雨霖铃·寒蝉凄切", "from_who": "柳永", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398137", "length": 16}, {"id": 5896, "uuid": "aeaccb4a-00a0-4e53-a6d9-746916e44078", "hitokoto": "迢迢牵牛星，皎皎河汉女。", "type": "i", "from": "迢迢牵牛星", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398138", "length": 12}, {"id": 5897, "uuid": "9bbde2d2-b625-4112-9bf0-1c99011e164a", "hitokoto": "依旧，依旧，人与绿杨俱瘦。", "type": "i", "from": "如梦令·春景", "from_who": "秦观", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398138", "length": 13}, {"id": 5898, "uuid": "ba485f03-8ebf-493f-b194-d438b307e90a", "hitokoto": "千里莺啼绿映红，水村山郭酒旗风。", "type": "i", "from": "江南春", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398138", "length": 16}, {"id": 5899, "uuid": "21dfdd60-16eb-49ac-a18b-a2a4cd86ccce", "hitokoto": "相见争如不见，多情何似无情。", "type": "i", "from": "西江月·宝髻松松挽就", "from_who": "司马光", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398139", "length": 14}, {"id": 5900, "uuid": "bc39ec69-0c98-4f79-bca4-10ba3a545d5d", "hitokoto": "感时花溅泪，恨别鸟惊心。", "type": "i", "from": "春望", "from_who": "杜甫", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398139", "length": 12}, {"id": 5901, "uuid": "41b6c505-74c0-4f3a-89f4-81c3a3fea26d", "hitokoto": "春未绿，鬓先丝。人间别久不成悲。", "type": "i", "from": "鹧鸪天·元夕有所梦", "from_who": "姜夔", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398139", "length": 16}, {"id": 5902, "uuid": "a73f6dda-cfce-4a12-b51d-130eb5bd6fab", "hitokoto": "丈夫非无泪，不洒离别间。", "type": "i", "from": "别离", "from_who": "陆龟蒙", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398140", "length": 12}, {"id": 5903, "uuid": "13aa09d1-cefd-41db-bd9b-afaee63e15cf", "hitokoto": "未觉池塘春草梦，阶前梧叶已秋声。", "type": "i", "from": "偶成", "from_who": "朱熹", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398140", "length": 16}, {"id": 5904, "uuid": "6f8d1ce9-59cc-44fa-af63-41a6f9591f46", "hitokoto": "殷勤昨夜三更雨，又得浮生一日凉。", "type": "i", "from": "鹧鸪天·林断山明竹隐墙", "from_who": "苏轼", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398140", "length": 16}, {"id": 5905, "uuid": "11d22166-4765-4c0a-8353-9d7627d5167b", "hitokoto": "千古兴亡多少事？悠悠。不尽长江滚滚流。", "type": "i", "from": "南乡子·登京口北固亭有怀", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398141", "length": 19}, {"id": 5906, "uuid": "1dddd3db-b9b4-4860-b9c5-412a8c8289da", "hitokoto": "惟将终夜常开眼，报答平生未展眉。", "type": "i", "from": "遣悲怀三首·其三", "from_who": "元稹", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398141", "length": 16}, {"id": 5907, "uuid": "cd06b26f-1fee-4c50-b347-dd94cc856760", "hitokoto": "草木也知愁，韶华竟白头。", "type": "i", "from": "唐多令·柳絮", "from_who": "曹雪芹", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398142", "length": 12}, {"id": 5908, "uuid": "e1ef5063-3855-4255-85f2-372a30ef751d", "hitokoto": "银烛秋光冷画屏，轻罗小扇扑流萤。", "type": "i", "from": "秋夕", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398480", "length": 16}, {"id": 5909, "uuid": "56f2db50-d33b-4d1e-8e7b-db6f3d6b5b63", "hitokoto": "人生得意须尽欢，莫使金樽空对月。", "type": "i", "from": "将进酒", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398480", "length": 16}]