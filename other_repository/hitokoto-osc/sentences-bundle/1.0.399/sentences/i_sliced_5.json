[{"id": 5910, "uuid": "dfa0f3eb-d4d0-4fdc-b8e5-5938d1dc4ae1", "hitokoto": "众口铄金，积毁销骨。", "type": "i", "from": "史记·张仪列传", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398481", "length": 10}, {"id": 5911, "uuid": "6b8a8aa8-ae0b-457a-adc4-a3d0ea6b6246", "hitokoto": "美人自古如名将，不许人间见白头。", "type": "i", "from": "随园诗话·卷四", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398481", "length": 16}, {"id": 5912, "uuid": "2ddaaff3-232c-4957-9201-32d80a272349", "hitokoto": "衰兰送客咸阳道，天若有情天亦老。", "type": "i", "from": "金铜仙人辞汉歌", "from_who": "李贺", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398481", "length": 16}, {"id": 5913, "uuid": "0800bd93-0ac4-48a8-915e-c94383236c53", "hitokoto": "少小离家老大回，乡音无改鬓毛衰。", "type": "i", "from": "回乡偶书二首·其一", "from_who": "贺知章", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398482", "length": 16}, {"id": 5914, "uuid": "8c72889b-a0b3-4862-b67e-bafa6a55a76d", "hitokoto": "何处望神州？满眼风光北固楼。", "type": "i", "from": "南乡子·登京口北固亭有怀", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398482", "length": 14}, {"id": 5915, "uuid": "082a46a8-00f7-4051-a86f-4ae2cbad3554", "hitokoto": "红颜未老恩先断，斜倚薰笼坐到明。", "type": "i", "from": "后宫词", "from_who": "白居易", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398482", "length": 16}, {"id": 5916, "uuid": "db93a41f-f23e-450b-a045-f46faa943039", "hitokoto": "李白如今已仙去，月在青天几圆缺？", "type": "i", "from": "把酒对月歌", "from_who": "唐寅", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398483", "length": 16}, {"id": 5917, "uuid": "1fd4a5ae-ad14-44f8-913d-c2cf7019d4a2", "hitokoto": "清明时节雨纷纷，路上行人欲断魂。", "type": "i", "from": "清明", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398483", "length": 16}, {"id": 5918, "uuid": "55e90610-f2dc-4305-b2bf-aed69e4b92b4", "hitokoto": "臣心一片磁针石，不指南方不肯休。", "type": "i", "from": "扬子江", "from_who": "文天祥", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398483", "length": 16}, {"id": 5919, "uuid": "522a8a6e-a437-4590-893a-2b70db947287", "hitokoto": "燕子来时新社，梨花落后清明。", "type": "i", "from": "破阵子·春景", "from_who": "晏殊", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398484", "length": 14}, {"id": 5920, "uuid": "34923454-fdba-4aab-a0e7-a831511c2e9b", "hitokoto": "青山相待，白云相爱，梦不到紫罗袍共黄金带。", "type": "i", "from": "山坡羊·道情", "from_who": "宋方壶", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398484", "length": 21}, {"id": 5921, "uuid": "6388d87e-81c4-4cdb-b2a0-2e21937b5724", "hitokoto": "但使龙城飞将在，不教胡马度阴山。", "type": "i", "from": "出塞二首", "from_who": "王昌龄", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398484", "length": 16}, {"id": 5922, "uuid": "faeb71b9-2eb0-44b2-87da-07a51f93563e", "hitokoto": "一别如斯，落尽梨花月又西。", "type": "i", "from": "采桑子·当时错", "from_who": "纳兰性德", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398484", "length": 13}, {"id": 5923, "uuid": "86847a8b-800a-4500-8720-e7620a4e63c9", "hitokoto": "晚日寒鸦一片愁。柳塘新绿却温柔。", "type": "i", "from": "鹧鸪天·晚日寒鸦一片愁", "from_who": "辛弃疾", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398485", "length": 16}, {"id": 5924, "uuid": "982cb74f-d57b-4993-9577-c427ba186bfa", "hitokoto": "山随平野尽，江入大荒流。", "type": "i", "from": "渡荆门送别", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398485", "length": 12}, {"id": 5925, "uuid": "077761e0-454a-4c9b-91ca-e65996bdd652", "hitokoto": "卧看满天云不动，不知云与我俱东。", "type": "i", "from": "襄邑道中", "from_who": "陈与义", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398485", "length": 16}, {"id": 5926, "uuid": "78757b1f-54e1-480e-a7cd-e6acc2c27cf5", "hitokoto": "烟笼寒水月笼沙，夜泊秦淮近酒家。", "type": "i", "from": "泊秦淮", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398486", "length": 16}, {"id": 5927, "uuid": "8877cee1-da01-4a3b-94e3-483d1a8baea7", "hitokoto": "一叫一回肠一断，三春三月忆三巴。", "type": "i", "from": "宣城见杜鹃花 / 子规", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398486", "length": 16}, {"id": 5928, "uuid": "da99bfa5-4da3-4d78-ab03-0bc90cd72211", "hitokoto": "吾十有五而志于学，三十而立，四十而不惑，五十而知天命，六十而耳顺，七十而从心所欲，不逾矩。", "type": "i", "from": "论语·为政篇", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398486", "length": 45}, {"id": 5929, "uuid": "76bc7d55-e434-4b3d-943b-7a03a59efdfd", "hitokoto": "绿树阴浓夏日长，楼台倒影入池塘。", "type": "i", "from": "山亭夏日", "from_who": "高骈", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398487", "length": 16}, {"id": 5930, "uuid": "c93ebf37-578c-4f40-8678-9b6a64939daf", "hitokoto": "梅花雪，梨花月，总相思。", "type": "i", "from": "相见欢·年年负却花期", "from_who": "张惠言", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398487", "length": 12}, {"id": 5931, "uuid": "5c315f69-e2e4-48d9-990d-5be84f7468c2", "hitokoto": "零落成泥碾作尘，只有香如故。", "type": "i", "from": "卜算子·咏梅", "from_who": "陆游", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398487", "length": 14}, {"id": 5932, "uuid": "d35964fd-1e63-4923-8f14-48a74487a622", "hitokoto": "天将降大任于是人也，必先苦其心志，劳其筋骨，饿其体肤，空乏其身，行拂乱其所为。", "type": "i", "from": "孟子·告子章句下·第十五节", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398488", "length": 39}, {"id": 5933, "uuid": "23c1dc26-7b64-41f9-8d01-8fad4377d224", "hitokoto": "兰生幽谷， 不为莫服而不芳。舟在江海，不为莫乘而不浮。君子行义，不为莫知而止休。", "type": "i", "from": "淮南子·说山训", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398488", "length": 40}, {"id": 5934, "uuid": "45e7399b-539e-4c5a-899f-89d47776f7f0", "hitokoto": "遇沉沉不语之士，且莫输心；见悻悻自好之人，应须防口。", "type": "i", "from": "菜根谭·概论", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398488", "length": 26}, {"id": 5935, "uuid": "25d7a460-e82e-4529-a95b-74a7ac3114d3", "hitokoto": "浮云游子意，落日故人情。", "type": "i", "from": "送友人", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398489", "length": 12}, {"id": 5936, "uuid": "a6aef34c-5efd-4b7f-87f5-5f9a1957e397", "hitokoto": "黄鹤一去不复返，白云千载空悠悠。", "type": "i", "from": "黄鹤楼 / 登黄鹤楼", "from_who": "崔颢", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398489", "length": 16}, {"id": 5937, "uuid": "c41946ad-e105-4071-a9bd-5e4ebf6857e2", "hitokoto": "北国风光，千里冰封，万里雪飘。", "type": "i", "from": "沁园春·雪", "from_who": "毛泽东", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398489", "length": 15}, {"id": 5938, "uuid": "f81041d4-8738-4d9a-b6c6-100b76feaec4", "hitokoto": "梧桐叶上三更雨，叶叶声声是别离。", "type": "i", "from": "鹧鸪天·一点残红欲尽时", "from_who": "周紫芝", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398490", "length": 16}, {"id": 5939, "uuid": "a5bdf4a4-0767-4787-9af2-5c4b12e7dda1", "hitokoto": "思君如流水，何有穷已时。", "type": "i", "from": "室思", "from_who": "徐干", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398490", "length": 12}, {"id": 5940, "uuid": "f869bdc5-3626-41de-a826-7869bde3c3e6", "hitokoto": "居高声自远，非是藉秋风。", "type": "i", "from": "蝉", "from_who": "虞世南", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398490", "length": 12}, {"id": 5941, "uuid": "cd34fbb3-be49-4f75-afc8-ea513a59d0a1", "hitokoto": "儿童散学归来早，忙趁东风放纸鸢。", "type": "i", "from": "村居", "from_who": "高鼎", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398490", "length": 16}, {"id": 5942, "uuid": "d7e791d8-0236-4df9-98e7-a9397e4aff3a", "hitokoto": "北方有佳人，绝世而独立。", "type": "i", "from": "李延年歌", "from_who": "李延年", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398491", "length": 12}, {"id": 5943, "uuid": "a80faa05-e166-4da4-a416-979f40806f34", "hitokoto": "寒夜客来茶当酒，竹炉汤沸火初红。", "type": "i", "from": "寒夜", "from_who": "杜耒", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398491", "length": 16}, {"id": 5944, "uuid": "980f292f-1484-4a8c-aebc-db99087a3c1e", "hitokoto": "看朱成碧思纷纷，憔悴支离为忆君。", "type": "i", "from": "如意娘", "from_who": "武则天", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398491", "length": 16}, {"id": 5945, "uuid": "5a0b4140-36ca-4998-9100-7b26ab6e0988", "hitokoto": "远上寒山石径斜，白云深处有人家。", "type": "i", "from": "山行", "from_who": "杜牧", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398492", "length": 16}, {"id": 5946, "uuid": "7408b604-8bd6-4b4a-9f1b-982449ad8567", "hitokoto": "春色满园关不住，一枝红杏出墙来。", "type": "i", "from": "游园不值", "from_who": "叶绍翁", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398492", "length": 16}, {"id": 5947, "uuid": "636294ed-2fe1-4998-931d-229efd6521b3", "hitokoto": "当君怀归日，是妾断肠时。", "type": "i", "from": "春思", "from_who": "李白", "creator": "a632079", "creator_uid": 1044, "reviewer": 1044, "commit_from": "api", "created_at": "1586398492", "length": 12}, {"id": 5974, "uuid": "20713444-8a59-44b7-89e3-e8cf990a3857", "hitokoto": "千年后，锦城相吊，遇草堂翁。", "type": "i", "from": "八声甘州·读诸葛武侯传", "from_who": "王质", "creator": "郭遥", "creator_uid": 5654, "reviewer": 4756, "commit_from": "web", "created_at": "1587742863", "length": 14}, {"id": 6015, "uuid": "a743764d-a7cd-4d20-b188-470049b3b88f", "hitokoto": "路漫漫其修远兮，吾将上下而求索。", "type": "i", "from": "离骚", "from_who": "屈原", "creator": "今天不散步", "creator_uid": 5722, "reviewer": 6, "commit_from": "web", "created_at": "1588567048", "length": 16}, {"id": 6020, "uuid": "c22767e1-15c1-44c6-b6c6-562057634699", "hitokoto": "仁不行商、义不守财；情不立威，善不居官；慈不掌兵，柔不监国。", "type": "i", "from": "增广贤文", "from_who": null, "creator": "青面灵圣", "creator_uid": 5873, "reviewer": 1044, "commit_from": "web", "created_at": "1586776967", "length": 30}, {"id": 6024, "uuid": "a2ffe24c-a615-4222-a065-0ea1c3e8c645", "hitokoto": "星垂平野阔，月涌大江流。", "type": "i", "from": "旅夜书怀", "from_who": "杜甫", "creator": "一剑还", "creator_uid": 6207, "reviewer": 4756, "commit_from": "web", "created_at": "1589357291", "length": 12}, {"id": 6025, "uuid": "8866ff3c-ecc9-4d1b-8cf4-dd0b742bcacf", "hitokoto": "离离原上草，一岁一枯荣。", "type": "i", "from": "草", "from_who": "白居易", "creator": "本事", "creator_uid": 6206, "reviewer": 4756, "commit_from": "web", "created_at": "1589357161", "length": 12}, {"id": 6026, "uuid": "db09d1e8-f2ce-4b4e-af26-4259cdb8a60f", "hitokoto": "故人西辞黄鹤楼，烟花三月下扬州。", "type": "i", "from": "黄鹤楼送孟浩然之广陵", "from_who": "李白", "creator": "本事", "creator_uid": 6206, "reviewer": 4756, "commit_from": "web", "created_at": "1589357238", "length": 16}, {"id": 6027, "uuid": "a258b954-64c1-42d1-99b9-81ec90c66157", "hitokoto": "相思似海深，旧事如天远。", "type": "i", "from": "卜算子·答施", "from_who": "乐婉", "creator": "qwqbear", "creator_uid": 3516, "reviewer": 1044, "commit_from": "web", "created_at": "1590306925", "length": 12}, {"id": 6056, "uuid": "99fc42fe-f409-4cd2-a9c7-70c35948c5c4", "hitokoto": "勤學如奮起之苗，不見其增，日有所長；輟學如磨刀之石，不見其損，日有所虧。", "type": "i", "from": "陶淵明", "from_who": null, "creator": "hasty", "creator_uid": 4575, "reviewer": 1044, "commit_from": "web", "created_at": "1587650136", "length": 36}, {"id": 6059, "uuid": "aa6bf2cd-ca9b-4e8f-a482-c2496bab26c9", "hitokoto": "行到水穷处，坐看云起时。", "type": "i", "from": "终南别业", "from_who": "王维", "creator": "voyager", "creator_uid": 6023, "reviewer": 1044, "commit_from": "web", "created_at": "1587707837", "length": 12}, {"id": 6060, "uuid": "cb6ec72f-38dd-462e-932e-4649635905ac", "hitokoto": "无奈被些名利缚，无奈被些情担阁，可惜风流总闲却。", "type": "i", "from": "千秋岁引·秋景", "from_who": "王安石", "creator": "临川入梦", "creator_uid": 6030, "reviewer": 1044, "commit_from": "web", "created_at": "1587730306", "length": 24}, {"id": 6092, "uuid": "97309419-808c-4a8e-a937-d8503f109fc7", "hitokoto": "生当复来归，死当长相思。", "type": "i", "from": "留别妻", "from_who": "苏武", "creator": "qwqbear", "creator_uid": 3516, "reviewer": 1044, "commit_from": "web", "created_at": "1590307036", "length": 12}, {"id": 6093, "uuid": "bb678c6d-69b0-489e-8a04-b7c4c1aec745", "hitokoto": "愿我如星君如月，夜夜流光相皎洁。", "type": "i", "from": "车遥遥篇", "from_who": "范成大", "creator": "qwqbear", "creator_uid": 3516, "reviewer": 1044, "commit_from": "web", "created_at": "1590306845", "length": 16}, {"id": 6094, "uuid": "984b3637-f5b9-48c3-b032-5e116f8f5861", "hitokoto": "山有木兮木有枝，心悦君兮君不知。", "type": "i", "from": "越人歌", "from_who": null, "creator": "qwqbear", "creator_uid": 3516, "reviewer": 1044, "commit_from": "web", "created_at": "1590306742", "length": 16}, {"id": 6099, "uuid": "4464317a-705e-4959-aea5-e5fc991a07d2", "hitokoto": "回首向来萧瑟处，归去， 也无风雨也无晴。", "type": "i", "from": "定风波", "from_who": "苏轼", "creator": "Vaine0", "creator_uid": 6260, "reviewer": 1044, "commit_from": "web", "created_at": "1590134642", "length": 20}, {"id": 6163, "uuid": "bfa03b47-582b-4c9c-8de2-573e625ed9b9", "hitokoto": "未觉池塘春草梦，阶前梧叶已秋声。", "type": "i", "from": "偶成", "from_who": "朱熹", "creator": "怀表小兔", "creator_uid": 6212, "reviewer": 1044, "commit_from": "web", "created_at": "1589519762", "length": 16}, {"id": 6183, "uuid": "16e37d09-6ccf-4ee8-b1ee-f5d3bd553500", "hitokoto": "急雨收残暑，梧桐一叶惊。", "type": "i", "from": "西游记", "from_who": "吴承恩", "creator": "郭遥", "creator_uid": 5654, "reviewer": 1044, "commit_from": "web", "created_at": "1590373870", "length": 12}, {"id": 6193, "uuid": "91e63058-6289-44db-b3fe-f8ddb551f5da", "hitokoto": "兼山艮，君子以思不出其位。", "type": "i", "from": "论语·宪问", "from_who": null, "creator": "Pusu", "creator_uid": 6298, "reviewer": 1044, "commit_from": "web", "created_at": "1590482291", "length": 13}, {"id": 6284, "uuid": "da2678d5-05bb-413c-85e8-bcfd54b9189a", "hitokoto": "多谢梅花，伴我微吟。", "type": "i", "from": "高阳台·除夜", "from_who": "韩疁", "creator": "周楼沉", "creator_uid": 6650, "reviewer": 4756, "commit_from": "web", "created_at": "1594100844", "length": 10}, {"id": 6331, "uuid": "b425a826-51d4-4d99-9b7a-daf958cbc1bf", "hitokoto": "谁一旦凝视过美本身 / 就已经把自己委身给了死亡。", "type": "i", "from": "Tristan", "from_who": "普拉滕", "creator": "朏之长生者", "creator_uid": 6574, "reviewer": 1, "commit_from": "web", "created_at": "1593261103", "length": 25}, {"id": 6332, "uuid": "ba9e21d5-6da9-4722-b42e-dfa2a437c30d", "hitokoto": "什么是玫瑰？为了被斩首而生长的头颅。", "type": "i", "from": "阿多尼斯诗集", "from_who": "阿多尼斯", "creator": "朏之长生者", "creator_uid": 6574, "reviewer": 1, "commit_from": "web", "created_at": "1593261227", "length": 18}, {"id": 6333, "uuid": "b9e6af8a-af98-4cef-bbfe-931efdaa0b34", "hitokoto": "什么是尘土？从大地之肺发出的一声叹息。", "type": "i", "from": "阿多尼斯诗集", "from_who": "阿多尼斯", "creator": "朏之长生者", "creator_uid": 6574, "reviewer": 1, "commit_from": "web", "created_at": "1593261255", "length": 19}, {"id": 6334, "uuid": "847e94ba-b54a-4c65-a687-381214e50e1d", "hitokoto": "什么是焦虑？褶子和皱纹，在神经的丝绸上。", "type": "i", "from": "阿多尼斯诗集", "from_who": "阿多尼斯", "creator": "朏之长生者", "creator_uid": 6574, "reviewer": 1, "commit_from": "web", "created_at": "1593261277", "length": 20}, {"id": 6335, "uuid": "ce654df7-6462-47b4-ab63-421c6f98a72f", "hitokoto": "什么是时光？我们穿上的衣服，却再也脱不下来。", "type": "i", "from": "阿多尼斯诗集", "from_who": "阿多尼斯", "creator": "朏之长生者", "creator_uid": 6574, "reviewer": 1, "commit_from": "web", "created_at": "1593261310", "length": 22}, {"id": 6344, "uuid": "272caab9-17cd-44a5-9705-e8f0c1ba8753", "hitokoto": "欲买桂花同载酒，终不似，少年游。", "type": "i", "from": "唐多令·芦叶满汀洲", "from_who": "刘过", "creator": "jscblack", "creator_uid": 6603, "reviewer": 1, "commit_from": "web", "created_at": "1593526117", "length": 16}, {"id": 6355, "uuid": "d9fac676-df5a-4bad-afac-665aa2a82408", "hitokoto": "但行好事，莫问前程。", "type": "i", "from": "增广贤文", "from_who": "佚名", "creator": "ZigZagK", "creator_uid": 6623, "reviewer": 1, "commit_from": "web", "created_at": "1593791760", "length": 10}, {"id": 6378, "uuid": "5b85b9b2-3331-4c9f-b4dc-d3fd25c4b343", "hitokoto": "人生如逆旅，我亦是行人。", "type": "i", "from": "临江仙·送钱穆父", "from_who": "苏轼", "creator": "长亭", "creator_uid": 6758, "reviewer": 6, "commit_from": "web", "created_at": "1595319722", "length": 12}, {"id": 6394, "uuid": "85eadd99-6d8d-45c9-a5f9-043627aff376", "hitokoto": "海内存知己，天涯若比邻。", "type": "i", "from": "送杜少府之任蜀州", "from_who": "王勃", "creator": "你有多久没有看过星星", "creator_uid": 6840, "reviewer": 4756, "commit_from": "web", "created_at": "1596109154", "length": 12}, {"id": 6395, "uuid": "2ef85357-9b1a-4d11-9c78-e0e54af3d0cd", "hitokoto": "伤心桥下春波绿，曾是惊鸿照影来。", "type": "i", "from": "《沈园二首》(其一)", "from_who": "陆游", "creator": "「❦」", "creator_uid": 3191, "reviewer": 4756, "commit_from": "web", "created_at": "1596112405", "length": 16}, {"id": 6429, "uuid": "74613b4e-490c-442a-ad71-76f2ed9d4cbe", "hitokoto": "最是人间留不住，朱颜辞镜花辞树。", "type": "i", "from": "蝶恋花·阅尽天涯离别苦", "from_who": "王国维", "creator": "顾及", "creator_uid": 6897, "reviewer": 4756, "commit_from": "web", "created_at": "1596763382", "length": 16}, {"id": 6430, "uuid": "b883d487-2423-4941-b812-6b4f46e91be5", "hitokoto": "明年此日青云去，却笑人间举子忙。", "type": "i", "from": "鹧鸪天·送廓之秋试", "from_who": "辛弃疾", "creator": "顾及", "creator_uid": 6897, "reviewer": 4756, "commit_from": "web", "created_at": "1596763601", "length": 16}, {"id": 6431, "uuid": "bec2edbe-b0cb-4d35-af80-ff1171143560", "hitokoto": "沾衣欲湿杏花雨，吹面不寒杨柳风。", "type": "i", "from": "绝句·古木阴中系短篷", "from_who": "志南", "creator": "顾及", "creator_uid": 6897, "reviewer": 4756, "commit_from": "web", "created_at": "1596763758", "length": 16}, {"id": 6432, "uuid": "360300e0-3fa7-4b1e-9b8a-9ac7029764a3", "hitokoto": "君埋泉下泥销骨，我寄人间雪满头。", "type": "i", "from": "梦微之", "from_who": "白居易", "creator": "顾及", "creator_uid": 6897, "reviewer": 4756, "commit_from": "web", "created_at": "1596763830", "length": 16}, {"id": 6453, "uuid": "2249463f-359a-43ac-b018-9f0465905a72", "hitokoto": "不愿勾起相思，不敢出门看月；偏偏月进窗来，害我相思一夜。", "type": "i", "from": "也是微云", "from_who": "胡适", "creator": "alterem", "creator_uid": 4351, "reviewer": 4756, "commit_from": "web", "created_at": "1598255435", "length": 28}, {"id": 6466, "uuid": "3a7e1f68-aa0b-44c8-ac1e-047075ed4a70", "hitokoto": "不要说我们一无所有，我们要做天下的主人！", "type": "i", "from": "国际歌", "from_who": "欧仁·鲍狄埃", "creator": "Serastan", "creator_uid": 7394, "reviewer": 4756, "commit_from": "web", "created_at": "1602079367", "length": 20}, {"id": 6470, "uuid": "c3ab7e10-5de4-403e-9e55-c0b0366a1c60", "hitokoto": "如何肯到清秋日，已带斜阳又带蝉。", "type": "i", "from": "柳", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 6844, "commit_from": "web", "created_at": "1602931998", "length": 16}, {"id": 6473, "uuid": "b3c90c70-1a2a-4b7c-8b6e-cdca10b7f4f3", "hitokoto": "吾道本无我，未曾嫌世人。如今到尘世，弥觉此心真", "type": "i", "from": "寓言", "from_who": null, "creator": "李无生", "creator_uid": 7454, "reviewer": 6844, "commit_from": "web", "created_at": "1602692836", "length": 23}, {"id": 6499, "uuid": "ee0ebb2a-a5a3-4ccc-84f0-94a109066727", "hitokoto": "老夫聊发少年狂，左牵黄，右擎苍。", "type": "i", "from": "江城子·密州出猎", "from_who": "苏轼", "creator": "柒染", "creator_uid": 7324, "reviewer": 6844, "commit_from": "web", "created_at": "1601639226", "length": 16}, {"id": 6532, "uuid": "35f748a6-fe8a-4c21-bded-de50447d51cd", "hitokoto": "同是天涯沦落人，相逢何必曾相识。", "type": "i", "from": "琵琶行", "from_who": "白居易", "creator": "drinktoomuchsks", "creator_uid": 7127, "reviewer": 6844, "commit_from": "web", "created_at": "1599368996", "length": 16}, {"id": 6535, "uuid": "637c3c2c-3c06-4f62-89d9-d6e9ad06eb5b", "hitokoto": "早知如此绊人心，何如当初莫相识。", "type": "i", "from": "秋风词", "from_who": "李白", "creator": "drinktoomuchsks", "creator_uid": 7127, "reviewer": 6844, "commit_from": "web", "created_at": "1599368935", "length": 16}, {"id": 6615, "uuid": "067fd14f-defb-4637-95f1-2673c9969090", "hitokoto": "We can bring to birth a new world from the ashes of the old.", "type": "i", "from": "Solidarity Forever", "from_who": "Pete Seeger", "creator": "Forevercontinent", "creator_uid": 7134, "reviewer": 6844, "commit_from": "web", "created_at": "1603517855", "length": 60}, {"id": 6659, "uuid": "e940e95c-07cb-4358-b1d8-a9644fe74acb", "hitokoto": "磨盘战地人犹识，磷火常同日色鲜。", "type": "i", "from": "读残明漫记四首", "from_who": "刘彬", "creator": "Forevercontinent", "creator_uid": 7134, "reviewer": 1044, "commit_from": "web", "created_at": "1603727191", "length": 16}, {"id": 6681, "uuid": "02843879-ab0c-45a4-9a46-8549a5f84a08", "hitokoto": "总是以为我们会长久，可能因为我们会长久，然后这样我们就长久。", "type": "i", "from": "三行情书", "from_who": "北川理惠", "creator": "草生出来了", "creator_uid": 7674, "reviewer": 1044, "commit_from": "web", "created_at": "1604797126", "length": 30}, {"id": 6688, "uuid": "1319a697-da0e-4c02-a494-a5741e37bec7", "hitokoto": "莫等闲，白了少年头，空悲切。", "type": "i", "from": "满江红", "from_who": "岳飞", "creator": "Harry 应旻昊", "creator_uid": 7744, "reviewer": 1044, "commit_from": "web", "created_at": "1605326564", "length": 14}, {"id": 6702, "uuid": "f0913087-f879-46b5-8a4b-420beb262470", "hitokoto": "一别之后，两地相思，只道是三四月，又谁知五六年。", "type": "i", "from": "怨郎诗", "from_who": "卓文君", "creator": "小布", "creator_uid": 7688, "reviewer": 1044, "commit_from": "web", "created_at": "1604889422", "length": 24}, {"id": 6729, "uuid": "2565cf46-f467-46a2-8b58-1716d3c5d932", "hitokoto": "黑白谁能用入玄，千回生死体方圆。", "type": "i", "from": "咏棋子赠弈僧", "from_who": "张乔 (唐)", "creator": "方栩栩", "creator_uid": 7486, "reviewer": 1044, "commit_from": "web", "created_at": "1605408726", "length": 16}, {"id": 6741, "uuid": "705cf7a0-5b39-4144-a396-cae1339c2d72", "hitokoto": "春有百花秋有月，夏有凉风冬有雪。", "type": "i", "from": "颂古五十五首其一", "from_who": "释绍昙", "creator": "Soiltary、K", "creator_uid": 3915, "reviewer": 1044, "commit_from": "web", "created_at": "1605852594", "length": 16}, {"id": 6745, "uuid": "59cefaa7-9266-47b2-8da7-989baf983df3", "hitokoto": "钱塘依旧，潮生潮落。", "type": "i", "from": "传言玉女·钱塘元夕", "from_who": "汪元量", "creator": "ACwisher", "creator_uid": 7830, "reviewer": 1044, "commit_from": "web", "created_at": "1606108279", "length": 10}, {"id": 6746, "uuid": "95bad63d-b49d-4325-98dd-7b26babd93f6", "hitokoto": "山川同一色，浩若涉大荒。", "type": "i", "from": "牛口见月", "from_who": "苏轼", "creator": "ACwisher", "creator_uid": 7830, "reviewer": 1044, "commit_from": "web", "created_at": "1606108329", "length": 12}, {"id": 6749, "uuid": "ac0c83d2-1d4c-4e53-b432-85e4d42320d3", "hitokoto": "灯把黑夜，烫了一个洞。", "type": "i", "from": "灯", "from_who": "姜二嫚 | 七岁", "creator": "TuTu", "creator_uid": 7853, "reviewer": 1044, "commit_from": "web", "created_at": "1606292544", "length": 11}, {"id": 6750, "uuid": "8c17bb6f-e87b-4381-ab1b-c75143d1dc45", "hitokoto": "花，不知道自己就是春天。", "type": "i", "from": "春天", "from_who": "谢武彰", "creator": "TuTu", "creator_uid": 7853, "reviewer": 1044, "commit_from": "web", "created_at": "1606292747", "length": 12}, {"id": 6767, "uuid": "80d3bb1f-3c35-4261-8ae6-56a5bfcdb940", "hitokoto": "听风雪喧嚷，看流星在飞翔； 我的心向我呼唤：去动荡的远方……", "type": "i", "from": "歌唱动荡的青春", "from_who": "亚历山德拉·尼·巴赫慕托娃", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606403131", "length": 30}, {"id": 6775, "uuid": "e63b7906-ef02-41f6-9260-0863e6d6ba80", "hitokoto": "今日欢呼孙大圣，只缘妖雾又重来。", "type": "i", "from": "七律·和郭沫若同志", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405036", "length": 16}, {"id": 6776, "uuid": "151d01a7-e120-4e83-b919-65f5e9a905c4", "hitokoto": "自信人生二百年，会当水击三千里。", "type": "i", "from": "残句", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405120", "length": 16}, {"id": 6777, "uuid": "8313e5d9-248a-421a-9e35-78ed7f8defce", "hitokoto": "鹰击长空，鱼翔浅底，万类霜天竞自由。怅寥廓，问苍茫大地，谁主沉浮？", "type": "i", "from": "沁园春·长沙", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405154", "length": 33}, {"id": 6778, "uuid": "04178872-4dfa-4fc1-adfa-1badba76c499", "hitokoto": "曾记否，到中流击水，浪遏飞舟？", "type": "i", "from": "沁园春·长沙", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405176", "length": 15}, {"id": 6779, "uuid": "077a7e4f-7c39-4e42-af62-15ef0576ebf2", "hitokoto": "雄关漫道真如铁，而今迈步从头越。", "type": "i", "from": "忆秦娥·娄山关", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405203", "length": 16}, {"id": 6780, "uuid": "c6cd8819-7204-4fe2-8ea7-0ae7912c7325", "hitokoto": "江山如此多娇，引无数英雄竞折腰。", "type": "i", "from": "沁园春·雪", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405237", "length": 16}, {"id": 6781, "uuid": "100c28f4-2124-4686-9e1f-8e1698195a8a", "hitokoto": "俱往矣，数风流人物，还看今朝。", "type": "i", "from": "沁园春·雪", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405250", "length": 15}, {"id": 6782, "uuid": "e528c5fa-3e85-4312-9a50-77fc6c18dd7d", "hitokoto": "天若有情天亦老，人间正道是沧桑。", "type": "i", "from": "七律·人民解放军占领南京", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405271", "length": 16}, {"id": 6783, "uuid": "96e1719b-6002-4f46-a070-10b15fa7a2de", "hitokoto": "寂寞嫦娥舒广袖，万里长空且为忠魂舞。", "type": "i", "from": "蝶恋花·答李淑一", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405304", "length": 18}, {"id": 6784, "uuid": "cc443853-5281-41f7-a4d6-a116ec115149", "hitokoto": "为有牺牲多壮志，敢教日月换新天。", "type": "i", "from": "七律·到韶山", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405321", "length": 16}, {"id": 6785, "uuid": "dfae0eaf-4e96-43d1-998f-9ebccada279e", "hitokoto": "当年忠贞为国酬，何曾怕断头？如今天下红遍，江山靠谁守？业未竟，身躯倦，鬓已秋；你我之辈，忍将夙愿，付与东流？", "type": "i", "from": "诉衷情·赠周总理", "from_who": "毛泽东", "creator": "SomeyaMako", "creator_uid": 7867, "reviewer": 1044, "commit_from": "web", "created_at": "1606405389", "length": 54}]