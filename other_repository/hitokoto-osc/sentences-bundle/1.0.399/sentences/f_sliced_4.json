[{"id": 6273, "uuid": "21491bfc-0d62-4c29-9193-95ab8ec4b9c4", "hitokoto": "如果能摸摸我的头的话，我会很高兴的！", "type": "f", "from": "网络", "from_who": null, "creator": "无脑僵", "creator_uid": 6154, "reviewer": 1044, "commit_from": "web", "created_at": "1592095570", "length": 18}, {"id": 6294, "uuid": "eb1d6279-b5b6-4a29-9c21-8e861886c676", "hitokoto": "世界原本就不是属于你，因此你用不着抛弃，要抛弃的是一切的执著。万物皆为我所用，但非我所属。", "type": "f", "from": "网络", "from_who": null, "creator": "北笙", "creator_uid": 6495, "reviewer": 1044, "commit_from": "web", "created_at": "1592528673", "length": 45}, {"id": 6295, "uuid": "d8c4c35e-5259-4f9d-ad57-36855a8c8b47", "hitokoto": "有些人，你以为可以见面的。有些事，你以为可以一直继续的。然后，也许在你转身的那个刹那。有些人，你就再也见不到了。当太阳落下，又升起来的时候，一切都变了，一不小心就在也回不去了。", "type": "f", "from": "网络", "from_who": null, "creator": "北笙", "creator_uid": 6495, "reviewer": 1044, "commit_from": "web", "created_at": "1592529196", "length": 88}, {"id": 6296, "uuid": "71f6afe9-a87b-4ed6-a58a-c6f1a73bcfa6", "hitokoto": "那你知道洛杉矶凌晨4点的样子吗？满天星星，寥落的灯光，行人很少。", "type": "f", "from": "科比", "from_who": null, "creator": "北笙", "creator_uid": 6495, "reviewer": 1044, "commit_from": "web", "created_at": "1592529551", "length": 32}, {"id": 6313, "uuid": "536f6228-8cac-4cb9-92b6-fe2bb9cc123b", "hitokoto": "你大概不知道，我曾那么努力的想在你的世界里存在的久一点，再久一点。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "仅此而已", "creator_uid": 6533, "reviewer": 1, "commit_from": "web", "created_at": "1592969698", "length": 33}, {"id": 6340, "uuid": "95671922-65a0-4c88-bf5d-18d739ebbe33", "hitokoto": "可能，你会为自己剥开一个很酸的橘子而后悔莫及，心中无数次升起丢掉它的念头。可，对橘子来说，你就是它的全世界，你即是它的一切……", "type": "f", "from": "来自网络", "from_who": null, "creator": "HuiGuo", "creator_uid": 6591, "reviewer": 1, "commit_from": "web", "created_at": "1593435292", "length": 63}, {"id": 6356, "uuid": "545197b1-06da-4ef5-9efe-d430f0debae6", "hitokoto": "行走于苍穹之上，将星空献给你。", "type": "f", "from": "scp-cn-027", "from_who": "囚星蝶", "creator": "「❦」", "creator_uid": 3191, "reviewer": 1, "commit_from": "web", "created_at": "1593860852", "length": 15}, {"id": 6357, "uuid": "53fa91b2-46e6-48b8-8044-3d86f806df99", "hitokoto": "不恋尘世浮华，不写红尘纷扰，不叹世道苍凉，不惹情思哀怨；闲看花开，静待花落，冷暖自知，干净如始。", "type": "f", "from": "网络", "from_who": null, "creator": "阁主博客", "creator_uid": 2831, "reviewer": 1, "commit_from": "web", "created_at": "1593865427", "length": 48}, {"id": 6358, "uuid": "c57ae5c8-b1ca-4025-af73-0e884ee1660e", "hitokoto": "一举一动，都是承诺，会被另一个人看在眼里，记在心上的。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "阁主博客", "creator_uid": 2831, "reviewer": 1, "commit_from": "web", "created_at": "1593875861", "length": 27}, {"id": 6368, "uuid": "90948bf0-03cd-4c09-a8cd-4fc6d9b8d9c1", "hitokoto": "远方未必远，未来一定来。", "type": "f", "from": "网络", "from_who": null, "creator": "像风", "creator_uid": 6731, "reviewer": 1, "commit_from": "web", "created_at": "1594981252", "length": 12}, {"id": 6369, "uuid": "c92e2e2c-393f-4fad-b318-f4ae1e59faee", "hitokoto": "世界美好与莫环环相扣。", "type": "f", "from": "网络", "from_who": null, "creator": "提莫", "creator_uid": 6194, "reviewer": 1, "commit_from": "web", "created_at": "1594971124", "length": 11}, {"id": 6374, "uuid": "ffda9c51-3d72-48ee-8173-712fd6247d15", "hitokoto": "见到你那一刻我心里有场海啸，可我静静站着，没有让任何人知道。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "Rocco", "creator_uid": 6694, "reviewer": 1, "commit_from": "web", "created_at": "1594609988", "length": 30}, {"id": 6383, "uuid": "2dcab3b6-3e87-452a-bbed-ab1dd8b04b52", "hitokoto": "你没有舍不得，我也不好意思难过。", "type": "f", "from": "网络", "from_who": null, "creator": "Ada", "creator_uid": 6698, "reviewer": 6, "commit_from": "web", "created_at": "1595148435", "length": 16}, {"id": 6412, "uuid": "648b1517-749b-4045-b4e3-561f472ca2ea", "hitokoto": "我喜欢草莓，草莓蛋糕不行，草莓软糖不行，只有草莓才行。就像我喜欢你，长得像你不行，性格像你不行，只有你才行。", "type": "f", "from": "网络", "from_who": null, "creator": "麻吉酷博异", "creator_uid": 6796, "reviewer": 1, "commit_from": "web", "created_at": "1595666281", "length": 54}, {"id": 6421, "uuid": "d0513cdc-f304-4c36-bede-5f5a6b479692", "hitokoto": "有些父母宁愿相信不真实的营销号，也不愿意相信自己的孩子。", "type": "f", "from": "Bilibili", "from_who": "滑稽的游侠", "creator": "wujiuqier", "creator_uid": 6858, "reviewer": 1, "commit_from": "web", "created_at": "1596266893", "length": 28}, {"id": 6422, "uuid": "bb74eb6c-884f-45f8-be0c-cddc37d02f20", "hitokoto": "若他仍在世，现在可能会尝试做不同的音乐，发掘新人，不过我们个性一样，会去挑战自己。", "type": "f", "from": "网络", "from_who": "张惠妹", "creator": "PaulWong", "creator_uid": 6535, "reviewer": 1, "commit_from": "web", "created_at": "1596122132", "length": 41}, {"id": 6447, "uuid": "c25e9abf-07ff-4f63-b6eb-7e76c2c6b930", "hitokoto": "要把所有的夜归还给星河，把所有的春光归还给疏疏篱落，把所有的慵慵沉迷与不前，归还给过去的我。明日之我，胸中有丘壑，立马振山河。", "type": "f", "from": "德卡先生的信箱", "from_who": null, "creator": "顾及", "creator_uid": 6897, "reviewer": 1044, "commit_from": "web", "created_at": "1596905736", "length": 63}, {"id": 6464, "uuid": "c7a160e5-9ec5-479b-9657-d0c735cb4348", "hitokoto": "听都没听说过的事，假装听懂、明白是一件很失礼的事情。", "type": "f", "from": "令人心动的offer", "from_who": "金律", "creator": "小何花", "creator_uid": 7319, "reviewer": 4756, "commit_from": "web", "created_at": "1601626551", "length": 26}, {"id": 6465, "uuid": "4941af7f-a4f4-485b-aac3-602e9b5dedb0", "hitokoto": "世上本没有什么岁月静好，只是有人为你负重前行。", "type": "f", "from": "网络", "from_who": "网友", "creator": "柒染", "creator_uid": 7324, "reviewer": 4756, "commit_from": "web", "created_at": "1601639420", "length": 23}, {"id": 6512, "uuid": "8d68d01f-8ca6-4ade-b1f2-8caafa08390a", "hitokoto": "这个社会歧视女性，也歧视男性。本质上来说，这个世界歧视弱者。", "type": "f", "from": "硬核的半佛仙人", "from_who": "硬核的半佛仙人", "creator": "Hytf233", "creator_uid": 7017, "reviewer": 6844, "commit_from": "web", "created_at": "1598057124", "length": 30}, {"id": 6539, "uuid": "ecd33522-b001-44a2-97c2-8d010d47c79a", "hitokoto": "一见如故，生万千欢喜心。", "type": "f", "from": "网络", "from_who": "网络", "creator": "见你时澜青，不见时生春", "creator_uid": 7133, "reviewer": 6844, "commit_from": "web", "created_at": "1599382672", "length": 12}, {"id": 6549, "uuid": "3cdf95f2-7911-41e4-b9a6-e6b667ca62ca", "hitokoto": "逆着光行走，任风吹雨打。", "type": "f", "from": "起风了", "from_who": "买辣椒也用券", "creator": "lteyox", "creator_uid": 7087, "reviewer": 6844, "commit_from": "web", "created_at": "1598698466", "length": 12}, {"id": 6602, "uuid": "968efb3a-3f96-45c3-b57e-a93d89fd9d59", "hitokoto": "其实结束并不是真正的结束，而是美好的开始。", "type": "f", "from": "bilibili", "from_who": "1sdaxf", "creator": "1sdaxf", "creator_uid": 7504, "reviewer": 6844, "commit_from": "web", "created_at": "1603369466", "length": 21}, {"id": 6603, "uuid": "b8bbc457-d6f3-4fed-be62-09bb81cbaa8b", "hitokoto": "不是天才，就要慎独。", "type": "f", "from": "网络", "from_who": "皎月半洒花", "creator": "s1c", "creator_uid": 7386, "reviewer": 4756, "commit_from": "web", "created_at": "1603328317", "length": 10}, {"id": 6703, "uuid": "f6c80eb2-f6e7-438d-8752-f6a94db8d2f5", "hitokoto": "不求闻达，但求心安。", "type": "f", "from": "网络", "from_who": "增增", "creator": "拉巴", "creator_uid": 7689, "reviewer": 1044, "commit_from": "web", "created_at": "1604894784", "length": 10}, {"id": 6707, "uuid": "2488e60c-8216-44d9-a465-abf198665bf4", "hitokoto": "长大了，就要自己做决定，哪怕是艰难的决定。", "type": "f", "from": "bilibili", "from_who": "老番茄", "creator": "Eason.J", "creator_uid": 7702, "reviewer": 1044, "commit_from": "web", "created_at": "1605008905", "length": 21}, {"id": 6724, "uuid": "c06bec38-878f-4c5e-9e1d-2838e96c7a02", "hitokoto": "卫星轨道千万条，心心相印才永久。", "type": "f", "from": "网络", "from_who": null, "creator": "Gilleece", "creator_uid": 7474, "reviewer": 1044, "commit_from": "web", "created_at": "1605362897", "length": 16}, {"id": 6850, "uuid": "48be1605-7ccd-4e1e-802b-7d3c017312f2", "hitokoto": "我们最终都要远行，最终都要跟稚嫩的自己告别。", "type": "f", "from": "佚名", "from_who": null, "creator": "Yousazoe", "creator_uid": 7945, "reviewer": 1044, "commit_from": "web", "created_at": "1607219984", "length": 22}, {"id": 6878, "uuid": "58794c18-fe72-45dc-9758-8c6c65ffc5cb", "hitokoto": "泡夜店，纹身，打洞，买醉……这些事看似很酷，其实这些事一点难度都没有，只要你愿意去做就能做到。更酷的事情应该是那些不容易做到的事，比如看书，健身，赚钱，用心爱一个人，这种在常人看来无趣且难以坚持的事情。", "type": "f", "from": "网络", "from_who": null, "creator": "Yousazoe", "creator_uid": 7945, "reviewer": 1044, "commit_from": "web", "created_at": "1607266681", "length": 101}, {"id": 6889, "uuid": "7780b261-2d65-4f04-b377-9bd927de737f", "hitokoto": "我这个人虐点特别奇怪：不怕死不怕残，但我怕看见诚实的人被迫说谎；正直的人被迫弯腰；痴情的人变得薄情冷漠；直言者被迫噤声；理想主义者亲眼见到理想破碎。谎话连篇者最后的一句真话；奴颜婢膝者最后挺直了腰杆；缄口自保者突然仗义执言；曾遭理想背叛的人最后选择为理想而死。", "type": "f", "from": "网络", "from_who": null, "creator": "Yousazoe", "creator_uid": 7945, "reviewer": 1044, "commit_from": "web", "created_at": "1607266888", "length": 130}, {"id": 6891, "uuid": "a605995c-f797-41e1-a018-c0018bf648b8", "hitokoto": "无人与我立黄昏，无人问我粥可温。 无人与我捻熄灯，无人共我书半生。 无人陪我夜已深，无人与我把酒分。 无人拭我相思痕，无人梦我与前尘。 无人陪我顾星辰，无人醒我茶已冷。 无人听我述衷诚，无人解我心头梦。 无人伴我聆此声，无人愁我独行程。 回首向来萧瑟处，无人等在灯火阑珊处。", "type": "f", "from": "网络", "from_who": null, "creator": "Yousazoe", "creator_uid": 7945, "reviewer": 1044, "commit_from": "web", "created_at": "1607266912", "length": 137}, {"id": 6892, "uuid": "c98ba94f-324d-4819-88f7-7233ac1c5e65", "hitokoto": "我所有的自负皆来自我的自卑，所有的英雄气概都来自于我的软弱。嘴里振振有词是因为心里满是怀疑，深情是因为痛恨自己无情。这世界没有一件事情是虚空而生的，站在光里，背后就会有阴影，这深夜里一片寂静，是因为你还没有听见声音。", "type": "f", "from": "网络", "from_who": null, "creator": "Yousazoe", "creator_uid": 7945, "reviewer": 1044, "commit_from": "web", "created_at": "1607266959", "length": 108}, {"id": 6896, "uuid": "61e5bc93-375d-43e6-b21d-85fdb38cb219", "hitokoto": "一个人在沙漠的机场，等一艘开往亚特兰蒂斯的船。", "type": "f", "from": "佚名", "from_who": null, "creator": "Taylor", "creator_uid": 7972, "reviewer": 1044, "commit_from": "web", "created_at": "1607561778", "length": 23}, {"id": 6897, "uuid": "1dab73c8-0aa1-412a-8a97-6322e3e88635", "hitokoto": "“不去努力然后告诉自己我根本就不想要”的痛苦，比“拼命努力后失败”的痛苦，要小得多。", "type": "f", "from": "未知", "from_who": "匿名", "creator": "Taylor", "creator_uid": 7972, "reviewer": 1044, "commit_from": "web", "created_at": "1607564925", "length": 42}, {"id": 6905, "uuid": "410177d0-e4da-4753-8dea-c9336b69fb78", "hitokoto": "你可不是什么普通女孩，你是我的女孩。", "type": "f", "from": "贴吧", "from_who": null, "creator": "lzh", "creator_uid": 8015, "reviewer": 1044, "commit_from": "web", "created_at": "1608009973", "length": 18}, {"id": 6908, "uuid": "3b043fb9-11d1-4cb2-8356-0c7f66aa6458", "hitokoto": "我生来就是高山而非溪流，我欲于群峰之巅俯视平庸的沟壑。我本来就是人杰而非草芥，我站在伟人之间藐视卑微的懦夫。", "type": "f", "from": "云南华坪坝女高校训", "from_who": "张桂梅", "creator": "起名废", "creator_uid": 7979, "reviewer": 1044, "commit_from": "web", "created_at": "1608363601", "length": 54}, {"id": 6915, "uuid": "86f3c9f4-f6f1-4054-988f-f14bdfcd9f7c", "hitokoto": "不要眼睛一红，就觉得人间不值得了，散伙乃是人间常态，你我哪能例外。", "type": "f", "from": "网络", "from_who": null, "creator": "eaea", "creator_uid": 304, "reviewer": 1044, "commit_from": "web", "created_at": "1608438837", "length": 33}, {"id": 6944, "uuid": "fb8d7e63-8bd3-4a67-8f5d-fa5c59945a5a", "hitokoto": "从来就没有什么失败的人，只有半途而废的人。", "type": "f", "from": "锤子科技发布会", "from_who": "罗永浩", "creator": "菊花丶一紧", "creator_uid": 8280, "reviewer": 1044, "commit_from": "web", "created_at": "1611112001", "length": 21}, {"id": 6946, "uuid": "03c9c019-c546-448a-8921-e18dbf8c930f", "hitokoto": "爵士乐响起之时便是吉翁覆灭之日！", "type": "f", "from": "机动战士高达雷霆宙域", "from_who": null, "creator": "smallxu", "creator_uid": 2639, "reviewer": 1044, "commit_from": "web", "created_at": "1611229400", "length": 16}, {"id": 6967, "uuid": "8cf943da-62ed-4b2f-8da5-eb9a0ac92fac", "hitokoto": "明知道这颗种子不会发芽，却依然每天盼望它能长大。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "青医.", "creator_uid": 8323, "reviewer": 1044, "commit_from": "web", "created_at": "1611562228", "length": 24}, {"id": 6977, "uuid": "807d8467-8d59-4ac0-aac6-46caef96251e", "hitokoto": "我劝这两个年轻人耗子尾汁，好好反思，以后不要再犯这样的聪明，小聪明啊！", "type": "f", "from": "马老师视频", "from_who": "马保国", "creator": "ChRshichi", "creator_uid": 8336, "reviewer": 1044, "commit_from": "web", "created_at": "1611710227", "length": 35}, {"id": 6983, "uuid": "eb65cb76-b24c-4373-a366-2f4112a28318", "hitokoto": "予力众生，成就不凡。", "type": "f", "from": "Microsoft", "from_who": null, "creator": "MinatoXeon", "creator_uid": 8352, "reviewer": 1044, "commit_from": "web", "created_at": "1611757666", "length": 10}, {"id": 7064, "uuid": "862ae932-ee96-4920-b66c-cf4e42be3040", "hitokoto": "生命的遗产是对知识的更新。", "type": "f", "from": "B站 知乎 用户YJango", "from_who": "YJango", "creator": "saicem", "creator_uid": 8559, "reviewer": 4756, "commit_from": "web", "created_at": "1613889298", "length": 13}, {"id": 7075, "uuid": "a3045c3a-ac0a-4598-8e79-8403ec3a9727", "hitokoto": "我已经很乖了，自己把全部的委屈和心酸都宣泄在黑夜里。", "type": "f", "from": "网易云", "from_who": "网络作者", "creator": "eqvpkbz", "creator_uid": 5492, "reviewer": 4756, "commit_from": "web", "created_at": "1614068423", "length": 26}, {"id": 7102, "uuid": "47bab181-2d70-46df-ab37-cc0c83a7b070", "hitokoto": "I'm still asking you to believe - not in my ability to bring about change, but in yours. I believe in change because I believe in you.", "type": "f", "from": "Twitter", "from_who": "美国第44任总统 Barack Hussein Obama", "creator": "roco", "creator_uid": 8685, "reviewer": 4756, "commit_from": "web", "created_at": "1616333212", "length": 134}, {"id": 7136, "uuid": "35f1a684-f3f4-4db2-859b-ade91fa74559", "hitokoto": "莫要在诗中迷茫。又何必孤自彷徨。你为黑夜点亮一盏灯，黑夜会为你绽放漫天星光。", "type": "f", "from": "回声", "from_who": "刘渤源", "creator": "负雨", "creator_uid": 6885, "reviewer": 1, "commit_from": "web", "created_at": "1614147485", "length": 38}, {"id": 7137, "uuid": "1f0e847c-d986-4a7f-8633-0a04c6fba970", "hitokoto": "赏一朵野花，何必嗅到沁人的花香。扔一块石子，又何必知晓大海的深邃。", "type": "f", "from": "回声", "from_who": "刘渤源", "creator": "负雨", "creator_uid": 6885, "reviewer": 1, "commit_from": "web", "created_at": "1614147650", "length": 33}, {"id": 7138, "uuid": "fe98706f-dd3a-4dc6-b748-9b8cd5b0404c", "hitokoto": "快步行过的小路旁，青草开得正旺。莫要只是追逐梦想，而错过温情，与花香。", "type": "f", "from": "轻驻", "from_who": "刘渤源", "creator": "负雨", "creator_uid": 6885, "reviewer": 1, "commit_from": "web", "created_at": "1614147701", "length": 35}, {"id": 7156, "uuid": "d37887fb-4820-4f4e-9984-1cb08cd82c05", "hitokoto": "往事真的不堪回首吗？", "type": "f", "from": "Ajiang's Blog", "from_who": "Ajiang", "creator": "Ajiang", "creator_uid": 7057, "reviewer": 1, "commit_from": "web", "created_at": "1614410005", "length": 10}, {"id": 7167, "uuid": "4f57c3f0-c12b-4257-bf7a-ba8503b34b01", "hitokoto": "你得到什么东西，必然就会失去什么东西。如果你觉得你什么都没有失去，那可能仅仅是你觉得。", "type": "f", "from": "studyMachine", "from_who": "studyMachine", "creator": "macstu", "creator_uid": 8660, "reviewer": 1, "commit_from": "web", "created_at": "1614917570", "length": 43}, {"id": 7182, "uuid": "2175e308-f4f3-4040-b56f-eca179f4d77d", "hitokoto": "原是今生今世已惘然，山河岁月空惆怅，而我，终将是要等着你的。", "type": "f", "from": "网络", "from_who": "胡兰成", "creator": "yudong_820", "creator_uid": 8663, "reviewer": 1, "commit_from": "web", "created_at": "1615030940", "length": 30}, {"id": 7218, "uuid": "1ba47b8a-3286-420d-a0a7-e03a683838f7", "hitokoto": "乐观主义和悲观主义对世界都有贡献，前者发明了飞机，后者发明了降落伞。", "type": "f", "from": "未知", "from_who": "未知", "creator": "leeao82", "creator_uid": 8713, "reviewer": 1, "commit_from": "web", "created_at": "1617084937", "length": 34}, {"id": 7330, "uuid": "bda58fe9-16b6-4898-b61c-51317cd65117", "hitokoto": "人总要抱紧什么才知道自己真的存在，哪怕那只是幻影。", "type": "f", "from": "网络", "from_who": "不知", "creator": "凉墨", "creator_uid": 9409, "reviewer": 4756, "commit_from": "web", "created_at": "1622269040", "length": 25}, {"id": 7334, "uuid": "03372c85-7222-4f01-a211-2d74a0744ffb", "hitokoto": "我命由我不由天，吴钩弯，展锋寒。", "type": "f", "from": "原创", "from_who": "一高三学子", "creator": "relativity", "creator_uid": 9353, "reviewer": 4756, "commit_from": "web", "created_at": "1621738612", "length": 16}, {"id": 7335, "uuid": "550ec167-51a5-4205-87dd-f7a910d4f9cc", "hitokoto": "当我们熟悉的一个个名字相继离开时，我们便知道，时代的接力棒就要到我们手上了。", "type": "f", "from": "b站评论", "from_who": null, "creator": "relativity", "creator_uid": 9353, "reviewer": 4756, "commit_from": "web", "created_at": "1621738901", "length": 38}, {"id": 7338, "uuid": "75a45fd4-4f2f-45eb-80cb-6f0a7bcdfaf2", "hitokoto": "用代码表达言语的魅力，用代码书写山河的壮丽。", "type": "f", "from": "一言开发者中心", "from_who": "一言", "creator": "DreamOne", "creator_uid": 9209, "reviewer": 4756, "commit_from": "web", "created_at": "1621833280", "length": 22}, {"id": 7341, "uuid": "93829d19-f6b3-4ecd-a223-90702eeeec5c", "hitokoto": "人生有那么一首诗，往往是当你拥有它的时候，你没有读懂它。而当你读懂它时，它已经离你远去了，而这首诗就叫青春。", "type": "f", "from": "网络", "from_who": null, "creator": "凉墨", "creator_uid": 9409, "reviewer": 4756, "commit_from": "web", "created_at": "1622268971", "length": 54}, {"id": 7363, "uuid": "0fd57b5c-cce4-41ed-94e4-b6a76bf0e5d5", "hitokoto": "记忆是掌心的水，不论你摊开还是握紧，终究还是会从指缝中一滴一滴流淌干净。只是，那水的凉意，却是可以让人始终无法忘记！", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 4756, "commit_from": "web", "created_at": "1625303483", "length": 58}, {"id": 7364, "uuid": "efedcfa7-8fad-4fc2-ae88-f15ba32a9526", "hitokoto": "这雨生于天，死于地，中间的过程就是人生。", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 4756, "commit_from": "web", "created_at": "1625303511", "length": 20}, {"id": 7365, "uuid": "afe8e8c0-547c-4b46-851d-b6b156c2f4d6", "hitokoto": "爱情就像一条河，左岸是明灭千年的欢笑，右岸是烛光下永恒的沉默，中间流淌的，是年年岁岁淡淡的寂寞。", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 4756, "commit_from": "web", "created_at": "1625303565", "length": 48}, {"id": 7366, "uuid": "8b9e4609-b377-4789-8ac9-847b5b8e13be", "hitokoto": "人亡则死，心亡则忘。", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 4756, "commit_from": "web", "created_at": "1625303606", "length": 10}, {"id": 7370, "uuid": "9b1da76b-c8d7-4d79-be68-7da3d7206b77", "hitokoto": "你曾打马过银河，倒影一百光年长。", "type": "f", "from": "微博", "from_who": "李倦容", "creator": "姜堰", "creator_uid": 9562, "reviewer": 9975, "commit_from": "web", "created_at": "1624425510", "length": 16}, {"id": 7373, "uuid": "c436b0ce-7d8a-4f71-8db8-5e9532d89b12", "hitokoto": "贫瘠的土地上,长不出和平的大树;连天的烽火中,结不出发展的硕果。", "type": "f", "from": "亚洲相互协作与信任措施会议第四次峰会", "from_who": "习近平", "creator": "席霖", "creator_uid": 9559, "reviewer": 9975, "commit_from": "web", "created_at": "1624463819", "length": 32}, {"id": 7374, "uuid": "0f212f09-9345-4b02-a7e9-7cc22c1684ae", "hitokoto": "总是在失去后，才会想再拥有，总是在离别中，才想在回头。", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 9975, "commit_from": "web", "created_at": "1625304172", "length": 27}, {"id": 7399, "uuid": "12086471-46b0-420d-9ae4-4fff1b835ec0", "hitokoto": "少几分执着，多一些洒脱。", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625306194", "length": 12}, {"id": 7400, "uuid": "16c44d67-0350-4994-a57b-4151d31fff1c", "hitokoto": "我眼中的世界，你们看不到。", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625305917", "length": 13}, {"id": 7401, "uuid": "6dccdbb2-1e95-44b0-984b-2f5601e19aea", "hitokoto": "无次数的沉沦就是为了苏醒。", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625305961", "length": 13}, {"id": 7402, "uuid": "7aa18f23-15c5-4bef-98b5-22cac575625f", "hitokoto": "花草落地生根，它有选择么？", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625305904", "length": 13}, {"id": 7403, "uuid": "f42a1c7d-f934-4415-a62a-0dff4e87049b", "hitokoto": "一切真实与虚假，一切辉煌与破灭，只存后人之言，只存岁月之中。", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625306029", "length": 30}, {"id": 7405, "uuid": "c6e27dd7-5d5d-48ce-ba8d-a4a28c678830", "hitokoto": "一如软件深似海，头发从此是路人！", "type": "f", "from": "码农", "from_who": "来自网络", "creator": "dgm", "creator_uid": 9605, "reviewer": 1, "commit_from": "web", "created_at": "1625120462", "length": 16}, {"id": 7406, "uuid": "3fea6809-516d-497f-9221-1b7d61f29e27", "hitokoto": "我左手是修魔海短暂的因果，右手里百年一个漫长的孤陌。", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625303694", "length": 26}, {"id": 7407, "uuid": "1eaa75cc-18d5-432c-add3-09f0eb34d238", "hitokoto": "无法避过轮回，而岁月亦没有等我，你，何时来带我。", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625303782", "length": 24}, {"id": 7408, "uuid": "71f0481f-f6eb-41e5-975c-d0c82fb3ec1e", "hitokoto": "闻道者，朝生夕死，足尔；寻道者，忘生之死，憾尔。", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625303817", "length": 24}, {"id": 7409, "uuid": "ad1c0589-f957-48ee-a765-3f034eb1d91d", "hitokoto": "生为人杰，死亦鬼雄，我辈修士，何惜一战！", "type": "f", "from": "仙逆", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625303840", "length": 20}, {"id": 7410, "uuid": "ea27ce3d-cfe6-47f9-9e3d-96b939400a92", "hitokoto": "此生的约定，白头亦不负。", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625305847", "length": 12}, {"id": 7411, "uuid": "fbbdb9fb-b99b-4a3f-be95-9db4ce7be9d6", "hitokoto": "那些曾经相识依稀还在，却在风云变幻年轮中，如尘埃落江，寻已无痕。", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625305718", "length": 32}, {"id": 7412, "uuid": "a1197e25-3193-4e77-b15c-3f0df601bebb", "hitokoto": "如果这天地间的世人皆醉，而你独醒，则等于是世人皆醒你独眠。", "type": "f", "from": "求魔", "from_who": "耳根", "creator": "余空", "creator_uid": 9621, "reviewer": 1, "commit_from": "web", "created_at": "1625305693", "length": 29}, {"id": 7414, "uuid": "b5bef0ec-2be8-47b2-aee9-f6368d3f3ab9", "hitokoto": "满堂花醉三千客，一剑霜寒十四州。", "type": "f", "from": "我只想安兴休仙", "from_who": "奥藤蔓", "creator": "富婆挚友", "creator_uid": 9677, "reviewer": 4756, "commit_from": "web", "created_at": "1625827679", "length": 16}, {"id": 7423, "uuid": "fd8b0081-62d8-4ac5-82d8-044c773d8a13", "hitokoto": "背影要显得很高大，才够真实的自己躲在自己的阴影下。", "type": "f", "from": "弱智吧", "from_who": "名字平均值就好", "creator": "azmatter", "creator_uid": 8944, "reviewer": 1044, "commit_from": "web", "created_at": "1617817139", "length": 25}, {"id": 7459, "uuid": "d05cf3ac-b10a-4dc6-b1c2-6555d14f82a7", "hitokoto": "我们执着于寻找对方缺少的品质，真是太傻了。", "type": "f", "from": "面纱", "from_who": null, "creator": "LINGCX", "creator_uid": 9883, "reviewer": 4756, "commit_from": "web", "created_at": "1627226871", "length": 21}, {"id": 7466, "uuid": "ee292874-0df7-4e1e-8d30-9e86b105a5d8", "hitokoto": "恋爱是为了开心，选择不爱也是。", "type": "f", "from": "《佚名者录》", "from_who": "佚名", "creator": "鹤空流乂", "creator_uid": 9962, "reviewer": 4756, "commit_from": "web", "created_at": "1627911855", "length": 15}, {"id": 7489, "uuid": "1046112d-8b76-40d3-8634-df76dce8f290", "hitokoto": "少年与爱永不老去，即便披荆斩棘，丢失怒马鲜衣。", "type": "f", "from": "莫峻", "from_who": null, "creator": "Morning Dew", "creator_uid": 9775, "reviewer": 4756, "commit_from": "web", "created_at": "1629181491", "length": 23}, {"id": 7500, "uuid": "37ef0e57-2dab-4f3f-be86-910d0d772668", "hitokoto": "我们总喜欢拿顺其自然来敷衍人生路上的荆棘坎坷，却很少承认，真正的顺其自然是竭尽所能之后的不强求，而非两手一摊的不作为。", "type": "f", "from": "恋练有词", "from_who": "朱伟", "creator": "kiko", "creator_uid": 10187, "reviewer": 4756, "commit_from": "web", "created_at": "1629675651", "length": 59}, {"id": 7503, "uuid": "ca9040c4-aa16-4ed7-90fb-614a7e5f9c14", "hitokoto": "没有任何力量能毁了下一代，除了不懂时代的上一代。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "小行星坠落", "creator_uid": 10228, "reviewer": 4756, "commit_from": "web", "created_at": "1630034795", "length": 24}, {"id": 7519, "uuid": "c0b57851-40c9-46e9-a0c7-36ef47dc2106", "hitokoto": "现实与理想相差了十万八千里,我马不停蹄,却也鞭长莫及。", "type": "f", "from": "听《稻香》时的一些感慨", "from_who": null, "creator": "六出花", "creator_uid": 10539, "reviewer": 4756, "commit_from": "web", "created_at": "1633419898", "length": 27}, {"id": 7544, "uuid": "22eb31a7-4dfb-41db-8186-b570ed1b42f6", "hitokoto": "Discover, Create and Use.", "type": "f", "from": "网络", "from_who": "佚名", "creator": "DreamOne", "creator_uid": 9209, "reviewer": 1, "commit_from": "web", "created_at": "1630142217", "length": 25}, {"id": 7551, "uuid": "d93c8636-8cbc-43d1-92a4-dfcaf91c1647", "hitokoto": "合群是平凡的开始，独行是拔尖的开端。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "a632079", "creator_uid": 1044, "reviewer": 1, "commit_from": "web", "created_at": "1620470133", "length": 18}, {"id": 7603, "uuid": "8d7fa99e-90a6-4da4-9799-0cf70bd3c1a9", "hitokoto": "你可以不学习，但你的竞争对手不会！", "type": "f", "from": "网络", "from_who": "网络", "creator": "DreamOne", "creator_uid": 9209, "reviewer": 1, "commit_from": "api", "created_at": "1621572772", "length": 17}, {"id": 7605, "uuid": "c026bb02-6802-46c0-bd06-1989648f46de", "hitokoto": "我们的过去都有一个挚爱，在没遇到真爱时，我们一直专一的自以为是。", "type": "f", "from": "网络", "from_who": null, "creator": "沫夏孤水", "creator_uid": 10089, "reviewer": 1, "commit_from": "app", "created_at": "1637769752", "length": 32}, {"id": 7606, "uuid": "51a8055e-df64-47f9-bf78-d1775a566374", "hitokoto": "幸福，就是找一个温暖的人过一辈子，然后一辈子都是温暖的。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "沫夏孤水", "creator_uid": 10089, "reviewer": 1, "commit_from": "app", "created_at": "1637769727", "length": 28}, {"id": 7624, "uuid": "7e8e484f-2ede-41c2-8f3c-ad5d45a3b19f", "hitokoto": "The quieter you become, the more you are able to hear.", "type": "f", "from": "Kali Linux", "from_who": "Offensive Security Ltd.", "creator": "Dawn_Xu", "creator_uid": 10742, "reviewer": 4756, "commit_from": "web", "created_at": "1636292117", "length": 54}, {"id": 7635, "uuid": "b777aa0f-3ac7-438f-86c7-787cc31acaaa", "hitokoto": "就此拂衣去，水覆旧荣径。", "type": "f", "from": "柒年志", "from_who": "槲安", "creator": "kinuko", "creator_uid": 9148, "reviewer": 1, "commit_from": "web", "created_at": "1619791944", "length": 12}, {"id": 7639, "uuid": "a6a1cd5d-3edb-44f8-a839-c351d94826ae", "hitokoto": "我开始阅读，因为生活否定了我，而阅读却好心的肯定了我的爱好和我的个性。", "type": "f", "from": "网络摘抄", "from_who": "佚名", "creator": "hongze_", "creator_uid": 9048, "reviewer": 1, "commit_from": "web", "created_at": "1619867070", "length": 35}, {"id": 7715, "uuid": "fad07ca8-9f58-4ca8-b063-eb475e05c746", "hitokoto": "人只能赚自己认知范围内的钱，也只能拥有自己认知范围内的生活。", "type": "f", "from": "网络", "from_who": "初初", "creator": "chuchu-z", "creator_uid": 9201, "reviewer": 1044, "commit_from": "web", "created_at": "1620989957", "length": 30}, {"id": 7735, "uuid": "339fd812-ea41-4db6-b842-33bc24a066c5", "hitokoto": "嘴里塞满无知的梦想，醉了就吐一地闪光。", "type": "f", "from": "诗歌维基", "from_who": "快乐放屁小狗", "creator": "快乐放屁小狗", "creator_uid": 10998, "reviewer": 4756, "commit_from": "web", "created_at": "1642561126", "length": 19}, {"id": 7736, "uuid": "a2c80496-68e9-4709-b27c-05cd40902cd0", "hitokoto": "聪明是一种天赋，而善良是一种选择。", "type": "f", "from": "网络", "from_who": "佚名", "creator": "沫夏孤水", "creator_uid": 10089, "reviewer": 1, "commit_from": "app", "created_at": "1637769362", "length": 17}, {"id": 7754, "uuid": "3b05c4f3-a7fe-427d-b89b-6ae5934b7c5f", "hitokoto": "我当然不会试图摘月，我要月亮奔我而来。", "type": "f", "from": "黛丽·赫本", "from_who": "黛丽·赫本", "creator": "异想之旅", "creator_uid": 11403, "reviewer": 4756, "commit_from": "web", "created_at": "1643792662", "length": 19}, {"id": 7769, "uuid": "ea9b7dab-031e-48c9-80d9-0a00f30b607e", "hitokoto": "成功への道はとげに満ちており、ハードワークは成功につながります.", "type": "f", "from": "yuanziyu", "from_who": "yuanziyu", "creator": "yuanziyu", "creator_uid": 11315, "reviewer": 4756, "commit_from": "web", "created_at": "1644302092", "length": 32}, {"id": 7779, "uuid": "8a44065f-26c4-424e-9fbb-f6ed7db3f3df", "hitokoto": "挑战自我，不进则退。", "type": "f", "from": "Dzxium-DZX组", "from_who": "Redmountain", "creator": "张一", "creator_uid": 5013, "reviewer": 4756, "commit_from": "web", "created_at": "1645877330", "length": 10}, {"id": 7781, "uuid": "8cb3c637-9a21-40d2-87c6-2d89391e216c", "hitokoto": "你们都说我是弱智，其实只有我遵守了当年一起不长大的约定。", "type": "f", "from": "微博", "from_who": "排山烈打", "creator": "茶褐", "creator_uid": 11611, "reviewer": 4756, "commit_from": "web", "created_at": "1646030261", "length": 28}]