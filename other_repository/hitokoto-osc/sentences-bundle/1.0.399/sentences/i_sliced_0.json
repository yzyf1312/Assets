[{"id": 1082, "uuid": "ab89b12e-359b-4cfe-b50d-de35a20bf928", "verse": "众里寻他千百度，蓦然回首，那人却在，灯火阑珊处。", "from": "青玉案·元夕", "length": 24}, {"id": 1263, "uuid": "a58936ac-f3fb-4e5d-838e-a77a7219d1a4", "verse": "渔舟唱晚，响穷彭蠡之滨；雁阵惊寒，声断衡阳之浦。", "from": "滕王阁序", "length": 24}, {"id": 4205, "uuid": "20deb116-4bed-48f4-9092-124ba6b83cd2", "verse": "参差荇菜，左右采之。窈窕淑女，琴瑟友之。", "from": "关雎", "length": 20}, {"id": 4686, "uuid": "990f0608-c757-4ebb-b508-f9f99c4fa5ec", "verse": "两种风流，一家制作。雪花全似梅花萼。细看不是雪无香，天风吹得香零落。虽是一般，惟高一着。雪花不似梅花薄。梅花散彩向空山，雪花随意穿帘幕。", "from": "踏莎行·雪中看梅花", "length": 68}, {"id": 4688, "uuid": "7e0a0206-ec71-4832-b805-9aa2a2cf8b10", "verse": "两情若是久长时，又岂在朝朝暮暮？", "from": "鹊桥仙·纤云弄巧", "length": 16}, {"id": 4689, "uuid": "739ed604-6182-4c36-afb9-39f08128c733", "verse": "嗟叹红颜泪、英雄殁，人世苦多。山河永寂、怎堪欢颜。", "from": "南唐旧梦：山河永寂", "length": 25}, {"id": 4690, "uuid": "a53cb819-77fe-4346-a188-59f9c0684eb9", "verse": "茅檐低小，溪上青青草。醉里吴音相媚好，白发谁家翁媪？", "from": "清平乐·村居", "length": 26}, {"id": 4699, "uuid": "9650304e-e843-49e2-a50f-f4b669f15857", "verse": "瞿塘嘈嘈十二滩，此中道路古来难。长恨人心不如水，等闲平地起波澜。\r\n", "from": "竹枝其七", "length": 34}, {"id": 4895, "uuid": "f60e114e-03dd-4c29-8e37-55a2d516d2f3", "verse": "醉后不知天在水，满船清梦压星河。", "from": "题龙阳县青草湖", "length": 16}, {"id": 4896, "uuid": "2095b5d9-30d6-4cbd-8390-47cbf678ca98", "verse": "金风玉露一相逢，便胜却、人间无数。", "from": "鹊桥仙·纤云弄巧", "length": 17}, {"id": 4908, "uuid": "ee9365a6-5617-414b-8f20-c6fab21ab555", "verse": "人生得意须尽欢，莫让金樽空对月。", "from": "将进酒", "length": 16}, {"id": 4909, "uuid": "3886b445-1877-4faf-8834-bb4907b3964a", "verse": "莫听穿林打叶声，何妨吟啸且徐行。竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。", "from": "定风波·莫听穿林打叶声", "length": 35}, {"id": 4912, "uuid": "f45778c6-ce7c-488c-8fa4-f03aeb0f7ee3", "verse": "我曾踏月而来，只因你在山中。", "from": "山月", "length": 14}, {"id": 4913, "uuid": "0c571b7f-3d56-4384-8e9d-99f77eec4162", "verse": "上古有大椿者，以八千岁为春，八千岁为秋。", "from": "逍遥游", "length": 20}, {"id": 4916, "uuid": "c2234304-ef66-4c04-b971-fae53ac9340d", "verse": "直道相思了无益，未妨惆怅是清狂。", "from": "无题", "length": 16}, {"id": 4917, "uuid": "d35e8a70-ac62-48dd-8918-6d1191e1480a", "verse": "南风知我意，吹梦到西洲。", "from": "西洲曲", "length": 12}, {"id": 4922, "uuid": "7a58eb6d-1352-4f88-b7ba-5899db4563ef", "verse": "报君黄金台上意，提携玉龙为君死。", "from": "雁门太守行", "length": 16}, {"id": 4923, "uuid": "8e15eb2b-131b-4fb4-bbee-2ad69ee20ac5", "verse": "雁字回时，月满西楼，花自飘零水自流。一种相思，两处闲愁。此情无计可消除，才下眉头，却上心头。", "from": "一剪梅·红藕香残玉簟秋", "length": 46}, {"id": 4959, "uuid": "c9726d2f-204f-440d-98f9-53fad30e61fc", "verse": "东隅已逝，桑榆非晚。", "from": "文学", "length": 10}, {"id": 4960, "uuid": "583d8364-01b4-4c75-b052-37c42b61810a", "verse": "三尺书生，一介微命。", "from": "滕王阁序", "length": 10}, {"id": 4982, "uuid": "b790ca90-56e8-471e-b040-cb48c6043fc6", "verse": "醉后不知天在水，满船清梦压星河。", "from": "题龙阳县青草湖", "length": 16}, {"id": 4986, "uuid": "52af4233-c5f4-4648-b709-cdb9b958da4e", "verse": "风花之潇洒，雪月之空清，唯静者为之主；水木之荣枯，竹石之消长，独闲者操其权。", "from": "菜根谭", "length": 38}, {"id": 5098, "uuid": "f8914378-5ac7-4d01-8b73-fa2aa6773430", "verse": "糜鹿成群，虎豹避之；飞鸟成列，鹰鹫不击。", "from": "说苑", "length": 20}, {"id": 5112, "uuid": "d39dbbff-947b-4051-9a0c-44cd6ad3da26", "verse": "醉后不知天在水，满船清梦压星河。", "from": "题龙阳县青草湖", "length": 16}, {"id": 5117, "uuid": "c9739bcc-2d6e-482b-bc6e-ac158e2524b1", "verse": "为众人抱薪者，不可使其冻毙于风雪。", "from": "微博", "length": 17}, {"id": 5119, "uuid": "0e4eb08f-7f86-4155-b2ae-84dca1d1b73b", "verse": "桃李春风一杯酒，江湖夜雨十年灯。", "from": "寄黄几复", "length": 16}, {"id": 5123, "uuid": "9e11dd9d-dd1b-4b97-bffe-05e7255632aa", "verse": "且将新火试新茶，诗酒趁年华", "from": "望江南·超然台作", "length": 13}, {"id": 5137, "uuid": "9ae0a8af-b362-4812-80d6-33fbbee3e70b", "verse": "髣髴兮若轻云之蔽月，飘飖兮若流风之回雪。", "from": "洛神赋", "length": 20}, {"id": 5138, "uuid": "01f5282e-72c3-4eda-8a35-b7055958715c", "verse": "恨人神之道殊兮，怨盛年之莫当。", "from": "洛神赋", "length": 15}, {"id": 5191, "uuid": "628a8db2-fa7b-4684-831e-f24ac06903f0", "verse": "高山仰止，景行行止。", "from": "诗经", "length": 10}, {"id": 5206, "uuid": "af700d9a-7740-4afb-bdf0-4ec1681b9b1f", "verse": "忽来夜雨未绸缪，挑灯孤影欲还休。", "from": "原创", "length": 16}, {"id": 5232, "uuid": "2c29a409-865e-4a07-bff2-92e6496bb3ef", "verse": "但屈指西风几时来，又不道流年暗中偷换。", "from": "洞仙歌·冰肌玉骨", "length": 19}, {"id": 5241, "uuid": "4c0517d8-0b30-4e31-a4a9-e6ede666eb82", "verse": "抛得开手里玩具，先懂得好好进睡。", "from": "给自己的情书", "length": 16}, {"id": 5356, "uuid": "f4f448b2-d3d0-4186-950d-52fa8800808a", "verse": "海内存知己，天涯若比邻。", "from": "杜少府之任蜀州", "length": 12}, {"id": 5370, "uuid": "1a2f4f01-28a4-4f93-84fa-789049c9759d", "verse": "锦官红妆否？不见故人裙。", "from": "无题", "length": 12}, {"id": 5389, "uuid": "479e82b1-311c-43d3-bf4f-3cb23b69b39a", "verse": "人皆荒醉，但唱观音。", "from": "唐大和上东征传", "length": 10}, {"id": 5396, "uuid": "d721f9bb-2232-4a0b-8398-40619bd20b68", "verse": "今夜不知何处宿，平沙万里绝人烟。", "from": "碛中作", "length": 16}, {"id": 5406, "uuid": "40514bed-709d-4a9f-910a-ea5b1dad80e8", "verse": "人生若只如初见，何事秋风悲画扇。", "from": "木兰花·拟古决绝词柬友", "length": 16}, {"id": 5441, "uuid": "b8633c21-7d09-449a-a277-ea47e63a7a4f", "verse": "山有木兮木有枝，心悦君兮君不知。", "from": "越人歌", "length": 16}, {"id": 5442, "uuid": "2acf4ba0-f6b0-4e52-8d8b-9ae7cc3c858f", "verse": "人生若只如初见，何事秋风悲画扇。", "from": "木兰词·拟古决绝词柬友", "length": 16}, {"id": 5443, "uuid": "d200b686-d03c-4118-9c45-41efcfac57c9", "verse": "曾经沧海难为水，除却巫山不是云。", "from": "离思五首·其四", "length": 16}, {"id": 5444, "uuid": "cf8f4485-5123-4344-b20d-ecc9537c2e16", "verse": "人生如逆旅，我亦是行人。", "from": "临江仙·送钱穆父", "length": 12}, {"id": 5445, "uuid": "8cd5bf9e-cb4d-4083-96aa-b284878011f2", "verse": "十年生死两茫茫，不思量，自难忘。", "from": "江城子·乙卯正月二十日夜记梦", "length": 16}, {"id": 5446, "uuid": "7d413a88-9555-4c3c-bf3f-fbacff7116e5", "verse": "玲珑骰子安红豆，入骨相思知不知。", "from": "南歌子词二首 / 新添声杨柳枝词", "length": 16}, {"id": 5447, "uuid": "8453df5d-6e08-4ba8-a139-1bc324d44a7c", "verse": "只愿君心似我心，定不负相思意。", "from": "卜算子·我住长江头", "length": 15}, {"id": 5448, "uuid": "d09096b2-1a6d-4721-abeb-13b4018cee70", "verse": "入我相思门，知我相思苦。", "from": "三五七言 / 秋风词", "length": 12}, {"id": 5449, "uuid": "379c8520-6fce-4158-931e-3e90241e0e2e", "verse": "雨打梨花深闭门，误了青春，忘了青春。", "from": "一剪梅·雨打梨花深闭门", "length": 18}, {"id": 5450, "uuid": "78bc8aa9-b81b-4f78-a074-3cfe74cf5983", "verse": "平生不会相思，才会相思，便害相思。", "from": "折桂令·春情", "length": 17}, {"id": 5451, "uuid": "9508291d-a9e7-4b76-b225-5e62a82f6acf", "verse": "山无陵，江水为竭。冬雷震震，夏雨雪。天地合，乃敢与君绝。", "from": "上邪", "length": 28}, {"id": 5452, "uuid": "c453b2dc-8200-4d66-a405-d23dc7451826", "verse": "两情若是久长时，又岂在朝朝暮暮。", "from": "鹊桥仙·纤云弄巧", "length": 16}, {"id": 5453, "uuid": "1d300772-4c0e-4ec8-a347-2fac0583071e", "verse": "愿得一心人，白头不相离。", "from": "白头吟", "length": 12}, {"id": 5454, "uuid": "ea85fc45-3883-42d5-ab6a-b232f83b241a", "verse": "去年今日此门中，人面桃花相映红。", "from": "题都城南庄", "length": 16}, {"id": 5455, "uuid": "643355d9-03fc-4bc2-b1e5-604fcb8e832f", "verse": "春宵一刻值千金，花有清香月有阴。", "from": "春宵·春宵一刻值千金", "length": 16}, {"id": 5456, "uuid": "e5910444-76d4-4401-8013-8bdfab428954", "verse": "醉后不知天在水，满船清梦压星河。", "from": "题龙阳县青草湖", "length": 16}, {"id": 5457, "uuid": "1df218b3-1d4b-4eb7-a336-b79aa335ea25", "verse": "春风得意马蹄疾，一日看尽长安花。", "from": "登科后", "length": 16}, {"id": 5460, "uuid": "59c9a592-9385-458c-8c76-cf6db1635ea3", "verse": "人生自是有情痴，此恨不关风与月。", "from": "玉楼春·尊前拟把归期说", "length": 16}, {"id": 5461, "uuid": "8f1b99a6-ed53-4553-aaca-c9e359a7b93a", "verse": "花自飘零水自流。一种相思，两处闲愁。", "from": "一剪梅·红藕香残玉簟秋", "length": 18}, {"id": 5462, "uuid": "2408c153-ac1e-4146-b68a-8111ab89975a", "verse": "少年不识愁滋味，爱上层楼。爱上层楼，为赋新词强说愁。", "from": "丑奴儿·书博山道中壁", "length": 26}, {"id": 5463, "uuid": "4c0984e1-1b5c-4bc6-926c-de4da020512e", "verse": "一日不见兮，思之如狂。", "from": "凤求凰 / 琴歌", "length": 11}, {"id": 5464, "uuid": "2ecb0fa8-d92d-466f-9331-6668dfd924ee", "verse": "身无彩凤双飞翼，心有灵犀一点通。", "from": "无题·昨夜星辰昨夜风", "length": 16}, {"id": 5465, "uuid": "fe37ea2d-2cb9-4b6c-b1e6-3ec944799a7a", "verse": "世间无限丹青手，一片伤心画不成。", "from": "金陵晚望", "length": 16}, {"id": 5466, "uuid": "c416789d-2ddc-44d4-822d-934e64fc1561", "verse": "云想衣裳花想容，春风拂槛露华浓。", "from": "清平调·其一", "length": 16}, {"id": 5467, "uuid": "4192a533-a3cc-4a70-af9b-acceaa34c6f3", "verse": "问世间，情为何物，直教生死相许？", "from": "摸鱼儿·雁丘词 / 迈陂塘", "length": 16}, {"id": 5468, "uuid": "b26851c2-9f38-452b-bfad-5f2a1f06b212", "verse": "一声梧叶一声秋，一点芭蕉一点愁，三更归梦三更后。", "from": "水仙子·夜雨", "length": 24}, {"id": 5469, "uuid": "f89fcf54-197f-4c77-9abb-5985d433746b", "verse": "滚滚长江东逝水，浪花淘尽英雄。", "from": "临江仙·滚滚长江东逝水", "length": 15}, {"id": 5470, "uuid": "6442d6b4-0e24-483b-ac3f-6dd82ea4b707", "verse": "林花谢了春红，太匆匆。无奈朝来寒雨，晚来风。", "from": "相见欢·林花谢了春红", "length": 22}, {"id": 5471, "uuid": "1182b6d9-ea87-4957-a820-d25520be8107", "verse": "君埋泉下泥销骨，我寄人间雪满头。", "from": "梦微之", "length": 16}, {"id": 5472, "uuid": "ba76ae0f-599b-48b1-8990-8a18a400206d", "verse": "休对故人思故国，且将新火试新茶。诗酒趁年华。", "from": "望江南·超然台作", "length": 22}, {"id": 5473, "uuid": "1e743799-cd11-49b6-8412-d76813d05efe", "verse": "一往情深深几许？深山夕照深秋雨。", "from": "蝶恋花·出塞", "length": 16}, {"id": 5474, "uuid": "e8d4b74c-e6fd-49dd-ac5f-c109e6c04929", "verse": "执子之手，与子偕老。", "from": "击鼓", "length": 10}, {"id": 5475, "uuid": "05013dc7-279e-430b-94db-018b1457d49b", "verse": "自在飞花轻似梦，无边丝雨细如愁。", "from": "浣溪沙·漠漠轻寒上小楼", "length": 16}, {"id": 5476, "uuid": "ae3516b7-d0d0-474a-96f9-b02a5a057c53", "verse": "菩提本无树，明镜亦非台。", "from": "菩提偈", "length": 12}, {"id": 5477, "uuid": "5c765950-832a-4de3-a6fe-c4f3459fcfa1", "verse": "一生大笑能几回，斗酒相逢须醉倒。", "from": "凉州馆中与诸判官夜集", "length": 16}, {"id": 5478, "uuid": "91b58cea-2c30-4ab3-8842-bcb9650f5871", "verse": "此情可待成追忆，只是当时已惘然。", "from": "锦瑟", "length": 16}, {"id": 5479, "uuid": "8bd297bb-caee-4f2e-84c0-a59a20d07bbb", "verse": "人面不知何处去，桃花依旧笑春风。", "from": "题都城南庄", "length": 16}, {"id": 5480, "uuid": "97dd7450-147e-4b25-97b6-2e56dc9aa321", "verse": "抽刀断水水更流，举杯消愁愁更愁。", "from": "宣州谢脁楼饯别校书叔云 / 陪侍御叔华登楼歌", "length": 16}, {"id": 5481, "uuid": "689d42cb-466e-4d5c-9288-24435040c646", "verse": "昨夜西风凋碧树，独上高楼，望尽天涯路。", "from": "蝶恋花·槛菊愁烟兰泣露", "length": 19}, {"id": 5482, "uuid": "421766d9-31a0-46c6-a049-55b9069bb55e", "verse": "疏影横斜水清浅，暗香浮动月黄昏。", "from": "山园小梅·其一", "length": 16}, {"id": 5483, "uuid": "85d5a346-c31f-421e-a618-e537c22b6683", "verse": "仰天大笑出门去，我辈岂是蓬蒿人。", "from": "南陵别儿童入京", "length": 16}, {"id": 5484, "uuid": "4216eade-9414-4b1c-8867-a16e24e8dd96", "verse": "思悠悠，恨悠悠，恨到归时方始休。", "from": "长相思·汴水流", "length": 16}, {"id": 5485, "uuid": "dcf708cf-8679-4d11-b4ed-371004d2f94e", "verse": "似此星辰非昨夜，为谁风露立中宵。", "from": "绮怀", "length": 16}, {"id": 5486, "uuid": "94314e49-cff2-49b2-98bb-cee3fdff0063", "verse": "行到水穷处，坐看云起时。", "from": "终南别业 / 初至山中 / 入山寄城中故人", "length": 12}, {"id": 5487, "uuid": "b2f4952e-e451-4360-8f2d-255e67405d14", "verse": "近水楼台先得月，向阳花木易为春。", "from": "断句", "length": 16}, {"id": 5488, "uuid": "cc0b8e6d-3650-45be-a770-a487d985597d", "verse": "浮云一别后，流水十年间。", "from": "淮上喜会梁川故人 / 淮上喜会梁州故人", "length": 12}, {"id": 5489, "uuid": "9acbecc2-7234-4d4b-9c0c-73951e33ddb9", "verse": "桃李春风一杯酒，江湖夜雨十年灯。", "from": "寄黄几复", "length": 16}, {"id": 5490, "uuid": "0bc177fb-d8d7-483d-a964-513ff38bf904", "verse": "沾衣欲湿杏花雨，吹面不寒杨柳风。", "from": "绝句", "length": 16}, {"id": 5491, "uuid": "f1ba56b0-6883-401c-8682-1068120d6182", "verse": "若是前生未有缘，待重结、来生愿。", "from": "卜算子·答施", "length": 16}, {"id": 5492, "uuid": "f2de9bde-9692-4434-a0a5-f81f78b6dfdd", "verse": "时光只解催人老，不信多情，长恨离亭，泪滴春衫酒易醒。", "from": "采桑子·时光只解催人老", "length": 26}, {"id": 5495, "uuid": "f69cfc46-84dd-4935-abe8-bc10fece3e96", "verse": "取次花丛懒回顾，半缘修道半缘君。", "from": "离思五首·其四", "length": 16}, {"id": 5496, "uuid": "4e1cce58-01a3-48bb-aee1-89e693d40498", "verse": "溪云初起日沉阁，山雨欲来风满楼。", "from": "咸阳城东楼 / 咸阳城西楼晚眺 / 西门", "length": 16}, {"id": 5497, "uuid": "165984db-9a58-4b83-8351-be2fd42e557e", "verse": "晓看天色暮看云，行也思君，坐也思君。", "from": "一剪梅·雨打梨花深闭门", "length": 18}, {"id": 5498, "uuid": "492924f9-e5d4-43da-86c7-c9233a6e72e1", "verse": "今人不见古时月，今月曾经照古人。", "from": "把酒问月·故人贾淳令予问之", "length": 16}, {"id": 5499, "uuid": "3cd5bf34-449a-48e4-bc13-572c875dd380", "verse": "夜月一帘幽梦，春风十里柔情。", "from": "八六子·倚危亭", "length": 14}, {"id": 5500, "uuid": "4bcd01c9-911a-4f39-ab3e-5b6ca455d992", "verse": "落花人独立，微雨燕双飞。", "from": "临江仙·梦后楼台高锁", "length": 12}, {"id": 5501, "uuid": "dc43136f-42da-449e-b331-f890deb13b07", "verse": "劝君莫惜金缕衣，劝君惜取少年时。", "from": "金缕衣", "length": 16}, {"id": 5502, "uuid": "2c6e6edd-8ed2-4d2a-ae7b-e96a901452de", "verse": "黄沙百战穿金甲，不破楼兰终不还。", "from": "从军行七首·其四", "length": 16}, {"id": 5503, "uuid": "bd54446e-fa7c-4aef-bf13-48393c0a24f3", "verse": "红酥手，黄縢酒，满城春色宫墙柳。", "from": "钗头凤·红酥手", "length": 16}, {"id": 5504, "uuid": "4295121b-832a-4c29-a352-6f7d90c01b58", "verse": "凤凰台上凤凰游，凤去台空江自流。", "from": "登金陵凤凰台", "length": 16}, {"id": 5505, "uuid": "1abe485c-df3f-43a2-950d-cc6b8b5f9d48", "verse": "还君明珠双泪垂，恨不相逢未嫁时。", "from": "节妇吟·寄东平李司空师道", "length": 16}, {"id": 5506, "uuid": "82677a36-563a-4641-8713-4f738b61b93a", "verse": "宁可枝头抱香死，何曾吹落北风中。", "from": "画菊", "length": 16}]