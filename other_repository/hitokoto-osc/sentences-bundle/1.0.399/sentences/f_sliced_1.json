[{"id": 933, "uuid": "9477003b-d477-402d-9b2b-8e8999724f08", "hitokoto": "人生充斥着谎言,我又岂能独善其身!", "type": "f", "from": "网络", "from_who": null, "creator": "hitokoto", "creator_uid": 1775, "reviewer": 0, "commit_from": "web", "created_at": "1478787580", "length": 17}, {"id": 937, "uuid": "8809dd45-71b7-4446-adcc-402afb9e6540", "hitokoto": "我还在原地等你 你却已经忘记来过这里", "type": "f", "from": "网络", "from_who": null, "creator": "hitokoto", "creator_uid": 1775, "reviewer": 0, "commit_from": "web", "created_at": "1478787580", "length": 18}, {"id": 940, "uuid": "7459d0c6-b0f3-404e-9eac-377f3fa09374", "hitokoto": "风筝的线你随时可以放开，只是别盼望我会回来", "type": "f", "from": "网络", "from_who": null, "creator": "hitokoto", "creator_uid": 1775, "reviewer": 0, "commit_from": "web", "created_at": "1478787580", "length": 21}, {"id": 961, "uuid": "2352d47f-e625-4d72-8aba-1e992931b2bc", "hitokoto": "别把耿直当理由。", "type": "f", "from": "网络", "from_who": null, "creator": "Eric", "creator_uid": 114, "reviewer": 0, "commit_from": "web", "created_at": "1479303233", "length": 8}, {"id": 970, "uuid": "e314bad5-7323-458a-8232-5b6d9ea60120", "hitokoto": " 像旧时候，像老朋友。", "type": "f", "from": "网络", "from_who": null, "creator": "Secret", "creator_uid": 133, "reviewer": 0, "commit_from": "web", "created_at": "1480399619", "length": 11}, {"id": 973, "uuid": "6e7fbdbc-2454-4c62-873c-868e8b7ca89d", "hitokoto": "就算路不坦荡也要做自己的太阳。", "type": "f", "from": "网络", "from_who": null, "creator": "Secret", "creator_uid": 133, "reviewer": 0, "commit_from": "web", "created_at": "1480399527", "length": 15}, {"id": 976, "uuid": "4f395b36-1c6c-4a2a-b813-3050bc80805d", "hitokoto": "如果英雄联盟有停服的那一天，我会用寒冰射手在打一局简单人机，因为从哪里开始就从哪里结束。", "type": "f", "from": "网络", "from_who": null, "creator": "隔壁小轩", "creator_uid": 138, "reviewer": 0, "commit_from": "web", "created_at": "1480818074", "length": 44}, {"id": 978, "uuid": "8e84a508-fbb0-4068-bb48-1277673c4992", "hitokoto": "如果你愿意一层一层地剥开我的心，你会发现，里面有二尖瓣、三尖瓣、隔缘肉柱、乳头肌，但就是没有你。", "type": "f", "from": "网络", "from_who": null, "creator": "2021823134", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 48}, {"id": 1022, "uuid": "23cda901-2e93-4482-a05f-66258fd7a7cb", "hitokoto": "父亲永远都是不善于表达他的爱，但他总是会默默地用行动告诉我们，他是有多么的爱我们。", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 41}, {"id": 1039, "uuid": "fd6d29a8-6f72-4004-bfc9-e990ff02c8fb", "hitokoto": "不管对什么事情都不能有先入为主的观念。", "type": "f", "from": "网络", "from_who": null, "creator": "1310517752", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 19}, {"id": 1045, "uuid": "801f2ee8-7c90-41f1-9674-44c035c4a6e3", "hitokoto": "人生最重要的是时机，时机对了，凡事都有可能。", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 22}, {"id": 1055, "uuid": "a5583b64-8b33-4571-a16b-d80510d7e859", "hitokoto": "我们是如此的担心着未来会发生的事情，因此忘记了慢下来享受现在。", "type": "f", "from": "网络", "from_who": null, "creator": "2394390781", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 31}, {"id": 1067, "uuid": "13ca5ca5-7f6b-49db-b2f3-ede98461bd12", "hitokoto": "你的名字那么普通也就我听到会心头一怔。", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 19}, {"id": 1073, "uuid": "495710f5-89c3-4494-a221-266c63b08b72", "hitokoto": "我们嘴里的别人的事听起来就像是自己的事；我们说自己的事的时候，却又在像说一段不相干的故事", "type": "f", "from": "网络", "from_who": null, "creator": "1277326952", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 44}, {"id": 1076, "uuid": "eb5fa6bd-5711-4508-9d0d-811af6027990", "hitokoto": "你什么时候放下，什么时候就没有烦恼。", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1481086547", "length": 18}, {"id": 1092, "uuid": "5cec7b54-2a5a-4099-96ae-75f8a6f84688", "hitokoto": "梦想不会逃跑，会逃跑的只有人", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1482047360", "length": 14}, {"id": 1106, "uuid": "c924895c-a505-49a7-bd22-2ac62834e889", "hitokoto": "我房间里堆满了情人节礼物， 我不是高富帅， 我只是个懒惰的快递员。", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1482047360", "length": 33}, {"id": 1109, "uuid": "dbee4a73-70bc-4984-9240-36664ea244d3", "hitokoto": "我们都是好朋友吧，所以你的东西就是我的东西，我的东西还是我的东西。", "type": "f", "from": "网络", "from_who": null, "creator": "505622287", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1482047360", "length": 33}, {"id": 1120, "uuid": "8e9cd8d5-bc73-4313-adbf-8698052e19c8", "hitokoto": "真正没有资格谈明天的人，是那个不懂得珍惜今天的人", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1482047360", "length": 24}, {"id": 1122, "uuid": "aa2f23d4-d54a-4f57-be3f-ed01c58e3811", "hitokoto": "不懂装懂，永世饭桶", "type": "f", "from": "网络", "from_who": null, "creator": "863885806", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1482047360", "length": 9}, {"id": 1123, "uuid": "68785029-aedc-4a42-acab-c079b86b56fe", "hitokoto": "每一天都是一个全新的开始", "type": "f", "from": "网络", "from_who": null, "creator": "505622287", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1482047360", "length": 12}, {"id": 1131, "uuid": "8d22fead-c4ac-411e-8b14-bb68adc84a2d", "hitokoto": "彼岸花开开彼岸,忘川河畔亦忘川。奈何桥头空奈何,三生石上写三生。", "type": "f", "from": "网络", "from_who": null, "creator": "Ming丶", "creator_uid": 64, "reviewer": 0, "commit_from": "web", "created_at": "1484628965", "length": 32}, {"id": 1138, "uuid": "ce949ec0-a2c5-4615-a728-afb27b66e1c4", "hitokoto": "输了你，赢了这个世界也没意义", "type": "f", "from": "网络", "from_who": null, "creator": "Sωeet、心境", "creator_uid": 218, "reviewer": 0, "commit_from": "web", "created_at": "1485526522", "length": 14}, {"id": 1142, "uuid": "1c1b3200-f8cb-43ca-8714-e0f9fc971830", "hitokoto": "与其诅咒黑暗，不如点亮烛光。", "type": "f", "from": "网络", "from_who": null, "creator": "tansinan_1995", "creator_uid": 212, "reviewer": 0, "commit_from": "web", "created_at": "1486654386", "length": 14}, {"id": 1146, "uuid": "52632189-2b8a-4342-8d18-01afccda4460", "hitokoto": "你所浪费的今天，是昨天死去的人奢望的明天。你所厌恶的现在，是未来的你回不去的曾经。", "type": "f", "from": "网络", "from_who": null, "creator": "shellingford", "creator_uid": 250, "reviewer": 0, "commit_from": "web", "created_at": "1488006574", "length": 41}, {"id": 1151, "uuid": "c75d955c-9a61-4075-9e92-ccf068363feb", "hitokoto": "生命在于折腾，生命不息，折腾不止", "type": "f", "from": "网络", "from_who": null, "creator": "vclike", "creator_uid": 271, "reviewer": 0, "commit_from": "web", "created_at": "1490370367", "length": 16}, {"id": 1159, "uuid": "90da2563-31fb-4b25-bef6-9fe3bd2c685f", "hitokoto": "人的欲望永无止境，就像我一开始，也只是想知道你的名字。", "type": "f", "from": "网络", "from_who": null, "creator": "酷儿", "creator_uid": 6, "reviewer": 0, "commit_from": "web", "created_at": "1491399767", "length": 27}, {"id": 1174, "uuid": "3c1c40de-63fe-4037-983e-0f7e5bb6d1c3", "hitokoto": "最终让你难以忘怀的，并不是某个谁，而是当初为之倾心，不顾一切的自己。", "type": "f", "from": "网络", "from_who": null, "creator": "1234567", "creator_uid": 319, "reviewer": 0, "commit_from": "web", "created_at": "1493013567", "length": 34}, {"id": 1177, "uuid": "82fd6373-b48c-4e32-8f26-64df84147a81", "hitokoto": "我想和你见面，地点你选。森林，沙漠，夜晚依稀的湖畔。草原，大海，清晨薄雾的借口。只是，别在梦里。", "type": "f", "from": "微博", "from_who": null, "creator": " 逍遥走走", "creator_uid": 337, "reviewer": 0, "commit_from": "web", "created_at": "1493962260", "length": 48}, {"id": 1189, "uuid": "3bf3318a-5598-430d-bb1a-297240baee82", "hitokoto": "忘羡一曲远，曲终人不散", "type": "f", "from": "网络", "from_who": null, "creator": "yc", "creator_uid": 162, "reviewer": 0, "commit_from": "web", "created_at": "1497700131", "length": 11}, {"id": 1195, "uuid": "4eebdd10-9814-4348-8745-976a8bc484be", "hitokoto": "一瓶250ml的吊水，一共是3111滴。", "type": "f", "from": "网络", "from_who": null, "creator": "酷儿", "creator_uid": 6, "reviewer": 0, "commit_from": "web", "created_at": "1498718560", "length": 20}, {"id": 1204, "uuid": "e6ffaaf3-928d-4637-825f-b9b64fc3ba88", "hitokoto": "无论撒怎样的谎，都无法欺骗自己的心。", "type": "f", "from": "网络", "from_who": null, "creator": "梦语", "creator_uid": 438, "reviewer": 0, "commit_from": "web", "created_at": "1499821080", "length": 18}, {"id": 1205, "uuid": "1fbb2890-2dc2-457a-a9cb-96882a109958", "hitokoto": "人恰得亏，戏不好看。", "type": "f", "from": "网络", "from_who": null, "creator": "梦语", "creator_uid": 438, "reviewer": 0, "commit_from": "web", "created_at": "1499570300", "length": 10}, {"id": 1236, "uuid": "de6f11a8-4581-4ed4-bf43-bee069cde340", "hitokoto": "胆小鬼连幸福都害怕，碰到棉花都会受伤", "type": "f", "from": "网络", "from_who": null, "creator": "zetar", "creator_uid": 504, "reviewer": 0, "commit_from": "web", "created_at": "1502952672", "length": 18}, {"id": 1272, "uuid": "5d0d10eb-7c7a-4638-9756-f17891b7e6a5", "hitokoto": "一懒众衫小。", "type": "f", "from": "qq空间", "from_who": null, "creator": "特卡的帅已是极限", "creator_uid": 574, "reviewer": 0, "commit_from": "web", "created_at": "1507517418", "length": 6}, {"id": 1274, "uuid": "a37352ef-4027-4344-b124-58895bdecd97", "hitokoto": "缘，妙不可言", "type": "f", "from": "阅后即瞎", "from_who": null, "creator": "無痕", "creator_uid": 607, "reviewer": 0, "commit_from": "web", "created_at": "1508767841", "length": 6}, {"id": 1304, "uuid": "a9ed50e2-a4a4-4566-b2d5-183da28972ff", "hitokoto": "今天是一起养狗，以后就一起遛狗，日久生情，狗又生狗。", "type": "f", "from": "我的少女时代", "from_who": null, "creator": "知你分子", "creator_uid": 830, "reviewer": 0, "commit_from": "web", "created_at": "1512006262", "length": 26}, {"id": 1305, "uuid": "3c1212fa-d991-4bf5-a865-ff665b49a7b7", "hitokoto": "生死去留，棚头傀儡。一线断时，落落磊磊。", "type": "f", "from": "豆瓣网友", "from_who": null, "creator": "nikazhang", "creator_uid": 886, "reviewer": 0, "commit_from": "web", "created_at": "1512535969", "length": 20}, {"id": 1307, "uuid": "449f2d26-bdec-4cd6-8572-ec3d34a79876", "hitokoto": "你还有好多未完成的梦，你有什么理由停下脚步", "type": "f", "from": "网络", "from_who": null, "creator": "Bruce jcworm", "creator_uid": 884, "reviewer": 0, "commit_from": "web", "created_at": "1512524912", "length": 21}, {"id": 1308, "uuid": "c1662da7-3766-43ab-a369-3d492d31340f", "hitokoto": "要想飞得高,就该把地平线忘掉", "type": "f", "from": "网络", "from_who": null, "creator": "Bruce jcworm", "creator_uid": 884, "reviewer": 0, "commit_from": "web", "created_at": "1512524964", "length": 14}, {"id": 1312, "uuid": "90cc7578-58d2-425b-a258-0e3bdbaf484c", "hitokoto": "时间是世上最快的一把杀人刀，无论你是万世将种，还是绝世美人，到头来都逃不过这把刀的索命。枯骨荒冢，有谁还记得你生前的模样是丑是美。", "type": "f", "from": "唐砖", "from_who": null, "creator": "宝宝洗头爱飘柔", "creator_uid": 898, "reviewer": 0, "commit_from": "web", "created_at": "1512718233", "length": 65}, {"id": 1315, "uuid": "8ac3fca5-8d66-4635-a7ab-4c4b9c82d85d", "hitokoto": "选择最难的路走暗夜里看成群的星星涌来。", "type": "f", "from": "网络", "from_who": null, "creator": "简夜", "creator_uid": 897, "reviewer": 0, "commit_from": "web", "created_at": "1512708852", "length": 19}, {"id": 1346, "uuid": "707c9b81-bf92-44fa-a62c-e071b6946f26", "hitokoto": "那些哭着喊着要走的人从来不会真的离开,真的要离开的人会挑一个风和日丽的下午,披一件大衣,不知不觉地消失", "type": "f", "from": "网络", "from_who": null, "creator": "玉狐", "creator_uid": 1000, "reviewer": 0, "commit_from": "web", "created_at": "1514528150", "length": 51}, {"id": 1350, "uuid": "ee730907-2f19-4c4f-ba8c-d124e9bca6fb", "hitokoto": "夜深忽梦少年事，唯梦闲人不梦君。", "type": "f", "from": "柒", "from_who": null, "creator": "柒丶", "creator_uid": 1015, "reviewer": 0, "commit_from": "web", "created_at": "1515556699", "length": 16}, {"id": 1351, "uuid": "9c224f35-6d70-49c7-9249-f5104b53ffad", "hitokoto": " 葡萄的卷须有一点淡淡的甜味。这东西如果腌成咸菜，大概不难吃。", "type": "f", "from": "人间草木", "from_who": null, "creator": "李国宝", "creator_uid": 1010, "reviewer": 0, "commit_from": "web", "created_at": "1514820102", "length": 31}, {"id": 1355, "uuid": "e63ac787-79e4-45ee-856d-545caca03469", "hitokoto": "春来暑往，秋去冬藏，又是很多年过去了", "type": "f", "from": "网络", "from_who": null, "creator": "Bruce jcworm", "creator_uid": 884, "reviewer": 0, "commit_from": "web", "created_at": "1514863112", "length": 18}, {"id": 1368, "uuid": "423637ba-ba39-4a19-81b4-a067e188002e", "hitokoto": "手持两把锟斤拷，口中疾呼烫烫烫。脚踏千朵屯屯屯，笑看万物锘锘锘。", "type": "f", "from": "来自网络", "from_who": null, "creator": "sora", "creator_uid": 1101, "reviewer": 0, "commit_from": "web", "created_at": "1517141327", "length": 32}, {"id": 1382, "uuid": "cd032bc0-fd45-45f3-b0c7-4eca68e2b5b4", "hitokoto": "承诺常常很像蝴蝶，美丽的盘旋后就不见了。", "type": "f", "from": "网络", "from_who": null, "creator": "斐斐", "creator_uid": 209, "reviewer": 0, "commit_from": "web", "created_at": "1519695843", "length": 20}, {"id": 1406, "uuid": "cfa45284-acb0-4c36-98b2-42d4ebbce0bf", "hitokoto": "旅行的意义在于找到自己，而非浏览他人。", "type": "f", "from": "网络", "from_who": null, "creator": "kot32", "creator_uid": 0, "reviewer": 0, "commit_from": "web", "created_at": "1457947896000", "length": 19}, {"id": 3586, "uuid": "fab8e7d3-3136-4133-ad00-4e38828b2fc6", "hitokoto": "相传胜利者肯定手持正义,那仅是因为正义可以被胜利者定义", "type": "f", "from": "天空之边", "from_who": null, "creator": "aluoblog", "creator_uid": 1251, "reviewer": 0, "commit_from": "web", "created_at": "1521355527", "length": 27}, {"id": 3593, "uuid": "76ed5fc1-a53c-45b4-a29a-62f68a90982f", "hitokoto": "所爱隔山海，山海皆可平。可是你不爱我啊，隔了座火焰山还拿不到芭蕉扇。我奋不顾身穿山越岭到了你身旁，你也只会来一句“卧槽你好666啊”", "type": "f", "from": "网易云音乐热评", "from_who": null, "creator": "风亦扬", "creator_uid": 1124, "reviewer": 0, "commit_from": "web", "created_at": "1522639196", "length": 66}, {"id": 3595, "uuid": "31b3894b-bd34-42b3-8e52-efa0ad445f96", "hitokoto": "下辈子变成你喜欢的人，然后不喜欢你！", "type": "f", "from": "网络", "from_who": null, "creator": "alone88", "creator_uid": 1373, "reviewer": 0, "commit_from": "web", "created_at": "1523257159", "length": 18}, {"id": 3607, "uuid": "f4058051-837e-499c-8153-a52c766f9a07", "hitokoto": "他能给的，你付不起！", "type": "f", "from": "终极恶女", "from_who": null, "creator": "a632079", "creator_uid": 1044, "reviewer": 0, "commit_from": "web", "created_at": "1523579633", "length": 10}, {"id": 3614, "uuid": "d8a874b9-e2f1-4013-a580-f290476093f2", "hitokoto": "自古表白多白表，从来情书难书情。笑谈年少多少年，常与生人道人生。", "type": "f", "from": "网络", "from_who": null, "creator": "Administrator", "creator_uid": 1397, "reviewer": 0, "commit_from": "web", "created_at": "1523766466", "length": 32}, {"id": 3615, "uuid": "9d15ee7c-b08b-4bb0-bdea-50642a0fb5bf", "hitokoto": "生活的洪流欲让人们窒息，我们却在缺氧的环境中肆意成长。", "type": "f", "from": "网络", "from_who": null, "creator": "Administrator", "creator_uid": 1397, "reviewer": 0, "commit_from": "web", "created_at": "1523766515", "length": 27}, {"id": 3616, "uuid": "e92b1e11-b626-4ebe-bab5-922ed9a2ef0e", "hitokoto": "有些人坐飞机就能见到，有些人坐时光机才可以。", "type": "f", "from": "网络", "from_who": null, "creator": "Administrator", "creator_uid": 1397, "reviewer": 0, "commit_from": "web", "created_at": "1523766701", "length": 22}, {"id": 3621, "uuid": "26fd1e1d-9d0d-476f-83ec-5a583ad1f671", "hitokoto": "你无法比此刻更年轻", "type": "f", "from": "一位网友", "from_who": null, "creator": "今朝有酒今朝醉", "creator_uid": 1406, "reviewer": 0, "commit_from": "web", "created_at": "1523972564", "length": 9}, {"id": 3626, "uuid": "05dd54e1-b907-42ed-ad91-5735c900855a", "hitokoto": "这不是神经病，是理想", "type": "f", "from": "大话西游之紫霞仙子", "from_who": null, "creator": "papi", "creator_uid": 7, "reviewer": 0, "commit_from": "web", "created_at": "1525252337", "length": 10}, {"id": 3631, "uuid": "8cd68879-4fcb-48d1-a76f-cca5d7c22060", "hitokoto": "永远相信美好的事情，即将发生", "type": "f", "from": "XiaoMi", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1526096034", "length": 14}, {"id": 3632, "uuid": "e26d3482-bb21-43ed-8072-3d5e5f30e11c", "hitokoto": "安静的心是最高的品质，它是没有分界的，完整的、纯洁的。他就是全神贯注、觉察力、爱和最高的智慧", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1526096203", "length": 46}, {"id": 3652, "uuid": "46b6ec55-5b03-4ce4-ade8-bc68ea21ae29", "hitokoto": "向来是据理力争，从不曾无理取闹。", "type": "f", "from": "胡向荣", "from_who": null, "creator": "RainAir", "creator_uid": 1613, "reviewer": 0, "commit_from": "web", "created_at": "1528527140", "length": 16}, {"id": 3669, "uuid": "605577db-1217-4f11-bb3c-3dc614bf7517", "hitokoto": "可这世间疾苦，照样没放过我", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530014258", "length": 13}, {"id": 3676, "uuid": "8ae82850-8fb5-4619-a12b-64d2ba1e0dec", "hitokoto": "一切不谈语境的真理都是耍流氓", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530013927", "length": 14}, {"id": 3684, "uuid": "b58f52fd-c5de-4f15-a6c6-d548b77e1d6f", "hitokoto": "我…真的…每天都在…尽最大的力气……去演一个正常人......或者说在强迫自己正常……求你放过我吧", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530014341", "length": 49}, {"id": 3687, "uuid": "4a328ee7-973e-44db-a2d9-a7a2fdd6b529", "hitokoto": "没有光明是不幸的么？不，需要光明才是真正的不幸。", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530014475", "length": 24}, {"id": 3695, "uuid": "29e28f16-f1cf-489c-9122-b9d0e2d07263", "hitokoto": "活着努力干，死了无遗憾！", "type": "f", "from": "Holio", "from_who": null, "creator": "holio", "creator_uid": 1777, "reviewer": 0, "commit_from": "web", "created_at": "1531558126", "length": 12}, {"id": 3696, "uuid": "0386002b-b155-4197-b3f0-7f6e1432f156", "hitokoto": "曾几何时，我们做了世上那最柔情的人，为一朵花低眉，为一朵云驻足，为一滴雨感动。", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1531616468", "length": 39}, {"id": 3705, "uuid": "c6e94d63-bbf8-43d1-bb35-88a2f476ef17", "hitokoto": "我有两个苹果，有个人问我要一个，我不给，于是很多人凑过来说你不是还有一个苹果吗，怎么这么小气啊。可是，苹果都是我的呀。", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530015119", "length": 59}, {"id": 3709, "uuid": "02f3602b-19a8-4dc8-8cdc-7397e148abd4", "hitokoto": "双马尾是最好的方向盘", "type": "f", "from": "来自网络", "from_who": null, "creator": "gerard", "creator_uid": 419, "reviewer": 0, "commit_from": "web", "created_at": "1532870532", "length": 10}, {"id": 3722, "uuid": "b6d140f6-82d5-4771-9a1b-13f00c003488", "hitokoto": "活的越是绝望 写的词越是温柔 这也许是世间最大的讽刺", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530015433", "length": 26}, {"id": 3724, "uuid": "d9c7a01c-5231-4df2-8de6-53c580fdaa2b", "hitokoto": "“每天都要等到困极了再睡 因为那样躺下就可以睡 就没有时间想那些不开心的事” ​", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530015544", "length": 40}, {"id": 3725, "uuid": "007d0533-2e59-488d-9f49-06c089dec71a", "hitokoto": "恐惧的话，只是因为内心不够强大", "type": "f", "from": "来自网络", "from_who": null, "creator": "妖酆", "creator_uid": 1702, "reviewer": 0, "commit_from": "web", "created_at": "1530015850", "length": 15}, {"id": 3726, "uuid": "99fced6b-65c5-4088-9859-67de2f925d58", "hitokoto": "数学和物理，就是把看不见的星星写在了纸上。", "type": "f", "from": "网络", "from_who": null, "creator": "綾音", "creator_uid": 1570, "reviewer": 0, "commit_from": "web", "created_at": "1530165874", "length": 21}, {"id": 3727, "uuid": "2ee17dd5-caa6-4c5e-969a-4c167bb640dc", "hitokoto": "时间是一支孤寂的沙漏，一点一点地漏掉我们静默的年华，剩下比年华更加静默的回忆。", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1530166304", "length": 39}, {"id": 3738, "uuid": "8c45096c-bc09-40dc-8f65-45f7950f51c8", "hitokoto": "借朋友的车开，朋友说还的时候要给车加油。还车时，我冲车鼓了鼓掌", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1532483400", "length": 31}, {"id": 3750, "uuid": "7913cdd6-ccb6-457d-85a5-804896131077", "hitokoto": "人生是场马拉松，比的不是谁目前跑的快，也不是谁先跑到终点。而是怀着希望跑完全程，快慢无所谓因为每个人都活在自己的时区。只要坚持下去，不仅可以到达目的地实现梦想，还不会因为匆忙赶路而错过沿途的风景。", "type": "f", "from": "https://www.youtube.com/watch?v=BKHdQ0daAEw  评论区", "from_who": null, "creator": "luhahaha", "creator_uid": 1783, "reviewer": 0, "commit_from": "web", "created_at": "1533776363", "length": 98}, {"id": 3753, "uuid": "f5a66296-6978-46f3-bd46-bbe9fafc5a84", "hitokoto": "大的目标，需要小的目标作铺垫，大的目标需要分割成几段一个一个去实现。", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1533108919", "length": 34}, {"id": 3758, "uuid": "e95a6b4b-3df0-4f13-87ad-1725e037e01a", "hitokoto": "人生最好的三种状态：不期而遇、不言而喻、不药而愈——乃一俗人", "type": "f", "from": "网易云音乐", "from_who": null, "creator": "fu365主页", "creator_uid": 1728, "reviewer": 0, "commit_from": "web", "created_at": "1531636007", "length": 30}, {"id": 3759, "uuid": "4485cace-54f2-4372-9593-d1d43910b970", "hitokoto": "我是哑巴，你是瞎子，我们就这样保持最纯真的友谊，最遥远的爱情。", "type": "f", "from": "来自网络", "from_who": null, "creator": "戎歌", "creator_uid": 1195, "reviewer": 0, "commit_from": "web", "created_at": "1532673494", "length": 31}, {"id": 3760, "uuid": "d75b34ae-2e4f-419e-822a-401f8c58e300", "hitokoto": "永远不要活在过去的回忆里；昨天的太阳，晒不干今天的衣裳！", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1533008697", "length": 28}, {"id": 3777, "uuid": "367c9147-c728-4f82-ab90-55a0eb1548f8", "hitokoto": "我李某相貌堂堂，妻子花容月貌，岂会生出你这种山野莽夫呢？", "type": "f", "from": "十万个冷笑话", "from_who": null, "creator": "zhouzz", "creator_uid": 1856, "reviewer": 0, "commit_from": "web", "created_at": "1533106633", "length": 28}, {"id": 3778, "uuid": "8dd357e1-8611-49b6-ad05-12dc475d4918", "hitokoto": "我的每一个动作都有你的印记", "type": "f", "from": "十万个冷笑话", "from_who": null, "creator": "zhouzz", "creator_uid": 1856, "reviewer": 0, "commit_from": "web", "created_at": "1533106648", "length": 13}, {"id": 3779, "uuid": "bcfb4a46-f831-4a4e-bd7b-d8fc4cbb1298", "hitokoto": "自古以来流传着这样一个传说 当集齐了七个福禄娃 放到炼丹炉中炼化 就能召唤出神龙，召的出才怪，你以为是龙珠啊。", "type": "f", "from": "十万个冷笑话", "from_who": null, "creator": "zhouzz", "creator_uid": 1856, "reviewer": 0, "commit_from": "web", "created_at": "1533106660", "length": 55}, {"id": 3780, "uuid": "0ff27b0a-5598-4c3b-b905-4dc5360edca4", "hitokoto": "人生在世不称意，不如自挂东南枝", "type": "f", "from": "十万个冷笑话", "from_who": null, "creator": "zhouzz", "creator_uid": 1856, "reviewer": 0, "commit_from": "web", "created_at": "1533106675", "length": 15}, {"id": 3781, "uuid": "9ea3a04d-1342-4ac3-a1cc-e280fefff574", "hitokoto": "火娃的熊熊烈焰 水娃的滔滔巨浪 当两种力量结合到一起的时候 就变成了 水蒸气", "type": "f", "from": "十万个冷笑话", "from_who": null, "creator": "zhouzz", "creator_uid": 1856, "reviewer": 0, "commit_from": "web", "created_at": "1533106686", "length": 38}, {"id": 3782, "uuid": "ab9125ec-99c8-42d5-bca0-abe5c7c2a36f", "hitokoto": "看来你是不见棺材不落泪不到黄河心不死欲穷千里目更上一层楼呢", "type": "f", "from": "十万个冷笑话", "from_who": null, "creator": "zhouzz", "creator_uid": 1856, "reviewer": 0, "commit_from": "web", "created_at": "1533106722", "length": 29}, {"id": 3803, "uuid": "7d36b519-82b2-4a4d-b7ef-c46f96e96304", "hitokoto": "impossible的完整形式是i'm possible", "type": "f", "from": "来自网络", "from_who": null, "creator": "Soulter", "creator_uid": 1912, "reviewer": 0, "commit_from": "web", "created_at": "1533994085", "length": 28}, {"id": 3812, "uuid": "1275f045-19bf-4602-9d18-ec9ef57c9945", "hitokoto": "我本将心向明月，奈何明月照沟渠。落花有意随流水，流水无心恋落花。", "type": "f", "from": "清诗纪事", "from_who": null, "creator": "etppt", "creator_uid": 1863, "reviewer": 0, "commit_from": "web", "created_at": "1533075299", "length": 32}, {"id": 3813, "uuid": "9a80cb3f-cb40-40d2-9d84-40086d7ccc75", "hitokoto": "模拟只会猜题意,贪心只能过样例。数学上来先打表,DP一般看规律。组合数学靠运气,计算几何瞎暴力。图论一顿套模板,数论只会GCD。", "type": "f", "from": "网络", "from_who": null, "creator": "abc2237512422", "creator_uid": 1873, "reviewer": 0, "commit_from": "web", "created_at": "1534578919", "length": 64}, {"id": 3829, "uuid": "62c93a12-96ab-454c-9c95-dc937fb40c31", "hitokoto": "你总是这样轻言放弃的话，无论多久都只会原地踏步", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1535071907", "length": 23}, {"id": 3830, "uuid": "941a0030-4cf3-4311-a510-3bb522a4b454", "hitokoto": "不要为小事遮住视线，我们还有更大的世界", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1535071861", "length": 19}, {"id": 3831, "uuid": "cd71a826-39a2-49e6-8dc1-3db937815db1", "hitokoto": "厚道的人 运气都不会太差", "type": "f", "from": "Xiaomi", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1535071832", "length": 12}, {"id": 3832, "uuid": "815e62cc-1072-4c3b-b3a6-b06ea25f89b2", "hitokoto": "如果爱，请深爱，如不爱，请离开", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1534994566", "length": 15}, {"id": 3868, "uuid": "b031a9d3-61a6-4635-97bd-0ca3c45f2a15", "hitokoto": "万事开头难，然后中间难，最后结尾难。", "type": "f", "from": "网络", "from_who": null, "creator": "abc2237512422", "creator_uid": 1873, "reviewer": 0, "commit_from": "web", "created_at": "1535605405", "length": 18}, {"id": 3870, "uuid": "0d309c76-9d77-4818-a3ea-b5e4f28f83d0", "hitokoto": "人红是非多，人傻当枪使。人蠢猛跟风，人笨不自知。", "type": "f", "from": "----来自网络", "from_who": null, "creator": "玉狐", "creator_uid": 1000, "reviewer": 0, "commit_from": "web", "created_at": "1536168128", "length": 24}, {"id": 3874, "uuid": "8979bf46-21b3-4bbb-93dd-9d729fd57c84", "hitokoto": "承蒙遇见，三生有幸", "type": "f", "from": "晓良", "from_who": null, "creator": "晓良", "creator_uid": 2041, "reviewer": 0, "commit_from": "web", "created_at": "1536455451", "length": 9}, {"id": 3877, "uuid": "52cdb86f-23a5-4bb2-a6ad-6439fdf6a837", "hitokoto": "没有音乐，生活是一种遗憾，没有爱心，生命是一种多余", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1536973711", "length": 25}, {"id": 3878, "uuid": "0f921ae1-6340-45d6-82b6-58b2f58e728e", "hitokoto": "以爱回应忠诚，以荣誉回应英勇，以复仇回应背叛", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1536973745", "length": 22}, {"id": 3880, "uuid": "2f95e1e1-be7d-4e92-9de7-22bab9bcb9b5", "hitokoto": "如果你是一匹千里马，那么请做自己的伯乐", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1537159093", "length": 19}, {"id": 3881, "uuid": "6c3089f1-1c8a-4e0d-a6e4-b010e3b41b6b", "hitokoto": "世界上最美丽的就是世界本身", "type": "f", "from": "Qihoo360", "from_who": null, "creator": "Doraemon!", "creator_uid": 1438, "reviewer": 0, "commit_from": "web", "created_at": "1537159127", "length": 13}]